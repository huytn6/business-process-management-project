  <process id="Process_HoanTra" isExecutable="false">
    <laneSet id="LaneSet_HoanTra">
      <lane id="Lane_KhachHang" name="KHÁCH HÀNG">
        <flowNodeRef>StartEvent_HoanTra</flowNodeRef>
        <flowNodeRef>Task_GuiYeuCau</flowNodeRef>
        <flowNodeRef>Task_BoSungChungTu</flowNodeRef>
        <flowNodeRef>Task_NhanKetQua</flowNodeRef>
        <flowNodeRef>EndEvent_KhachHang</flowNodeRef>
      </lane>
      <lane id="Lane_CSKH" name="BỘ PHẬN CSKH">
        <flowNodeRef>Task_TiepNhan</flowNodeRef>
        <flowNodeRef>Task_KiemTra</flowNodeRef>
        <flowNodeRef>Gateway_HoSo</flowNodeRef>
        <flowNodeRef>Task_ThongBao</flowNodeRef>
        <flowNodeRef>Task_XacMinh</flowNodeRef>
      </lane>
      <lane id="Lane_Shipper" name="SHIPPER">
        <flowNodeRef>Task_VanChuyen</flowNodeRef>
        <flowNodeRef>Task_ThuHoi</flowNodeRef>
        <flowNodeRef>Task_TiepNhanLenh</flowNodeRef>
      </lane>
      <lane id="Lane_Kho" name="BƯU CỤC / KHO">
        <flowNodeRef>Gateway_DieuKien</flowNodeRef>
        <flowNodeRef>Task_HoanTraShop</flowNodeRef>
        <flowNodeRef>Task_LapBienBan</flowNodeRef>
        <flowNodeRef>Task_CapNhatKho</flowNodeRef>
        <flowNodeRef>Gateway_MergeKho</flowNodeRef>
        <flowNodeRef>Task_KiemTraKho</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_HoanTra" name="Khách hàng phát sinh nhu cầu hoàn trả hàng">
