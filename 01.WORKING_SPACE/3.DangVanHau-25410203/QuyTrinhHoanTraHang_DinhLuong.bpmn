Chi phí xử lý (Cost): 0 VNĐ
Xác suất (Prob): 100%
Lãng phí (Waste): None</documentation>
      <incoming>Flow_H1</incoming>
      <outgoing>Flow_H2</outgoing>
    </task>
    <task id="Task_TiepNhan" name="Tiếp nhận yêu cầu hoàn trả">
