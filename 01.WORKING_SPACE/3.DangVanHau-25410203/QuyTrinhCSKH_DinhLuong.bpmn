    <bpmn:sequenceFlow id="Flow_C16" sourceRef="GW_Split_TrachNhiem" targetRef="Task_LapPhieuDenBu" name="Lỗi vận hành VTP (85%)" />
    <bpmn:sequenceFlow id="Flow_C17" sourceRef="GW_Split_TrachNhiem" targetRef="Task_TuChoiDenBu" name="Miễn trừ/Lỗi người gửi (15%)" />
    <bpmn:sequenceFlow id="Flow_C18" sourceRef="Task_LapPhieuDenBu" targetRef="GW_Merge_KhieuNai" />
