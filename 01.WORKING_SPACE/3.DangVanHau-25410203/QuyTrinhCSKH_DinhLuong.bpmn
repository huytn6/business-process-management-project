<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_CSKH" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.2.0">
  <bpmn:collaboration id="Collaboration_Process_CSKH">
    <bpmn:participant id="Participant_ViettelPost" name="QUY TRÌNH CHĂM SÓC KHÁCH HÀNG – VIETTEL POST" processRef="Process_CSKH" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CSKH" name="Quy trình Chăm sóc khách hàng (Dinh Luong)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_CSKH">
      <bpmn:lane id="Lane_KhachHang" name="KHÁCH HÀNG">
        <bpmn:flowNodeRef>StartEvent_CSKH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuiKhieuNai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CungCapLaiMa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BoSungChungTu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NhanPhanHoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NghiemThu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CSKH</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CSKH" name="BỘ PHẬN CSKH">
        <bpmn:flowNodeRef>GW_Merge_MaDon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TiepNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split_MaDon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_ChungTu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraDon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split_ChungTu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XacMinh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split_LoaiYeuCau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TuVan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split_TrachNhiem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LapPhieuDenBu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TuChoiDenBu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_KhieuNai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_XuLy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThongBao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split_DongThuan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhucTra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChiTra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_KetThuc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_CSKH" name="Yêu cầu khiếu nại / thắc mắc phát sinh">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_GuiKhieuNai" name="Gửi khiếu nại / thắc mắc [VA]">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_MaDon">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:incoming>Flow_C6</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_TiepNhan" name="Tiếp nhận và tra cứu mã đơn [BVA]">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
      <bpmn:outgoing>Flow_C4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Split_MaDon" name="Mã đơn hợp lệ?">
      <bpmn:incoming>Flow_C4</bpmn:incoming>
      <bpmn:outgoing>Flow_C5</bpmn:outgoing>
      <bpmn:outgoing>Flow_C7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CungCapLaiMa" name="Cung cấp lại mã vận đơn [NVA]">
      <bpmn:incoming>Flow_C5</bpmn:incoming>
      <bpmn:outgoing>Flow_C6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_ChungTu">
      <bpmn:incoming>Flow_C7</bpmn:incoming>
      <bpmn:incoming>Flow_C11</bpmn:incoming>
      <bpmn:outgoing>Flow_C8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_KiemTraDon" name="Kiểm tra thông tin chi tiết đơn [BVA]">
      <bpmn:incoming>Flow_C8</bpmn:incoming>
      <bpmn:outgoing>Flow_C9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Split_ChungTu" name="Chứng từ đầy đủ?">
      <bpmn:incoming>Flow_C9</bpmn:incoming>
      <bpmn:outgoing>Flow_C10</bpmn:outgoing>
      <bpmn:outgoing>Flow_C12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_BoSungChungTu" name="Bổ sung chứng từ khiếu nại [NVA]">
      <bpmn:incoming>Flow_C10</bpmn:incoming>
      <bpmn:outgoing>Flow_C11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_XacMinh" name="Xác minh nguyên nhân và thiệt hại [BVA]">
      <bpmn:incoming>Flow_C12</bpmn:incoming>
      <bpmn:outgoing>Flow_C13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Split_LoaiYeuCau" name="Phân loại yêu cầu?">
      <bpmn:incoming>Flow_C13</bpmn:incoming>
      <bpmn:outgoing>Flow_C14</bpmn:outgoing>
      <bpmn:outgoing>Flow_C15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_TuVan" name="Tư vấn và giải đáp thắc mắc [VA]">
      <bpmn:incoming>Flow_C14</bpmn:incoming>
      <bpmn:outgoing>Flow_C20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Split_TrachNhiem" name="Xác định trách nhiệm?">
      <bpmn:incoming>Flow_C15</bpmn:incoming>
      <bpmn:outgoing>Flow_C16</bpmn:outgoing>
      <bpmn:outgoing>Flow_C17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_LapPhieuDenBu" name="Lập phiếu chi đền bù bồi thường [VA]">
      <bpmn:incoming>Flow_C16</bpmn:incoming>
      <bpmn:outgoing>Flow_C18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TuChoiDenBu" name="Lập văn bản từ chối kèm giải trình [BVA]">
      <bpmn:incoming>Flow_C17</bpmn:incoming>
      <bpmn:outgoing>Flow_C19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_KhieuNai">
      <bpmn:incoming>Flow_C18</bpmn:incoming>
      <bpmn:incoming>Flow_C19</bpmn:incoming>
      <bpmn:outgoing>Flow_C21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Merge_XuLy">
      <bpmn:incoming>Flow_C20</bpmn:incoming>
      <bpmn:incoming>Flow_C21</bpmn:incoming>
      <bpmn:outgoing>Flow_C22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ThongBao" name="Thông báo kết quả giải quyết [BVA]">
      <bpmn:incoming>Flow_C22</bpmn:incoming>
      <bpmn:outgoing>Flow_C23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NhanPhanHoi" name="Tiếp nhận phản hồi từ khách [BVA]">
      <bpmn:incoming>Flow_C23</bpmn:incoming>
      <bpmn:outgoing>Flow_C24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Split_DongThuan" name="Khách hàng đồng thuận?">
      <bpmn:incoming>Flow_C24</bpmn:incoming>
      <bpmn:outgoing>Flow_C25</bpmn:outgoing>
      <bpmn:outgoing>Flow_C26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PhucTra" name="Quản lý phúc tra và tái xử lý [BVA]">
      <bpmn:incoming>Flow_C25</bpmn:incoming>
      <bpmn:outgoing>Flow_C27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ChiTra" name="Chi trả tiền bồi thường (nếu có) [VA]">
