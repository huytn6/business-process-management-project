    <bpmn:sequenceFlow id="Flow_C5" name="Sai mã đơn (5%)" sourceRef="GW_Split_MaDon" targetRef="Task_CungCapLaiMa" />
    <bpmn:sequenceFlow id="Flow_C7" name="Tìm thấy mã (95%)" sourceRef="GW_Split_MaDon" targetRef="GW_Merge_ChungTu" />
    <bpmn:sequenceFlow id="Flow_C11" sourceRef="Task_BoSungChungTu" targetRef="GW_Merge_ChungTu" />
    <bpmn:sequenceFlow id="Flow_C8" sourceRef="GW_Merge_ChungTu" targetRef="Task_KiemTraDon" />
    <bpmn:sequenceFlow id="Flow_C9" sourceRef="Task_KiemTraDon" targetRef="GW_Split_ChungTu" />
    <bpmn:sequenceFlow id="Flow_C10" name="Thiếu chứng từ (r = 20%)" sourceRef="GW_Split_ChungTu" targetRef="Task_BoSungChungTu" />
    <bpmn:sequenceFlow id="Flow_C12" name="Đầy đủ chứng từ (80%)" sourceRef="GW_Split_ChungTu" targetRef="Task_XacMinh" />
    <bpmn:sequenceFlow id="Flow_C13" sourceRef="Task_XacMinh" targetRef="GW_Split_LoaiYeuCau" />
    <bpmn:sequenceFlow id="Flow_C14" name="Tư vấn hỗ trợ (35%)" sourceRef="GW_Split_LoaiYeuCau" targetRef="Task_TuVan" />
    <bpmn:sequenceFlow id="Flow_C15" name="Khiếu nại bồi thường (65%)" sourceRef="GW_Split_LoaiYeuCau" targetRef="GW_Split_TrachNhiem" />
    <bpmn:sequenceFlow id="Flow_C20" sourceRef="Task_TuVan" targetRef="GW_Merge_XuLy" />
    <bpmn:sequenceFlow id="Flow_C16" name="Lỗi vận hành VTP (85%)" sourceRef="GW_Split_TrachNhiem" targetRef="Task_LapPhieuDenBu" />
    <bpmn:sequenceFlow id="Flow_C17" name="Miễn trừ/Lỗi người gửi (15%)" sourceRef="GW_Split_TrachNhiem" targetRef="Task_TuChoiDenBu" />
    <bpmn:sequenceFlow id="Flow_C18" sourceRef="Task_LapPhieuDenBu" targetRef="GW_Merge_KhieuNai" />
    <bpmn:sequenceFlow id="Flow_C19" sourceRef="Task_TuChoiDenBu" targetRef="GW_Merge_KhieuNai" />
    <bpmn:sequenceFlow id="Flow_C21" sourceRef="GW_Merge_KhieuNai" targetRef="GW_Merge_XuLy" />
    <bpmn:sequenceFlow id="Flow_C22" sourceRef="GW_Merge_XuLy" targetRef="Task_ThongBao" />
    <bpmn:sequenceFlow id="Flow_C23" sourceRef="Task_ThongBao" targetRef="Task_NhanPhanHoi" />
    <bpmn:sequenceFlow id="Flow_C24" sourceRef="Task_NhanPhanHoi" targetRef="GW_Split_DongThuan" />
    <bpmn:sequenceFlow id="Flow_C25" name="Chưa đồng ý (10%)" sourceRef="GW_Split_DongThuan" targetRef="Task_PhucTra" />
    <bpmn:sequenceFlow id="Flow_C26" name="Đồng ý kết quả (90%)" sourceRef="GW_Split_DongThuan" targetRef="Task_ChiTra" />
    <bpmn:sequenceFlow id="Flow_C27" sourceRef="Task_PhucTra" targetRef="GW_Merge_KetThuc" />
    <bpmn:sequenceFlow id="Flow_C28" sourceRef="Task_ChiTra" targetRef="GW_Merge_KetThuc" />
    <bpmn:sequenceFlow id="Flow_C29" sourceRef="GW_Merge_KetThuc" targetRef="Task_NghiemThu" />
    <bpmn:sequenceFlow id="Flow_C30" sourceRef="Task_NghiemThu" targetRef="EndEvent_CSKH" />
  </bpmn:process>
