<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CSKH" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.24.0">
  <collaboration id="Collaboration_CSKH">
    <participant id="Participant_ViettelPost" name="QUY TRÌNH CHĂM SÓC KHÁCH HÀNG – VIETTEL POST" processRef="Process_CSKH" />
    <textAnnotation id="TA_W_2">
      <text>W2: Defects
(Hồ sơ thiếu chứng từ)</text>
    </textAnnotation>
    <association id="Assoc_W_2" sourceRef="TA_W_2" targetRef="Task_BoSungChungTu" />
    <textAnnotation id="TA_W_1">
      <text>W3: Over-processing
(Kiểm tra trùng lặp thông tin)</text>
    </textAnnotation>
    <association id="Assoc_W_1" sourceRef="TA_W_1" targetRef="Task_KiemTra" />
    <textAnnotation id="TA_W_3">
      <text>W1: Waiting
(Chờ tra cứu thủ công: 60p)</text>
    </textAnnotation>
    <association id="Assoc_W_3" sourceRef="TA_W_3" targetRef="Task_XacMinh" />
  </collaboration>
  <process id="Process_CSKH" isExecutable="false">
    <laneSet id="LaneSet_CSKH">
      <lane id="Lane_KhachHang" name="KHÁCH HÀNG">
        <flowNodeRef>StartEvent_CSKH</flowNodeRef>
        <flowNodeRef>Task_GuiKhieuNai</flowNodeRef>
        <flowNodeRef>Task_BoSungChungTu</flowNodeRef>
        <flowNodeRef>EndEvent_CSKH</flowNodeRef>
        <flowNodeRef>Task_NhanKetQua</flowNodeRef>
      </lane>
      <lane id="Lane_CSKH" name="BỘ PHẬN CSKH">
        <flowNodeRef>Task_TiepNhan</flowNodeRef>
        <flowNodeRef>Task_KiemTra</flowNodeRef>
        <flowNodeRef>Gateway_HoSo</flowNodeRef>
        <flowNodeRef>Task_TuVan</flowNodeRef>
        <flowNodeRef>Gateway_PhanLoai</flowNodeRef>
        <flowNodeRef>Task_XacMinh</flowNodeRef>
        <flowNodeRef>Task_DenBu</flowNodeRef>
        <flowNodeRef>Gateway_Merge</flowNodeRef>
        <flowNodeRef>Task_ThongBao</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_CSKH" name="Khách hàng phát sinh khiếu nại / thắc mắc">
      <outgoing>Flow_C1</outgoing>
    </startEvent>
    <task id="Task_GuiKhieuNai" name="Gửi khiếu nại / thắc mắc">
      <documentation>Processing Time (T_proc): 5 phút
Waiting Time (T_wait): 0 phút
Cycle Time (T_cycle): 5 phút
Chi phí xử lý (Cost): 0 VNĐ
Xác suất (Prob): 100%
Lãng phí (Waste): None</documentation>
      <incoming>Flow_C1</incoming>
      <outgoing>Flow_C2</outgoing>
    </task>
    <task id="Task_TiepNhan" name="Tiếp nhận yêu cầu">
      <documentation>Processing Time (T_proc): 3 phút
Waiting Time (T_wait): 10 phút
Cycle Time (T_cycle): 13 phút
Chi phí xử lý (Cost): 3.125 VNĐ
Xác suất (Prob): 100%
Lãng phí (Waste): None</documentation>
      <incoming>Flow_C2</incoming>
      <outgoing>Flow_C3</outgoing>
    </task>
    <task id="Task_KiemTra" name="Kiểm tra thông tin đơn hàng">
      <documentation>Processing Time (T_proc): 5 phút
Waiting Time (T_wait): 10 phút
Cycle Time (T_cycle): 15 phút
Chi phí xử lý (Cost): 5.208 VNĐ
Xác suất (Prob): 100%
Lãng phí (Waste): W3: Over-processing (Kiểm tra trùng lặp thông tin)</documentation>
      <incoming>Flow_C3</incoming>
      <incoming>Flow_C6</incoming>
      <outgoing>Flow_C4</outgoing>
    </task>
    <exclusiveGateway id="Gateway_HoSo" name="Hồ sơ đầy đủ?">
      <incoming>Flow_C4</incoming>
      <outgoing>Flow_C5</outgoing>
      <outgoing>Flow_C7</outgoing>
    </exclusiveGateway>
    <task id="Task_BoSungChungTu" name="Bổ sung chứng từ">
      <documentation>Processing Time (T_proc): 10 phút
Waiting Time (T_wait): 120 phút
Cycle Time (T_cycle): 130 phút
Chi phí xử lý (Cost): 0 VNĐ
Xác suất (Prob): 20% Loop
Lãng phí (Waste): W2: Defects (Hồ sơ thiếu chứng từ)</documentation>
      <incoming>Flow_C5</incoming>
      <outgoing>Flow_C6</outgoing>
    </task>
    <sequenceFlow id="Flow_C1" sourceRef="StartEvent_CSKH" targetRef="Task_GuiKhieuNai" />
    <sequenceFlow id="Flow_C2" sourceRef="Task_GuiKhieuNai" targetRef="Task_TiepNhan" />
    <sequenceFlow id="Flow_C3" sourceRef="Task_TiepNhan" targetRef="Task_KiemTra" />
    <sequenceFlow id="Flow_C4" sourceRef="Task_KiemTra" targetRef="Gateway_HoSo" />
    <sequenceFlow id="Flow_C5" name="Thiếu chứng từ (r = 20%)" sourceRef="Gateway_HoSo" targetRef="Task_BoSungChungTu" />
    <sequenceFlow id="Flow_C6" sourceRef="Task_BoSungChungTu" targetRef="Task_KiemTra" />
    <sequenceFlow id="Flow_C7" name="Đầy đủ (80%)" sourceRef="Gateway_HoSo" targetRef="Task_XacMinh" />
    <sequenceFlow id="Flow_C8" sourceRef="Task_XacMinh" targetRef="Gateway_PhanLoai" />
    <sequenceFlow id="Flow_C9" name="Khiếu nại đền bù (67%)" sourceRef="Gateway_PhanLoai" targetRef="Task_DenBu" />
    <sequenceFlow id="Flow_C10" name="Tư vấn hỗ trợ (33%)" sourceRef="Gateway_PhanLoai" targetRef="Task_TuVan" />
    <sequenceFlow id="Flow_C11" sourceRef="Task_DenBu" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_C12" sourceRef="Task_TuVan" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_C13" sourceRef="Gateway_Merge" targetRef="Task_ThongBao" />
    <sequenceFlow id="Flow_C14" sourceRef="Task_ThongBao" targetRef="Task_NhanKetQua" />
    <sequenceFlow id="Flow_C15" sourceRef="Task_NhanKetQua" targetRef="EndEvent_CSKH" />
    <endEvent id="EndEvent_CSKH" name="Khiếu nại / thắc mắc đã giải quyết">
      <incoming>Flow_C15</incoming>
    </endEvent>
    <task id="Task_NhanKetQua" name="Nhận kết quả phản hồi">
      <documentation>Processing Time (T_proc): 5 phút
Waiting Time (T_wait): 0 phút
Cycle Time (T_cycle): 5 phút
Chi phí xử lý (Cost): 0 VNĐ
Xác suất (Prob): 100%
Lãng phí (Waste): None</documentation>
      <incoming>Flow_C14</incoming>
      <outgoing>Flow_C15</outgoing>
    </task>
    <task id="Task_TuVan" name="Tư vấn và giải đáp thắc mắc">
      <documentation>Processing Time (T_proc): 10 phút
Waiting Time (T_wait): 5 phút
Cycle Time (T_cycle): 15 phút
Chi phí xử lý (Cost): 10.417 VNĐ
Xác suất (Prob): 33%
Lãng phí (Waste): None</documentation>
      <incoming>Flow_C10</incoming>
      <outgoing>Flow_C12</outgoing>
    </task>
    <exclusiveGateway id="Gateway_PhanLoai" name="Phân loại yêu cầu?">
      <incoming>Flow_C8</incoming>
      <outgoing>Flow_C9</outgoing>
      <outgoing>Flow_C10</outgoing>
    </exclusiveGateway>
    <task id="Task_XacMinh" name="Xác minh mức thiệt hại / nội dung thắc mắc">
      <documentation>Processing Time (T_proc): 15 phút
Waiting Time (T_wait): 60 phút
Cycle Time (T_cycle): 75 phút
Chi phí xử lý (Cost): 15.625 VNĐ
Xác suất (Prob): 100%
Lãng phí (Waste): W1: Waiting (Chờ tra cứu thủ công)</documentation>
      <incoming>Flow_C7</incoming>
      <outgoing>Flow_C8</outgoing>
    </task>
    <task id="Task_DenBu" name="Giải quyết khiếu nại đền bù">
      <documentation>Processing Time (T_proc): 15 phút
Waiting Time (T_wait): 30 phút
Cycle Time (T_cycle): 45 phút
Chi phí xử lý (Cost): 15.625 VNĐ
Xác suất (Prob): 67%
Lãng phí (Waste): None</documentation>
      <incoming>Flow_C9</incoming>
      <outgoing>Flow_C11</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Merge">
      <incoming>Flow_C11</incoming>
      <incoming>Flow_C12</incoming>
      <outgoing>Flow_C13</outgoing>
    </exclusiveGateway>
    <task id="Task_ThongBao" name="Thông báo kết quả phản hồi">
      <documentation>Processing Time (T_proc): 5 phút
Waiting Time (T_wait): 5 phút
Cycle Time (T_cycle): 10 phút
Chi phí xử lý (Cost): 5.208 VNĐ
Xác suất (Prob): 100%
Lãng phí (Waste): None</documentation>
      <incoming>Flow_C13</incoming>
      <outgoing>Flow_C14</outgoing>
    </task>
  </process>
