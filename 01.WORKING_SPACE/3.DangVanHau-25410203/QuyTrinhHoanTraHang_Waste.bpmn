<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_HoanTra" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collaboration_Process_HoanTra">
    <bpmn:participant id="Participant_ViettelPost" name="QUY TRÌNH QUẢN LÝ HOÀN TRẢ HÀNG – VIETTEL POST" processRef="Process_HoanTra" />
    <bpmn:textAnnotation id="Ann_W_H1">
      <bpmn:text>W2: Lỗi thiếu chứng từ</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_W_H2">
      <bpmn:text>W1: Chờ xác minh</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_W_H3">
      <bpmn:text>W4: Di chuyển lặp lại</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_W_H5">
      <bpmn:text>W3: Vận chuyển trung gian</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_W_H6">
      <bpmn:text>W2: Hàng hư hỏng/lỗi</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_W_H7">
      <bpmn:text>W5: Tồn đọng lưu kho</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_W_H8">
      <bpmn:text>W6: Đối soát lặp lại</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_W_H4">
      <bpmn:text>W1: Khách hủy đơn</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Ann_W_H1" sourceRef="Task_BoSungChungTu" targetRef="Ann_W_H1" />
    <bpmn:association id="Assoc_Ann_W_H2" sourceRef="Task_XacMinh" targetRef="Ann_W_H2" />
    <bpmn:association id="Assoc_Ann_W_H3" sourceRef="Task_HenLai" targetRef="Ann_W_H3" />
    <bpmn:association id="Assoc_Ann_W_H5" sourceRef="Task_VanChuyen" targetRef="Ann_W_H5" />
    <bpmn:association id="Assoc_Ann_W_H6" sourceRef="Task_LapBienBan" targetRef="Ann_W_H6" />
    <bpmn:association id="Assoc_Ann_W_H7" sourceRef="Task_NhapKhoHoan" targetRef="Ann_W_H7" />
    <bpmn:association id="Assoc_Ann_W_H8" sourceRef="Task_ChuyenBoiThuong" targetRef="Ann_W_H8" />
    <bpmn:association id="Assoc_Ann_W_H4" sourceRef="Task_HuyYeuCau" targetRef="Ann_W_H4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_HoanTra" name="Quy trình Quản lý hoàn trả hàng (Waste Analysis)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_HoanTra">
      <bpmn:lane id="Lane_Kho" name="BƯU CỤC / KHO">
        <bpmn:flowNodeRef>Task_NhapKhoHoan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_NgoaiQuan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split_PhanLoai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraKho</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split_NgoaiQuan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LapBienBan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XuatTraShop</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Shipper" name="SHIPPER">
        <bpmn:flowNodeRef>Task_DenLayHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split_LayHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThuHoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VanChuyen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LenhThuHoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_LienHe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LienHeKhach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split_LienHe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HenLai</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CSKH" name="BỘ PHẬN CSKH">
        <bpmn:flowNodeRef>GW_Merge_HoSo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TiepNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split_HoSo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HuyYeuCau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Huy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChuyenBoiThuong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_KetQua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThongBao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_XacMinh</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_KhachHang" name="KHÁCH HÀNG">
        <bpmn:flowNodeRef>StartEvent_HoanTra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GuiYeuCau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BoSungChungTu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NhanKetQua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_HoanTra</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_HoanTra" name="Yêu cầu hoàn trả hàng phát sinh">
      <bpmn:outgoing>Flow_H1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_GuiYeuCau" name="Gửi yêu cầu hoàn trả [VA]">
      <bpmn:incoming>Flow_H1</bpmn:incoming>
      <bpmn:outgoing>Flow_H2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_HoSo">
      <bpmn:incoming>Flow_H2</bpmn:incoming>
      <bpmn:incoming>Flow_H6</bpmn:incoming>
      <bpmn:outgoing>Flow_H3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_TiepNhan" name="Tiếp nhận và kiểm tra hồ sơ [BVA]">
      <bpmn:incoming>Flow_H3</bpmn:incoming>
      <bpmn:outgoing>Flow_H4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Split_HoSo" name="Hồ sơ hợp lệ?">
      <bpmn:incoming>Flow_H4</bpmn:incoming>
      <bpmn:outgoing>Flow_H5</bpmn:outgoing>
      <bpmn:outgoing>Flow_H7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_BoSungChungTu" name="Bổ sung chứng từ [NVA]">
      <bpmn:incoming>Flow_H5</bpmn:incoming>
      <bpmn:outgoing>Flow_H6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_HuyYeuCau" name="Ghi nhận hủy yêu cầu hoàn [BVA]">
      <bpmn:incoming>Flow_H16</bpmn:incoming>
      <bpmn:outgoing>Flow_H17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Huy" name="Yêu cầu hoàn trả bị hủy">
      <bpmn:incoming>Flow_H17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ChuyenBoiThuong" name="Chuyển hồ sơ bồi thường sang CSKH [BVA]">
      <bpmn:incoming>Flow_H28</bpmn:incoming>
      <bpmn:outgoing>Flow_H30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_KetQua">
      <bpmn:incoming>Flow_H29</bpmn:incoming>
      <bpmn:incoming>Flow_H30</bpmn:incoming>
      <bpmn:outgoing>Flow_H31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ThongBao" name="Thông báo kết quả hoàn trả [BVA]">
      <bpmn:incoming>Flow_H31</bpmn:incoming>
      <bpmn:outgoing>Flow_H32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NhanKetQua" name="Nhận kết quả và xác nhận [VA]">
      <bpmn:incoming>Flow_H32</bpmn:incoming>
      <bpmn:outgoing>Flow_H33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_HoanTra" name="Quy trình hoàn trả hoàn tất">
      <bpmn:incoming>Flow_H33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_XacMinh" name="Xác minh nguyên nhân sự cố [BVA]">
      <bpmn:incoming>Flow_H7</bpmn:incoming>
      <bpmn:outgoing>Flow_H8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DenLayHang" name="Đến địa chỉ lấy hàng [BVA]">
      <bpmn:incoming>Flow_H14</bpmn:incoming>
      <bpmn:outgoing>Flow_H15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Split_LayHang" name="Khách bàn giao hàng?">
      <bpmn:incoming>Flow_H15</bpmn:incoming>
      <bpmn:outgoing>Flow_H16</bpmn:outgoing>
      <bpmn:outgoing>Flow_H18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ThuHoi" name="Thu hồi hàng tại chỗ [VA]">
      <bpmn:incoming>Flow_H18</bpmn:incoming>
      <bpmn:outgoing>Flow_H19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_VanChuyen" name="Vận chuyển hàng về kho [BVA]">
      <bpmn:incoming>Flow_H19</bpmn:incoming>
      <bpmn:outgoing>Flow_H20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_LenhThuHoi" name="Tiếp nhận lệnh thu hồi [BVA]">
      <bpmn:incoming>Flow_H8</bpmn:incoming>
      <bpmn:outgoing>Flow_H9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_LienHe">
      <bpmn:incoming>Flow_H9</bpmn:incoming>
      <bpmn:incoming>Flow_H13</bpmn:incoming>
      <bpmn:outgoing>Flow_H10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_LienHeKhach" name="Liên hệ khách hẹn giờ lấy [BVA]">
      <bpmn:incoming>Flow_H10</bpmn:incoming>
      <bpmn:outgoing>Flow_H11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Split_LienHe" name="Liên hệ thành công?">
      <bpmn:incoming>Flow_H11</bpmn:incoming>
      <bpmn:outgoing>Flow_H12</bpmn:outgoing>
      <bpmn:outgoing>Flow_H14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_HenLai" name="Hẹn lại lịch thu hồi [NVA]">
      <bpmn:incoming>Flow_H12</bpmn:incoming>
      <bpmn:outgoing>Flow_H13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NhapKhoHoan" name="Nhập kho hàng hoàn [BVA]">
      <bpmn:incoming>Flow_H23</bpmn:incoming>
      <bpmn:outgoing>Flow_H25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_NgoaiQuan">
      <bpmn:incoming>Flow_H24</bpmn:incoming>
      <bpmn:incoming>Flow_H25</bpmn:incoming>
      <bpmn:outgoing>Flow_H26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Split_PhanLoai" name="Phương án xử lý?">
      <bpmn:incoming>Flow_H26</bpmn:incoming>
      <bpmn:outgoing>Flow_H27</bpmn:outgoing>
      <bpmn:outgoing>Flow_H28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_KiemTraKho" name="Kiểm tra hàng hoàn tại kho [VA]">
      <bpmn:incoming>Flow_H20</bpmn:incoming>
      <bpmn:outgoing>Flow_H21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Split_NgoaiQuan" name="Ngoại quan đạt chuẩn?">
      <bpmn:incoming>Flow_H21</bpmn:incoming>
      <bpmn:outgoing>Flow_H22</bpmn:outgoing>
      <bpmn:outgoing>Flow_H23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_LapBienBan" name="Lập biên bản bất thường [NVA]">
      <bpmn:incoming>Flow_H22</bpmn:incoming>
      <bpmn:outgoing>Flow_H24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_XuatTraShop" name="Xử lý xuất trả người gửi [VA]">
      <bpmn:incoming>Flow_H27</bpmn:incoming>
      <bpmn:outgoing>Flow_H29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_H1" sourceRef="StartEvent_HoanTra" targetRef="Task_GuiYeuCau" />
    <bpmn:sequenceFlow id="Flow_H2" sourceRef="Task_GuiYeuCau" targetRef="GW_Merge_HoSo" />
    <bpmn:sequenceFlow id="Flow_H6" sourceRef="Task_BoSungChungTu" targetRef="GW_Merge_HoSo" />
    <bpmn:sequenceFlow id="Flow_H3" sourceRef="GW_Merge_HoSo" targetRef="Task_TiepNhan" />
    <bpmn:sequenceFlow id="Flow_H4" sourceRef="Task_TiepNhan" targetRef="GW_Split_HoSo" />
    <bpmn:sequenceFlow id="Flow_H5" name="Thiếu chứng từ (r = 20%)" sourceRef="GW_Split_HoSo" targetRef="Task_BoSungChungTu" />
    <bpmn:sequenceFlow id="Flow_H7" name="Đầy đủ chứng từ (80%)" sourceRef="GW_Split_HoSo" targetRef="Task_XacMinh" />
    <bpmn:sequenceFlow id="Flow_H16" name="Hủy hoàn (10%)" sourceRef="GW_Split_LayHang" targetRef="Task_HuyYeuCau" />
    <bpmn:sequenceFlow id="Flow_H17" sourceRef="Task_HuyYeuCau" targetRef="EndEvent_Huy" />
    <bpmn:sequenceFlow id="Flow_H28" name="Chuyển bồi thường (20%)" sourceRef="GW_Split_PhanLoai" targetRef="Task_ChuyenBoiThuong" />
    <bpmn:sequenceFlow id="Flow_H30" sourceRef="Task_ChuyenBoiThuong" targetRef="GW_Merge_KetQua" />
    <bpmn:sequenceFlow id="Flow_H29" sourceRef="Task_XuatTraShop" targetRef="GW_Merge_KetQua" />
    <bpmn:sequenceFlow id="Flow_H31" sourceRef="GW_Merge_KetQua" targetRef="Task_ThongBao" />
    <bpmn:sequenceFlow id="Flow_H32" sourceRef="Task_ThongBao" targetRef="Task_NhanKetQua" />
    <bpmn:sequenceFlow id="Flow_H33" sourceRef="Task_NhanKetQua" targetRef="EndEvent_HoanTra" />
    <bpmn:sequenceFlow id="Flow_H8" sourceRef="Task_XacMinh" targetRef="Task_LenhThuHoi" />
    <bpmn:sequenceFlow id="Flow_H14" name="Đúng hẹn (85%)" sourceRef="GW_Split_LienHe" targetRef="Task_DenLayHang" />
    <bpmn:sequenceFlow id="Flow_H15" sourceRef="Task_DenLayHang" targetRef="GW_Split_LayHang" />
    <bpmn:sequenceFlow id="Flow_H18" name="Bàn giao hàng (90%)" sourceRef="GW_Split_LayHang" targetRef="Task_ThuHoi" />
    <bpmn:sequenceFlow id="Flow_H19" sourceRef="Task_ThuHoi" targetRef="Task_VanChuyen" />
    <bpmn:sequenceFlow id="Flow_H20" sourceRef="Task_VanChuyen" targetRef="Task_KiemTraKho" />
    <bpmn:sequenceFlow id="Flow_H9" sourceRef="Task_LenhThuHoi" targetRef="GW_Merge_LienHe" />
    <bpmn:sequenceFlow id="Flow_H13" sourceRef="Task_HenLai" targetRef="GW_Merge_LienHe" />
    <bpmn:sequenceFlow id="Flow_H10" sourceRef="GW_Merge_LienHe" targetRef="Task_LienHeKhach" />
    <bpmn:sequenceFlow id="Flow_H11" sourceRef="Task_LienHeKhach" targetRef="GW_Split_LienHe" />
    <bpmn:sequenceFlow id="Flow_H12" name="Khách hẹn lại (15%)" sourceRef="GW_Split_LienHe" targetRef="Task_HenLai" />
    <bpmn:sequenceFlow id="Flow_H23" name="Đạt chuẩn (85%)" sourceRef="GW_Split_NgoaiQuan" targetRef="Task_NhapKhoHoan" />
    <bpmn:sequenceFlow id="Flow_H25" sourceRef="Task_NhapKhoHoan" targetRef="GW_Merge_NgoaiQuan" />
    <bpmn:sequenceFlow id="Flow_H24" sourceRef="Task_LapBienBan" targetRef="GW_Merge_NgoaiQuan" />
    <bpmn:sequenceFlow id="Flow_H26" sourceRef="GW_Merge_NgoaiQuan" targetRef="GW_Split_PhanLoai" />
    <bpmn:sequenceFlow id="Flow_H27" name="Xuất trả Shop (80%)" sourceRef="GW_Split_PhanLoai" targetRef="Task_XuatTraShop" />
    <bpmn:sequenceFlow id="Flow_H21" sourceRef="Task_KiemTraKho" targetRef="GW_Split_NgoaiQuan" />
    <bpmn:sequenceFlow id="Flow_H22" name="Lỗi/Hư hại (15%)" sourceRef="GW_Split_NgoaiQuan" targetRef="Task_LapBienBan" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_HoanTra">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_HoanTra" bpmnElement="Collaboration_Process_HoanTra">
