        <dc:Bounds x="1000" y="660" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DieuKien_di" bpmnElement="Gateway_DieuKien" isMarkerVisible="true">
        <dc:Bounds x="1135" y="675" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1120" y="732" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
