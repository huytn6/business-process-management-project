        <dc:Bounds x="1270" y="620" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LapBienBan_di" bpmnElement="Task_LapBienBan">
        <dc:Bounds x="1270" y="720" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeKho_di" bpmnElement="Gateway_MergeKho" isMarkerVisible="true">
        <dc:Bounds x="1405" y="686" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CapNhatKho_di" bpmnElement="Task_CapNhatKho">
        <dc:Bounds x="1540" y="671" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ThongBao_di" bpmnElement="Task_ThongBao">
        <dc:Bounds x="1540" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NhanKetQua_di" bpmnElement="Task_NhanKetQua">
        <dc:Bounds x="1540" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_KhachHang_di" bpmnElement="EndEvent_KhachHang">
        <dc:Bounds x="1702" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1678" y="175" width="85" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_H1_di" bpmnElement="Flow_H1">
        <di:waypoint x="248" y="150" />
        <di:waypoint x="300" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_H2_di" bpmnElement="Flow_H2">
        <di:waypoint x="350" y="190" />
        <di:waypoint x="350" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_H3_di" bpmnElement="Flow_H3">
        <di:waypoint x="400" y="330" />
        <di:waypoint x="425" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_H3_Merge_di" bpmnElement="Flow_H3_Merge">
        <di:waypoint x="475" y="330" />
        <di:waypoint x="500" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_H4_di" bpmnElement="Flow_H4">
        <di:waypoint x="600" y="330" />
        <di:waypoint x="635" y="330" />
      </bpmndi:BPMNEdge>
