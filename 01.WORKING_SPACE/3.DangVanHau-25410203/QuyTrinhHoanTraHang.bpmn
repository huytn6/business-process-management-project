<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HoanTra_v4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <collaboration id="Collaboration_HoanTra">
    <participant id="Participant_ViettelPost" name="QUY TRÌNH QUẢN LÝ HOÀN TRẢ HÀNG – VIETTEL POST" processRef="Process_HoanTra" />
  </collaboration>
  <process id="Process_HoanTra" isExecutable="false">
    <laneSet id="LaneSet_HoanTra">
      <lane id="Lane_KhachHang" name="KHÁCH HÀNG">
        <flowNodeRef>StartEvent_HoanTra</flowNodeRef>
        <flowNodeRef>Task_GuiYeuCau</flowNodeRef>
        <flowNodeRef>Task_BoSungChungTu</flowNodeRef>
        <flowNodeRef>Task_NhanKetQua</flowNodeRef>
        <flowNodeRef>EndEvent_KhachHang</flowNodeRef>
      </lane>
      <lane id="Lane_CSKH" name="BỘ PHẬN CSKH">
        <flowNodeRef>Task_TiepNhan</flowNodeRef>
        <flowNodeRef>Gateway_MergeKiemTra</flowNodeRef>
        <flowNodeRef>Task_KiemTra</flowNodeRef>
        <flowNodeRef>Gateway_HoSo</flowNodeRef>
        <flowNodeRef>Task_XacMinh</flowNodeRef>
        <flowNodeRef>Task_ThongBao</flowNodeRef>
      </lane>
      <lane id="Lane_Shipper" name="SHIPPER">
        <flowNodeRef>Task_TiepNhanLenh</flowNodeRef>
        <flowNodeRef>Task_ThuHoi</flowNodeRef>
        <flowNodeRef>Task_VanChuyen</flowNodeRef>
      </lane>
      <lane id="Lane_Kho" name="BƯU CỤC / KHO">
        <flowNodeRef>Task_KiemTraKho</flowNodeRef>
        <flowNodeRef>Gateway_DieuKien</flowNodeRef>
        <flowNodeRef>Task_HoanTraShop</flowNodeRef>
        <flowNodeRef>Task_LapBienBan</flowNodeRef>
        <flowNodeRef>Gateway_MergeKho</flowNodeRef>
        <flowNodeRef>Task_CapNhatKho</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_HoanTra" name="Yêu cầu hoàn trả hàng phát sinh">
      <outgoing>Flow_H1</outgoing>
    </startEvent>
    <task id="Task_GuiYeuCau" name="Gửi yêu cầu hoàn trả">
      <incoming>Flow_H1</incoming>
      <outgoing>Flow_H2</outgoing>
    </task>
    <task id="Task_TiepNhan" name="Tiếp nhận yêu cầu hoàn trả">
      <incoming>Flow_H2</incoming>
      <outgoing>Flow_H3</outgoing>
    </task>
    <exclusiveGateway id="Gateway_MergeKiemTra">
      <incoming>Flow_H3</incoming>
      <incoming>Flow_H6</incoming>
      <outgoing>Flow_H3_Merge</outgoing>
    </exclusiveGateway>
    <task id="Task_KiemTra" name="Kiểm tra thông tin đơn hàng">
      <incoming>Flow_H3_Merge</incoming>
      <outgoing>Flow_H4</outgoing>
    </task>
    <exclusiveGateway id="Gateway_HoSo" name="Hồ sơ đầy đủ?">
      <incoming>Flow_H4</incoming>
      <outgoing>Flow_H5</outgoing>
      <outgoing>Flow_H7</outgoing>
    </exclusiveGateway>
    <task id="Task_BoSungChungTu" name="Bổ sung chứng từ">
      <incoming>Flow_H5</incoming>
      <outgoing>Flow_H6</outgoing>
    </task>
    <task id="Task_XacMinh" name="Xác minh nguyên nhân sự cố với Kho/Shipper">
      <incoming>Flow_H7</incoming>
      <outgoing>Flow_H8</outgoing>
    </task>
    <task id="Task_TiepNhanLenh" name="Tiếp nhận lệnh thu hồi hàng">
      <incoming>Flow_H8</incoming>
      <outgoing>Flow_H9</outgoing>
    </task>
    <task id="Task_ThuHoi" name="Liên hệ khách &amp; thu hồi hàng">
      <incoming>Flow_H9</incoming>
      <outgoing>Flow_H10</outgoing>
    </task>
    <task id="Task_VanChuyen" name="Vận chuyển hàng về kho">
      <incoming>Flow_H10</incoming>
      <outgoing>Flow_H11</outgoing>
    </task>
    <task id="Task_KiemTraKho" name="Kiểm tra hàng hoàn tại kho">
      <incoming>Flow_H11</incoming>
      <outgoing>Flow_H12</outgoing>
    </task>
    <exclusiveGateway id="Gateway_DieuKien" name="Điều kiện hàng hoàn?">
      <incoming>Flow_H12</incoming>
      <outgoing>Flow_H13</outgoing>
      <outgoing>Flow_H14</outgoing>
    </exclusiveGateway>
    <task id="Task_HoanTraShop" name="Xử lý hoàn trả cho người gửi">
      <incoming>Flow_H13</incoming>
      <outgoing>Flow_H15</outgoing>
    </task>
    <task id="Task_LapBienBan" name="Lập biên bản bất thường">
      <incoming>Flow_H14</incoming>
      <outgoing>Flow_H16</outgoing>
    </task>
    <exclusiveGateway id="Gateway_MergeKho">
      <incoming>Flow_H15</incoming>
      <incoming>Flow_H16</incoming>
      <outgoing>Flow_H17</outgoing>
    </exclusiveGateway>
    <task id="Task_CapNhatKho" name="Cập nhật kết quả kiểm hàng">
      <incoming>Flow_H17</incoming>
      <outgoing>Flow_H18</outgoing>
    </task>
    <task id="Task_ThongBao" name="Thông báo kết quả hoàn trả">
      <incoming>Flow_H18</incoming>
      <outgoing>Flow_H19</outgoing>
    </task>
    <task id="Task_NhanKetQua" name="Nhận kết quả phản hồi">
      <incoming>Flow_H19</incoming>
      <outgoing>Flow_H20</outgoing>
    </task>
    <endEvent id="EndEvent_KhachHang" name="Quy trình hoàn trả hàng hoàn tất">
      <incoming>Flow_H20</incoming>
    </endEvent>
    <sequenceFlow id="Flow_H1" sourceRef="StartEvent_HoanTra" targetRef="Task_GuiYeuCau" />
    <sequenceFlow id="Flow_H2" sourceRef="Task_GuiYeuCau" targetRef="Task_TiepNhan" />
    <sequenceFlow id="Flow_H3" sourceRef="Task_TiepNhan" targetRef="Gateway_MergeKiemTra" />
    <sequenceFlow id="Flow_H3_Merge" sourceRef="Gateway_MergeKiemTra" targetRef="Task_KiemTra" />
    <sequenceFlow id="Flow_H4" sourceRef="Task_KiemTra" targetRef="Gateway_HoSo" />
    <sequenceFlow id="Flow_H5" name="Thiếu chứng từ (r = 20%)" sourceRef="Gateway_HoSo" targetRef="Task_BoSungChungTu" />
    <sequenceFlow id="Flow_H6" sourceRef="Task_BoSungChungTu" targetRef="Gateway_MergeKiemTra" />
    <sequenceFlow id="Flow_H7" name="Đầy đủ (80%)" sourceRef="Gateway_HoSo" targetRef="Task_XacMinh" />
    <sequenceFlow id="Flow_H8" sourceRef="Task_XacMinh" targetRef="Task_TiepNhanLenh" />
    <sequenceFlow id="Flow_H9" sourceRef="Task_TiepNhanLenh" targetRef="Task_ThuHoi" />
    <sequenceFlow id="Flow_H10" sourceRef="Task_ThuHoi" targetRef="Task_VanChuyen" />
    <sequenceFlow id="Flow_H11" sourceRef="Task_VanChuyen" targetRef="Task_KiemTraKho" />
    <sequenceFlow id="Flow_H12" sourceRef="Task_KiemTraKho" targetRef="Gateway_DieuKien" />
    <sequenceFlow id="Flow_H13" name="Đủ điều kiện (85%)" sourceRef="Gateway_DieuKien" targetRef="Task_HoanTraShop" />
    <sequenceFlow id="Flow_H14" name="Không đủ điều kiện (15%)" sourceRef="Gateway_DieuKien" targetRef="Task_LapBienBan" />
    <sequenceFlow id="Flow_H15" sourceRef="Task_HoanTraShop" targetRef="Gateway_MergeKho" />
    <sequenceFlow id="Flow_H16" sourceRef="Task_LapBienBan" targetRef="Gateway_MergeKho" />
    <sequenceFlow id="Flow_H17" sourceRef="Gateway_MergeKho" targetRef="Task_CapNhatKho" />
    <sequenceFlow id="Flow_H18" sourceRef="Task_CapNhatKho" targetRef="Task_ThongBao" />
    <sequenceFlow id="Flow_H19" sourceRef="Task_ThongBao" targetRef="Task_NhanKetQua" />
    <sequenceFlow id="Flow_H20" sourceRef="Task_NhanKetQua" targetRef="EndEvent_KhachHang" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HoanTra">
    <bpmndi:BPMNPlane id="BPMNPlane_HoanTra" bpmnElement="Collaboration_HoanTra">
      <bpmndi:BPMNShape id="Participant_ViettelPost_di" bpmnElement="Participant_ViettelPost" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="1720" height="760" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_KhachHang_di" bpmnElement="Lane_KhachHang" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1690" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CSKH_di" bpmnElement="Lane_CSKH" isHorizontal="true">
        <dc:Bounds x="160" y="240" width="1690" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Shipper_di" bpmnElement="Lane_Shipper" isHorizontal="true">
        <dc:Bounds x="160" y="420" width="1690" height="180" />
