<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Delivery06" targetNamespace="http://example.com/bpmn/delivery-confirmation" exporter="Codex - compatible with bpmn.io" exporterVersion="1.0">
  <bpmn:message id="Message_DeliveryNotice" name="Thông báo sắp giao hàng"/>
  <bpmn:message id="Message_CustomerAvailability" name="Phản hồi thời gian nhận hàng"/>
  <bpmn:message id="Message_PackageHandover" name="Bàn giao kiện hàng"/>
  <bpmn:message id="Message_DeliveryDecision" name="Quyết định nhận hoặc từ chối"/>
  <bpmn:message id="Message_COD" name="Yêu cầu thanh toán COD"/>
  <bpmn:message id="Message_POD" name="Xác nhận giao hàng thành công"/>
  <bpmn:collaboration id="Collaboration_Delivery">
    <bpmn:participant id="Participant_Company" name="ĐƠN VỊ BÁN HÀNG / GIAO NHẬN" processRef="Process_Delivery"/>
    <bpmn:participant id="Participant_Customer" name="KHÁCH HÀNG" processRef="Process_Customer"/>
    <bpmn:messageFlow id="MF_Notice" name="Thông báo lịch giao" sourceRef="Task_NotifyCustomer" targetRef="Start_CustomerNotice"/>
    <bpmn:messageFlow id="MF_Availability" name="Xác nhận có thể nhận hàng" sourceRef="Task_ConfirmAvailability" targetRef="Catch_CustomerReply"/>
    <bpmn:messageFlow id="MF_Handover" name="Bàn giao kiện hàng" sourceRef="Task_DeliverPackage" targetRef="Catch_CustomerPackage"/>
    <bpmn:messageFlow id="MF_Accept" name="Chấp nhận nhận hàng" sourceRef="Task_SendAcceptance" targetRef="Catch_DeliveryDecision"/>
    <bpmn:messageFlow id="MF_Refuse" name="Từ chối nhận hàng" sourceRef="Task_SendRefusal" targetRef="Catch_DeliveryDecision"/>
    <bpmn:messageFlow id="MF_COD" name="Thanh toán COD" sourceRef="Task_CollectCOD" targetRef="Task_PayCOD"/>
    <bpmn:messageFlow id="MF_POD" name="OTP / chữ ký / ảnh POD" sourceRef="Task_ConfirmReceiptCustomer" targetRef="Task_ConfirmReceipt"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Delivery" name="Quy trình 6 - Giao hàng tận nơi và xác nhận" isExecutable="false">
    <bpmn:documentation>Mô hình AS-IS giả định cho quy trình giao hàng chặng cuối, từ khi đơn sẵn sàng giao đến khi xác nhận giao thành công hoặc ghi nhận giao thất bại.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Company">
      <bpmn:lane id="Lane_OMS" name="HỆ THỐNG OMS / CSKH">
        <bpmn:flowNodeRef>Start_OrderReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InfoComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dispatch" name="ĐIỀU PHỐI GIAO HÀNG">
        <bpmn:flowNodeRef>Task_CreateShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignCourier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandoverPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Courier" name="NHÂN VIÊN GIAO HÀNG">
        <bpmn:flowNodeRef>Task_CheckPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_CustomerReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Reachable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordFailedAttempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AttemptsLeft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DeliveryFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_DeliveryDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordRefusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_COD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordPaymentFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_OrderReady" name="Đơn hàng sẵn sàng giao"/>
    <bpmn:serviceTask id="Task_ValidateOrder" name="Kiểm tra địa chỉ, liên hệ và phương thức thanh toán"/>
    <bpmn:exclusiveGateway id="Gateway_InfoComplete" default="Flow_Info_No" name="Thông tin đầy đủ?"/>
    <bpmn:userTask id="Task_RequestCorrection" name="Liên hệ khách hàng và cập nhật thông tin"/>
    <bpmn:serviceTask id="Task_CreateShipment" name="Tạo vận đơn và yêu cầu giao hàng"/>
    <bpmn:userTask id="Task_AssignCourier" name="Phân công nhân viên và tuyến giao"/>
    <bpmn:userTask id="Task_HandoverPackage" name="Bàn giao kiện hàng"/>
    <bpmn:userTask id="Task_CheckPickup" name="Kiểm tra kiện và xác nhận đã nhận"/>
    <bpmn:sendTask id="Task_NotifyCustomer" name="Thông báo thời gian giao dự kiến"/>
    <bpmn:intermediateCatchEvent id="Catch_CustomerReply" name="Nhận phản hồi khách hàng">
      <bpmn:messageEventDefinition id="MED_CustomerReply" messageRef="Message_CustomerAvailability"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Reachable" default="Flow_Reachable_No" name="Liên hệ được khách hàng?"/>
    <bpmn:userTask id="Task_RecordFailedAttempt" name="Ghi nhận lần giao không thành công"/>
    <bpmn:exclusiveGateway id="Gateway_AttemptsLeft" default="Flow_Attempts_No" name="Còn lượt giao lại?"/>
    <bpmn:intermediateCatchEvent id="Timer_Retry" name="Chờ đến lịch giao lại">
      <bpmn:timerEventDefinition id="TED_Retry">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_DeliverPackage" name="Bàn giao hàng để khách kiểm tra"/>
    <bpmn:intermediateCatchEvent id="Catch_DeliveryDecision" name="Nhận quyết định nhận hàng">
      <bpmn:messageEventDefinition id="MED_DeliveryDecision" messageRef="Message_DeliveryDecision"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Accept" default="Flow_Accept_No" name="Khách chấp nhận nhận hàng?"/>
    <bpmn:userTask id="Task_RecordRefusal" name="Ghi nhận lý do từ chối và bằng chứng"/>
    <bpmn:exclusiveGateway id="Gateway_COD" default="Flow_COD_No" name="Đơn hàng COD?"/>
    <bpmn:userTask id="Task_CollectCOD" name="Thu tiền COD"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentSuccess" default="Flow_Payment_No" name="Thanh toán thành công?"/>
    <bpmn:userTask id="Task_RecordPaymentFailure" name="Ghi nhận lỗi thanh toán"/>
    <bpmn:userTask id="Task_ConfirmReceipt" name="Nhận OTP, chữ ký hoặc ảnh POD"/>
    <bpmn:serviceTask id="Task_UpdateDelivered" name="Cập nhật đã giao và gửi xác nhận"/>
    <bpmn:userTask id="Task_ReturnPackage" name="Hoàn hàng về điểm tập kết"/>
    <bpmn:serviceTask id="Task_UpdateFailed" name="Cập nhật giao thất bại và thông báo"/>
    <bpmn:endEvent id="End_DeliveryFailed" name="Kết thúc - giao thất bại"/>
    <bpmn:endEvent id="End_Delivered" name="Kết thúc - giao thành công">
      <bpmn:terminateEventDefinition id="Terminate_Delivered"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="Start_OrderReady" targetRef="Task_ValidateOrder"/>
    <bpmn:sequenceFlow id="Flow_Validate_Info" sourceRef="Task_ValidateOrder" targetRef="Gateway_InfoComplete"/>
    <bpmn:sequenceFlow id="Flow_Info_Yes" sourceRef="Gateway_InfoComplete" targetRef="Task_CreateShipment" name="Có"/>
    <bpmn:sequenceFlow id="Flow_Info_No" sourceRef="Gateway_InfoComplete" targetRef="Task_RequestCorrection" name="Không"/>
    <bpmn:sequenceFlow id="Flow_Correction_Loop" sourceRef="Task_RequestCorrection" targetRef="Task_ValidateOrder"/>
    <bpmn:sequenceFlow id="Flow_Create_Assign" sourceRef="Task_CreateShipment" targetRef="Task_AssignCourier"/>
    <bpmn:sequenceFlow id="Flow_Assign_Handover" sourceRef="Task_AssignCourier" targetRef="Task_HandoverPackage"/>
    <bpmn:sequenceFlow id="Flow_Handover_Check" sourceRef="Task_HandoverPackage" targetRef="Task_CheckPickup"/>
    <bpmn:sequenceFlow id="Flow_Check_Notify" sourceRef="Task_CheckPickup" targetRef="Task_NotifyCustomer"/>
    <bpmn:sequenceFlow id="Flow_Notify_Reply" sourceRef="Task_NotifyCustomer" targetRef="Catch_CustomerReply"/>
    <bpmn:sequenceFlow id="Flow_Reply_Reachable" sourceRef="Catch_CustomerReply" targetRef="Gateway_Reachable"/>
    <bpmn:sequenceFlow id="Flow_Reachable_Yes" sourceRef="Gateway_Reachable" targetRef="Task_DeliverPackage" name="Có"/>
    <bpmn:sequenceFlow id="Flow_Reachable_No" sourceRef="Gateway_Reachable" targetRef="Task_RecordFailedAttempt" name="Không"/>
    <bpmn:sequenceFlow id="Flow_Failed_Attempts" sourceRef="Task_RecordFailedAttempt" targetRef="Gateway_AttemptsLeft"/>
    <bpmn:sequenceFlow id="Flow_Attempts_Yes" sourceRef="Gateway_AttemptsLeft" targetRef="Timer_Retry" name="Có"/>
    <bpmn:sequenceFlow id="Flow_Retry_Loop" sourceRef="Timer_Retry" targetRef="Task_NotifyCustomer"/>
    <bpmn:sequenceFlow id="Flow_Attempts_No" sourceRef="Gateway_AttemptsLeft" targetRef="Task_ReturnPackage" name="Không"/>
    <bpmn:sequenceFlow id="Flow_Deliver_Decision" sourceRef="Task_DeliverPackage" targetRef="Catch_DeliveryDecision"/>
    <bpmn:sequenceFlow id="Flow_Decision_Accept" sourceRef="Catch_DeliveryDecision" targetRef="Gateway_Accept"/>
    <bpmn:sequenceFlow id="Flow_Accept_No" sourceRef="Gateway_Accept" targetRef="Task_RecordRefusal" name="Không"/>
    <bpmn:sequenceFlow id="Flow_Refusal_Return" sourceRef="Task_RecordRefusal" targetRef="Task_ReturnPackage"/>
    <bpmn:sequenceFlow id="Flow_Accept_Yes" sourceRef="Gateway_Accept" targetRef="Gateway_COD" name="Có"/>
    <bpmn:sequenceFlow id="Flow_COD_No" sourceRef="Gateway_COD" targetRef="Task_ConfirmReceipt" name="Không"/>
    <bpmn:sequenceFlow id="Flow_COD_Yes" sourceRef="Gateway_COD" targetRef="Task_CollectCOD" name="Có"/>
    <bpmn:sequenceFlow id="Flow_Collect_Payment" sourceRef="Task_CollectCOD" targetRef="Gateway_PaymentSuccess"/>
    <bpmn:sequenceFlow id="Flow_Payment_Yes" sourceRef="Gateway_PaymentSuccess" targetRef="Task_ConfirmReceipt" name="Có"/>
    <bpmn:sequenceFlow id="Flow_Payment_No" sourceRef="Gateway_PaymentSuccess" targetRef="Task_RecordPaymentFailure" name="Không"/>
    <bpmn:sequenceFlow id="Flow_PaymentFailure_Return" sourceRef="Task_RecordPaymentFailure" targetRef="Task_ReturnPackage"/>
    <bpmn:sequenceFlow id="Flow_Confirm_Update" sourceRef="Task_ConfirmReceipt" targetRef="Task_UpdateDelivered"/>
    <bpmn:sequenceFlow id="Flow_Update_End" sourceRef="Task_UpdateDelivered" targetRef="End_Delivered"/>
    <bpmn:sequenceFlow id="Flow_Return_UpdateFailed" sourceRef="Task_ReturnPackage" targetRef="Task_UpdateFailed"/>
    <bpmn:sequenceFlow id="Flow_UpdateFailed_End" sourceRef="Task_UpdateFailed" targetRef="End_DeliveryFailed"/>
  </bpmn:process>
  <bpmn:process id="Process_Customer" name="Tiếp nhận và xác nhận giao hàng" isExecutable="false">
    <bpmn:startEvent id="Start_CustomerNotice" name="Nhận thông báo giao hàng">
      <bpmn:messageEventDefinition id="MED_CustomerNotice" messageRef="Message_DeliveryNotice"/>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_ConfirmAvailability" name="Xác nhận thời gian và địa điểm nhận"/>
    <bpmn:intermediateCatchEvent id="Catch_CustomerPackage" name="Nhận kiện hàng để kiểm tra">
      <bpmn:messageEventDefinition id="MED_CustomerPackage" messageRef="Message_PackageHandover"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_InspectPackage" name="Kiểm tra bao bì, sản phẩm và thông tin"/>
    <bpmn:exclusiveGateway id="Gateway_CustomerAccept" default="CFlow_Accept_No" name="Chấp nhận nhận hàng?"/>
    <bpmn:sendTask id="Task_SendRefusal" name="Thông báo từ chối và lý do"/>
    <bpmn:endEvent id="End_CustomerRefusal" name="Kết thúc - từ chối nhận"/>
    <bpmn:sendTask id="Task_SendAcceptance" name="Thông báo chấp nhận nhận hàng"/>
    <bpmn:exclusiveGateway id="Gateway_CustomerCOD" default="CFlow_COD_No" name="Cần thanh toán COD?"/>
    <bpmn:userTask id="Task_PayCOD" name="Thanh toán COD"/>
    <bpmn:sendTask id="Task_ConfirmReceiptCustomer" name="Cung cấp OTP, chữ ký hoặc xác nhận điện tử"/>
    <bpmn:endEvent id="End_CustomerComplete" name="Hoàn tất nhận hàng"/>
    <bpmn:sequenceFlow id="CFlow_Start_Confirm" sourceRef="Start_CustomerNotice" targetRef="Task_ConfirmAvailability"/>
    <bpmn:sequenceFlow id="CFlow_Confirm_Package" sourceRef="Task_ConfirmAvailability" targetRef="Catch_CustomerPackage"/>
    <bpmn:sequenceFlow id="CFlow_Package_Inspect" sourceRef="Catch_CustomerPackage" targetRef="Task_InspectPackage"/>
    <bpmn:sequenceFlow id="CFlow_Inspect_Accept" sourceRef="Task_InspectPackage" targetRef="Gateway_CustomerAccept"/>
    <bpmn:sequenceFlow id="CFlow_Accept_No" sourceRef="Gateway_CustomerAccept" targetRef="Task_SendRefusal" name="Không"/>
    <bpmn:sequenceFlow id="CFlow_Refusal_End" sourceRef="Task_SendRefusal" targetRef="End_CustomerRefusal"/>
    <bpmn:sequenceFlow id="CFlow_Accept_Yes" sourceRef="Gateway_CustomerAccept" targetRef="Task_SendAcceptance" name="Có"/>
    <bpmn:sequenceFlow id="CFlow_Accept_COD" sourceRef="Task_SendAcceptance" targetRef="Gateway_CustomerCOD"/>
    <bpmn:sequenceFlow id="CFlow_COD_Yes" sourceRef="Gateway_CustomerCOD" targetRef="Task_PayCOD" name="Có"/>
    <bpmn:sequenceFlow id="CFlow_COD_No" sourceRef="Gateway_CustomerCOD" targetRef="Task_ConfirmReceiptCustomer" name="Không"/>
    <bpmn:sequenceFlow id="CFlow_Pay_Confirm" sourceRef="Task_PayCOD" targetRef="Task_ConfirmReceiptCustomer"/>
    <bpmn:sequenceFlow id="CFlow_Confirm_End" sourceRef="Task_ConfirmReceiptCustomer" targetRef="End_CustomerComplete"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Delivery">
    <bpmndi:BPMNPlane id="BPMNPlane_Delivery" bpmnElement="Collaboration_Delivery">
      <bpmndi:BPMNShape id="Participant_Company_di" bpmnElement="Participant_Company" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="2860" height="650"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OMS_di" bpmnElement="Lane_OMS" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="2830" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dispatch_di" bpmnElement="Lane_Dispatch" isHorizontal="true">
        <dc:Bounds x="110" y="260" width="2830" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Courier_di" bpmnElement="Lane_Courier" isHorizontal="true">
        <dc:Bounds x="110" y="430" width="2830" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="80" y="790" width="2860" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_OrderReady_di" bpmnElement="Start_OrderReady">
        <dc:Bounds x="150" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="120" y="180" width="95" height="32"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateOrder_di" bpmnElement="Task_ValidateOrder">
        <dc:Bounds x="220" y="120" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_InfoComplete_di" bpmnElement="Gateway_InfoComplete" isMarkerVisible="true">
        <dc:Bounds x="420" y="135" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="385" y="190" width="125" height="32"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestCorrection_di" bpmnElement="Task_RequestCorrection">
        <dc:Bounds x="385" y="205" width="170" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateShipment_di" bpmnElement="Task_CreateShipment">
        <dc:Bounds x="560" y="300" width="165" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AssignCourier_di" bpmnElement="Task_AssignCourier">
        <dc:Bounds x="760" y="300" width="165" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HandoverPackage_di" bpmnElement="Task_HandoverPackage">
        <dc:Bounds x="960" y="300" width="165" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckPickup_di" bpmnElement="Task_CheckPickup">
        <dc:Bounds x="960" y="480" width="165" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyCustomer_di" bpmnElement="Task_NotifyCustomer">
        <dc:Bounds x="1160" y="480" width="165" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_CustomerReply_di" bpmnElement="Catch_CustomerReply">
        <dc:Bounds x="1360" y="502" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1325" y="542" width="110" height="32"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Reachable_di" bpmnElement="Gateway_Reachable" isMarkerVisible="true">
        <dc:Bounds x="1450" y="495" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1405" y="550" width="140" height="32"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeliverPackage_di" bpmnElement="Task_DeliverPackage">
        <dc:Bounds x="1570" y="480" width="165" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_DeliveryDecision_di" bpmnElement="Catch_DeliveryDecision">
        <dc:Bounds x="1770" y="502" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1725" y="542" width="125" height="32"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Accept_di" bpmnElement="Gateway_Accept" isMarkerVisible="true">
        <dc:Bounds x="1860" y="495" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1812" y="550" width="145" height="32"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_COD_di" bpmnElement="Gateway_COD" isMarkerVisible="true">
        <dc:Bounds x="1990" y="495" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1963" y="550" width="105" height="32"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CollectCOD_di" bpmnElement="Task_CollectCOD">
        <dc:Bounds x="2110" y="480" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentSuccess_di" bpmnElement="Gateway_PaymentSuccess" isMarkerVisible="true">
        <dc:Bounds x="2320" y="495" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2280" y="550" width="130" height="32"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConfirmReceipt_di" bpmnElement="Task_ConfirmReceipt">
        <dc:Bounds x="2460" y="480" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateDelivered_di" bpmnElement="Task_UpdateDelivered">
        <dc:Bounds x="2650" y="120" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Delivered_di" bpmnElement="End_Delivered">
        <dc:Bounds x="2870" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2825" y="180" width="125" height="32"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordFailedAttempt_di" bpmnElement="Task_RecordFailedAttempt">
        <dc:Bounds x="1460" y="625" width="180" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AttemptsLeft_di" bpmnElement="Gateway_AttemptsLeft" isMarkerVisible="true">
        <dc:Bounds x="1680" y="635" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1640" y="690" width="130" height="32"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_Retry_di" bpmnElement="Timer_Retry">
        <dc:Bounds x="1810" y="642" width="36" height="36"/>
