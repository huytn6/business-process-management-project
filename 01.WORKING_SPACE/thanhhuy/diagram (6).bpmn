        <flowNodeRef>Task17</flowNodeRef>
        <flowNodeRef>Task18</flowNodeRef>
      </lane>
      <lane id="Lane_NVGH" name="Nhân viên giao hàng">
        <flowNodeRef>IntCatch_PhatLai</flowNodeRef>
        <flowNodeRef>Task19</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task3" name="Tiếp nhận yêu cầu gửi hàng" />
    <task id="Task4" name="Kiểm tra thông tin người gửi và hàng hóa" />
    <exclusiveGateway id="GW_HopLe" name="Hàng hóa hợp lệ?" gatewayDirection="Diverging" />
    <task id="Task_TuChoi" name="Từ chối tiếp nhận" />
    <endEvent id="End_HuyGD" name="Hủy giao dịch" />
