      <dataOutputAssociation id="DOA_DanhSach">
        <targetRef>DOR_DanhSach</targetRef>
      </dataOutputAssociation>
    </task>
    <sequenceFlow id="SF16_17" sourceRef="Task16" targetRef="Task17" />
    <sequenceFlow id="SF17_18" sourceRef="Task17" targetRef="Task18" />
