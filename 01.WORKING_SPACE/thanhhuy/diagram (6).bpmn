      <messageEventDefinition id="MED_Catch" />
    </intermediateCatchEvent>
    <task id="Task19" name="Thực hiện giao hàng" />
    <sequenceFlow id="SF18_19" sourceRef="Task18" targetRef="Task19" />
    <sequenceFlow id="SF_Catch19" sourceRef="IntCatch_PhatLai" targetRef="Task19" />
