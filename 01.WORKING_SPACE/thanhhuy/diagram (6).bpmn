      <lane id="Lane_TTTC" name="Trung tâm trung chuyển">
        <flowNodeRef>Task14</flowNodeRef>
        <flowNodeRef>Task15</flowNodeRef>
        <flowNodeRef>Task16</flowNodeRef>
