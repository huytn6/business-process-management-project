    <messageFlow id="MF_NN_VP" name="Yêu cầu phát lại" sourceRef="IntThrow_PhatLai" targetRef="IntCatch_PhatLai" />
  </collaboration>
  <process id="Proc_KH" isExecutable="false">
    <startEvent id="StartEvt_KH" name="Yêu cầu gửi hàng phát sinh" />
    <task id="Task1" name="Chuẩn bị hàng hóa" />
    <task id="Task2" name="Đăng ký gửi hàng" />
    <sequenceFlow id="SF_KH1" sourceRef="StartEvt_KH" targetRef="Task1" />
    <sequenceFlow id="SF_KH2" sourceRef="Task1" targetRef="Task2" />
  </process>
  <process id="Proc_VP" isExecutable="false">
    <laneSet id="LS_VP">
      <lane id="Lane_BCG" name="Bưu cục gửi">
        <flowNodeRef>Task3</flowNodeRef>
        <flowNodeRef>Task4</flowNodeRef>
