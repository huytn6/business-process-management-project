  <process id="Proc_NN" isExecutable="false">
    <startEvent id="StartEvt_NN" name="Thông tin giao hàng">
      <messageEventDefinition id="MED_NN_Start" />
    </startEvent>
    <task id="Task_KTH" name="Kiểm tra hàng" />
    <exclusiveGateway id="GW_DongY" name="Đồng ý nhận hàng?" gatewayDirection="Diverging" />
    <exclusiveGateway id="GW_COD" name="Có COD?" gatewayDirection="Diverging">
      <outgoing>SF_COD_NO</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_PhatLai" name="Phát lại?" gatewayDirection="Diverging" />
    <intermediateThrowEvent id="IntThrow_PhatLai" name="Yêu cầu phát lại">
      <messageEventDefinition id="MED_Throw" />
    </intermediateThrowEvent>
    <task id="Task20" name="Thu tiền COD" />
    <task id="Task21" name="Cập nhật giao thành công" />
    <task id="Task22" name="Đối soát COD" />
    <endEvent id="End_HoanTat1" name="Giao hàng hoàn tất" />
    <task id="Task_CN" name="Cập nhật trạng thái hoàn" />
    <endEvent id="End_HoanTat2" name="Giao hàng hoàn tất" />
    <sequenceFlow id="SF_NN1" sourceRef="StartEvt_NN" targetRef="Task_KTH" />
    <sequenceFlow id="SF_NN2" sourceRef="Task_KTH" targetRef="GW_DongY" />
    <sequenceFlow id="SF_DY_YES" name="YES" sourceRef="GW_DongY" targetRef="GW_COD" />
    <sequenceFlow id="SF_DY_NO" name="NO" sourceRef="GW_DongY" targetRef="GW_PhatLai" />
    <sequenceFlow id="SF_COD_YES" name="YES (COD)" sourceRef="GW_COD" targetRef="Task20" />
    <sequenceFlow id="SF20_21" sourceRef="Task20" targetRef="Task21" />
    <sequenceFlow id="SF21_22" sourceRef="Task21" targetRef="Task22" />
    <sequenceFlow id="SF22_End" sourceRef="Task22" targetRef="End_HoanTat1" />
    <sequenceFlow id="SF_PL_YES" name="YES" sourceRef="GW_PhatLai" targetRef="IntThrow_PhatLai" />
    <sequenceFlow id="SF_PL_NO" name="NO" sourceRef="GW_PhatLai" targetRef="Task_CN" />
    <sequenceFlow id="SF_CN_End" sourceRef="Task_CN" targetRef="End_HoanTat2" />
    <endEvent id="End_HoanHang" name="Giao hàng hoàn tất">
      <incoming>SF_HH_End</incoming>
    </endEvent>
    <sequenceFlow id="SF_COD_NO" name="NO" sourceRef="GW_COD" targetRef="Task_HH" />
    <task id="Task_HH" name="Cập nhật giao thành công">
      <incoming>SF_COD_NO</incoming>
      <outgoing>SF_HH_End</outgoing>
    </task>
    <sequenceFlow id="SF_HH_End" sourceRef="Task_HH" targetRef="End_HoanHang" />
  </process>
