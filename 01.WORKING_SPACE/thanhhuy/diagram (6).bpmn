  <collaboration id="Collab_VTP">
    <participant id="Pool_KH" name="Pool 1: Khách hàng" processRef="Proc_KH" />
    <participant id="Pool_VP" name="Viettel Post" processRef="Proc_VP" />
    <participant id="Pool_NN" name="Pool 3: Người nhận" processRef="Proc_NN" />
