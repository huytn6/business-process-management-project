<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_FINAL" targetNamespace="http://example.com/vclt-final" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.24.0">
  <bpmn:collaboration id="Collab_FINAL">
    <bpmn:participant id="Participant_KH" name="Người gửi" processRef="Proc_KH_FINAL" />
    <bpmn:participant id="Participant_VP" name="Viettel Post" processRef="Proc_VP_FINAL" />
    <bpmn:participant id="Participant_NN" name="Người nhận" processRef="Proc_NN_FINAL" />
    <bpmn:messageFlow id="MF_KH_VP" name="Yêu cầu gửi hàng" sourceRef="KH_Register" targetRef="VP_Start" />
    <bpmn:messageFlow id="MF_VP_NN" name="Thông tin giao hàng" sourceRef="VP_SendInfo" targetRef="NN_Start" />
    <bpmn:messageFlow id="MF_NN_Confirm" name="Xác nhận nhận hàng" sourceRef="NN_Sign" targetRef="VP_Confirm" />
    <bpmn:messageFlow id="MF_NN_Redelivery" name="Yêu cầu giao lại" sourceRef="NN_Redelivery" targetRef="VP_Redelivery" />
    <bpmn:messageFlow id="MF_NN_Reject" name="Thông báo từ chối" sourceRef="NN_Reject" targetRef="VP_Reject" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_KH_FINAL" name="Khách hàng">
    <bpmn:startEvent id="KH_Start" name="Yêu cầu gửi hàng phát sinh" />
    <bpmn:task id="KH_Prep" name="Chuẩn bị hàng hóa" />
    <bpmn:sendTask id="KH_Register" name="Đăng ký gửi hàng" />
    <bpmn:endEvent id="KH_End" name="Yêu cầu gửi hàng đã đăng ký" />
    <bpmn:sequenceFlow id="KH_F1" sourceRef="KH_Start" targetRef="KH_Prep" />
    <bpmn:sequenceFlow id="KH_F2" sourceRef="KH_Prep" targetRef="KH_Register" />
    <bpmn:sequenceFlow id="KH_F3" sourceRef="KH_Register" targetRef="KH_End" />
  </bpmn:process>
  <bpmn:process id="Proc_VP_FINAL" name="Viettel Post - Vận chuyển liên tỉnh">
    <bpmn:laneSet id="LaneSet_FINAL">
      <bpmn:lane id="Lane_NVGH" name="Nhân viên giao hàng">
        <bpmn:flowNodeRef>VP_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_COD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_SendInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Redelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Merge_Deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_EndCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_EndNoCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_StatusCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_CollectCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_StatusNoCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_EndReturn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BCP" name="Bưu cục phát">
        <bpmn:flowNodeRef>VP_Arrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Reconcile</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_KT" name="Khai thác &#38; vận chuyển">
        <bpmn:flowNodeRef>VP_Transit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BCG" name="Bưu cục gửi">
        <bpmn:flowNodeRef>VP_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_EndReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VP_Handover</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="VP_Start" name="Yêu cầu gửi hàng đến" />
    <bpmn:task id="VP_Receive" name="Tiếp nhận yêu cầu gửi hàng" />
    <bpmn:task id="VP_Check" name="Kiểm tra thông tin và hàng hóa" />
    <bpmn:task id="VP_Bill" name="Tạo vận đơn" />
    <bpmn:endEvent id="VP_EndReject" name="Từ chối tiếp nhận" />
    <bpmn:exclusiveGateway id="VP_Valid" name="Hàng hóa hợp lệ?" />
    <bpmn:task id="VP_Handover" name="Tiếp nhận và phân loại hàng" />
    <bpmn:task id="VP_Arrival" name="Tiếp nhận tại bưu cục phát" />
    <bpmn:task id="VP_Assign" name="Phân công nhân viên giao hàng" />
    <bpmn:task id="VP_Deliver" name="Thực hiện giao hàng" />
    <bpmn:exclusiveGateway id="VP_COD" name="Đơn hàng có COD?" />
    <bpmn:intermediateThrowEvent id="VP_SendInfo" name="Thông tin giao hàng đã gửi">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="VP_Confirm" name="Nhận xác nhận nhận hàng">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="VP_Wait" name="Chờ kết quả giao hàng" />
    <bpmn:intermediateCatchEvent id="VP_Redelivery" name="Yêu cầu giao lại đã nhận">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="VP_Merge_Deliver" name="Sẵn sàng thực hiện giao hàng?" />
    <bpmn:endEvent id="VP_EndCOD" name="Giao thành công và hoàn tất đối soát" />
    <bpmn:endEvent id="VP_EndNoCOD" name="Đơn hàng giao thành công" />
    <bpmn:task id="VP_StatusCOD" name="Cập nhật trạng thái giao thành công" />
    <bpmn:task id="VP_Reconcile" name="Đối soát và nộp tiền COD" />
    <bpmn:task id="VP_CollectCOD" name="Thu tiền COD từ người nhận" />
    <bpmn:task id="VP_StatusNoCOD" name="Cập nhật trạng thái giao thành công" />
    <bpmn:subProcess id="VP_Transit" name="Khai thác và vận chuyển liên tỉnh" />
    <bpmn:sequenceFlow id="VP_F1" sourceRef="VP_Start" targetRef="VP_Receive" />
    <bpmn:sequenceFlow id="VP_F2" sourceRef="VP_Receive" targetRef="VP_Check" />
    <bpmn:sequenceFlow id="VP_F3" sourceRef="VP_Check" targetRef="VP_Valid" />
    <bpmn:sequenceFlow id="VP_F4" name="Hợp lệ" sourceRef="VP_Valid" targetRef="VP_Bill" />
    <bpmn:sequenceFlow id="VP_F6" sourceRef="VP_Bill" targetRef="VP_Handover" />
    <bpmn:sequenceFlow id="VP_F5" name="Không hợp lệ" sourceRef="VP_Valid" targetRef="VP_EndReject" />
    <bpmn:sequenceFlow id="VP_F7" sourceRef="VP_Handover" targetRef="VP_Transit" />
    <bpmn:sequenceFlow id="VP_F8" sourceRef="VP_Transit" targetRef="VP_Arrival" />
    <bpmn:sequenceFlow id="VP_F9" sourceRef="VP_Arrival" targetRef="VP_Assign" />
    <bpmn:sequenceFlow id="VP_F10" sourceRef="VP_Assign" targetRef="VP_Merge_Deliver" />
    <bpmn:sequenceFlow id="VP_F10b" sourceRef="VP_Merge_Deliver" targetRef="VP_Deliver" />
    <bpmn:sequenceFlow id="VP_F11" sourceRef="VP_Deliver" targetRef="VP_SendInfo" />
    <bpmn:sequenceFlow id="VP_F15" sourceRef="VP_Wait" targetRef="VP_Reject" />
    <bpmn:sequenceFlow id="VP_F24" sourceRef="VP_Reject" targetRef="VP_Fail" />
    <bpmn:sequenceFlow id="VP_F16" sourceRef="VP_Confirm" targetRef="VP_COD" />
    <bpmn:sequenceFlow id="VP_F17" name="Có COD" sourceRef="VP_COD" targetRef="VP_CollectCOD" />
    <bpmn:sequenceFlow id="VP_F18" name="Không COD" sourceRef="VP_COD" targetRef="VP_StatusNoCOD" />
    <bpmn:sequenceFlow id="VP_F12" sourceRef="VP_SendInfo" targetRef="VP_Wait" />
    <bpmn:sequenceFlow id="VP_F13" sourceRef="VP_Wait" targetRef="VP_Confirm" />
    <bpmn:sequenceFlow id="VP_F14" sourceRef="VP_Wait" targetRef="VP_Redelivery" />
    <bpmn:sequenceFlow id="VP_F23" sourceRef="VP_Redelivery" targetRef="VP_Merge_Deliver" />
    <bpmn:sequenceFlow id="VP_F21" sourceRef="VP_Reconcile" targetRef="VP_EndCOD" />
    <bpmn:sequenceFlow id="VP_F22" sourceRef="VP_StatusNoCOD" targetRef="VP_EndNoCOD" />
    <bpmn:sequenceFlow id="VP_F26" sourceRef="VP_Return" targetRef="VP_EndReturn" />
    <bpmn:sequenceFlow id="VP_F19" sourceRef="VP_CollectCOD" targetRef="VP_StatusCOD" />
    <bpmn:sequenceFlow id="VP_F20" sourceRef="VP_StatusCOD" targetRef="VP_Reconcile" />
    <bpmn:sequenceFlow id="VP_F25" sourceRef="VP_Fail" targetRef="VP_Return" />
    <bpmn:intermediateCatchEvent id="VP_Reject" name="Thông báo từ chối đã nhận">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="VP_Fail" name="Cập nhật trạng thái giao thất bại" />
    <bpmn:task id="VP_Return" name="Khởi tạo xử lý chuyển hoàn" />
    <bpmn:endEvent id="VP_EndReturn" name="Chuyển sang xử lý hoàn hàng" />
  </bpmn:process>
  <bpmn:process id="Proc_NN_FINAL" name="Người nhận">
    <bpmn:startEvent id="NN_Start" name="Thông tin giao hàng đã nhận">
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="NN_Check" name="Kiểm tra hàng hóa" />
    <bpmn:exclusiveGateway id="NN_Accept" name="Người nhận đồng ý nhận hàng?" />
    <bpmn:exclusiveGateway id="NN_COD" name="Đơn hàng có COD?">
      <bpmn:outgoing>Flow_0ra8wfk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="NN_Pay" name="Thanh toán COD">
      <bpmn:incoming>NN_F10</bpmn:incoming>
      <bpmn:outgoing>Flow_062f7cb</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="NN_Merge" name="Tiếp tục ký nhận?">
      <bpmn:incoming>Flow_062f7cb</bpmn:incoming>
      <bpmn:incoming>Flow_0ra8wfk</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="NN_Sign" name="Ký nhận / xác nhận đơn hàng" />
    <bpmn:endEvent id="NN_End_Success" name="Đơn hàng được người nhận xác nhận" />
    <bpmn:exclusiveGateway id="NN_RedeliveryQ" name="Yêu cầu giao lại sau?" />
    <bpmn:intermediateThrowEvent id="NN_Reject" name="Thông báo từ chối đã gửi">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="NN_Redelivery" name="Gửi yêu cầu giao lại">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="NN_End_Redelivery" name="Yêu cầu giao lại đã được gửi" />
    <bpmn:endEvent id="NN_End_Reject" name="Người nhận từ chối nhận hàng" />
    <bpmn:sequenceFlow id="NN_F1" sourceRef="NN_Start" targetRef="NN_Check" />
    <bpmn:sequenceFlow id="NN_F2" sourceRef="NN_Check" targetRef="NN_Accept" />
    <bpmn:sequenceFlow id="NN_F3" name="Đồng ý nhận" sourceRef="NN_Accept" targetRef="NN_COD" />
    <bpmn:sequenceFlow id="NN_F4" name="Không đồng ý nhận" sourceRef="NN_Accept" targetRef="NN_RedeliveryQ" />
    <bpmn:sequenceFlow id="NN_F10" name="Có COD" sourceRef="NN_COD" targetRef="NN_Pay" />
    <bpmn:sequenceFlow id="Flow_062f7cb" sourceRef="NN_Pay" targetRef="NN_Merge" />
    <bpmn:sequenceFlow id="NN_F12" sourceRef="NN_Merge" targetRef="NN_Sign" />
    <bpmn:sequenceFlow id="NN_F13" sourceRef="NN_Sign" targetRef="NN_End_Success" />
    <bpmn:sequenceFlow id="NN_F5" name="Có" sourceRef="NN_RedeliveryQ" targetRef="NN_Redelivery" />
    <bpmn:sequenceFlow id="NN_F7" name="Không" sourceRef="NN_RedeliveryQ" targetRef="NN_Reject" />
    <bpmn:sequenceFlow id="NN_F8" sourceRef="NN_Reject" targetRef="NN_End_Reject" />
    <bpmn:sequenceFlow id="NN_F6" sourceRef="NN_Redelivery" targetRef="NN_End_Redelivery" />
    <bpmn:sequenceFlow id="Flow_0ra8wfk" name="Không có COD" sourceRef="NN_COD" targetRef="NN_Merge" />
  </bpmn:process>
