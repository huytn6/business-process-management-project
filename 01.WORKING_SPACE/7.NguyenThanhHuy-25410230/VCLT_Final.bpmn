    <sequenceFlow id="Flow_COD_NO_NN" name="Không COD" sourceRef="GW_COD_NN" targetRef="Activity_0pa4281" />
    <sequenceFlow id="SF_PL_YES" name="Có yêu cầu giao lại" sourceRef="GW_PhatLai" targetRef="IntThrow_PhatLai" />
    <sequenceFlow id="SF_PL_End" sourceRef="IntThrow_PhatLai" targetRef="End_ChoGiaoLai" />
    <startEvent id="StartEvt_NN" name="Nhận thông tin giao hàng">
