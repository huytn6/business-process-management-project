      <incoming>SF_DY_NO</incoming>
      <outgoing>SF_PL_YES</outgoing>
      <outgoing>Flow_05ludfz</outgoing>
    </exclusiveGateway>
    <intermediateThrowEvent id="IntThrow_PhatLai" name="Gửi yêu cầu giao hàng lại">
      <incoming>SF_PL_YES</incoming>
      <outgoing>SF_PL_End</outgoing>
      <messageEventDefinition id="MED_Throw" />
    </intermediateThrowEvent>
    <endEvent id="End_ChoGiaoLai" name="Yêu cầu giao lại đã được gửi">
      <incoming>SF_PL_End</incoming>
    </endEvent>
    <sequenceFlow id="SF_NN2" sourceRef="Task_KTH" targetRef="GW_DongY" />
