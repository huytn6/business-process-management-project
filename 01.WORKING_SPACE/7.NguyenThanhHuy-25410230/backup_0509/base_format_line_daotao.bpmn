      </lane>
    </laneSet>
    <dataStoreReference id="ds2" name="Hệ thống quản lý nhân sự (HRM)" />
    <exclusiveGateway id="gjoin2" name="">
      <incoming>Flow_22</incoming>
      <incoming>Flow_29</incoming>
      <outgoing>Flow_30</outgoing>
    </exclusiveGateway>
    <serviceTask id="t11" name="Ghi nhận kết quả đào tạo vào hệ thống">
