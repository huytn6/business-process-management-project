      <outgoing>Flow_23</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_0fvlr0x">
        <targetRef>ds2</targetRef>
      </dataOutputAssociation>
    </serviceTask>
    <exclusiveGateway id="g6" name="Đạt yêu cầu thử việc?">
