        <flowNodeRef>Task_PhongVan</flowNodeRef>
        <flowNodeRef>Timer_KetQuaPV</flowNodeRef>
        <flowNodeRef>Gateway_PhongVan</flowNodeRef>
        <flowNodeRef>Task_MoiNhanViec</flowNodeRef>
        <flowNodeRef>Gateway_And_Start</flowNodeRef>
        <flowNodeRef>Gateway_And_End</flowNodeRef>
        <flowNodeRef>Gateway_ThuViec</flowNodeRef>
        <flowNodeRef>Task_KyHDLD</flowNodeRef>
        <flowNodeRef>End_TuChoiDeXuat</flowNodeRef>
        <flowNodeRef>Task_TuChoi_PV</flowNodeRef>
        <flowNodeRef>Task_TuChoi_ThuViec</flowNodeRef>
        <flowNodeRef>End_TruotThuViec</flowNodeRef>
        <flowNodeRef>End_TruotPV</flowNodeRef>
        <flowNodeRef>End_ThanhCong</flowNodeRef>
        <flowNodeRef>Task_TuChoi_HoSo</flowNodeRef>
        <flowNodeRef>End_LoaiHoSo</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_NhuCau" name="Phát sinh nhu cầu" />
    <task id="Task_DeXuat" name="Đề xuất tuyển nhân viên" />
    <task id="Task_XemXet" name="Xem xét đề xuất" />
    <task id="Task_DanhSach" name="Lên danh sách vị trí" />
    <task id="Task_DangTin" name="Đăng tin tuyển dụng" />
    <task id="Task_UngTuyen" name="Ứng tuyển online" />
    <task id="Task_NhanHoSo" name="Nhận hồ sơ" />
    <intermediateCatchEvent id="Timer_SangLoc" name="Chờ 5-7 ngày">
      <timerEventDefinition id="TimerEventDefinition_1" />
    </intermediateCatchEvent>
    <task id="Task_SangLoc" name="Sàng lọc hồ sơ" />
    <exclusiveGateway id="Gateway_SangLoc" name="Sàng lọc đạt?" />
    <task id="Task_MoiPV" name="Gửi thư mời PV" />
    <task id="Task_PhongVan" name="Phỏng vấn ứng viên" />
    <intermediateCatchEvent id="Timer_KetQuaPV" name="Chờ 3-5 ngày">
      <timerEventDefinition id="TimerEventDefinition_2" />
    </intermediateCatchEvent>
    <exclusiveGateway id="Gateway_PhongVan" name="Phỏng vấn đạt?" />
    <task id="Task_MoiNhanViec" name="Gửi thư mời nhận việc" />
    <parallelGateway id="Gateway_And_Start" name="Bắt đầu thử việc" />
    <task id="Task_ThuViec" name="Nhận việc &#38; Thử việc (3 tháng)" />
    <task id="Task_HuongDan" name="Sắp xếp &#38; Hướng dẫn công việc" />
