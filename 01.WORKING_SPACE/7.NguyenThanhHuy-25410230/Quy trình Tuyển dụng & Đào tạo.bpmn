  <process id="Process_TuyenDung" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_UngVien" name="Ứng viên">
        <flowNodeRef>Task_UngTuyen</flowNodeRef>
        <flowNodeRef>Task_ThuViec</flowNodeRef>
      </lane>
      <lane id="Lane_QuanLy" name="Quản lý Cửa hàng / Bưu cục">
        <flowNodeRef>Start_NhuCau</flowNodeRef>
        <flowNodeRef>Task_DeXuat</flowNodeRef>
        <flowNodeRef>Task_HuongDan</flowNodeRef>
        <flowNodeRef>Task_DanhGia</flowNodeRef>
      </lane>
      <lane id="Lane_BanLanhDao" name="Ban Lãnh đạo">
        <flowNodeRef>Task_XemXet</flowNodeRef>
        <flowNodeRef>Gateway_DuyetDeXuat</flowNodeRef>
      </lane>
      <lane id="Lane_HR" name="Phòng Nhân sự (HR)">
        <flowNodeRef>Task_DanhSach</flowNodeRef>
        <flowNodeRef>Task_DangTin</flowNodeRef>
        <flowNodeRef>Task_NhanHoSo</flowNodeRef>
        <flowNodeRef>Timer_SangLoc</flowNodeRef>
        <flowNodeRef>Task_SangLoc</flowNodeRef>
        <flowNodeRef>Gateway_SangLoc</flowNodeRef>
