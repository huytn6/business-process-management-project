<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ThuGomTapKet" targetNamespace="http://viettelpost.vn/bpmn/thu-gom-tap-ket" exporter="OpenAI" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_ThuGomTapKet">
    <bpmn:participant id="Participant_KhachHang" name="Khách hàng" processRef="Process_ThuGomTapKet"/>
    <bpmn:participant id="Participant_DieuPhoi" name="Điều phối viên" processRef="Process_ThuGomTapKet"/>
    <bpmn:participant id="Participant_Shipper" name="Shipper (Nhân viên thu gom)" processRef="Process_ThuGomTapKet"/>
    <bpmn:participant id="Participant_KhaiThac" name="Nhân viên khai thác bưu cục" processRef="Process_ThuGomTapKet"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ThuGomTapKet" name="Quy trình Thu gom – Tập kết" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ThuGomTapKet">
      <bpmn:lane id="Lane_KhachHang" name="Khách hàng">
        <bpmn:flowNodeRef>StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TaoYeuCau</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DieuPhoi" name="Điều phối viên">
        <bpmn:flowNodeRef>Task_TiepNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DuThongTin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BoSung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DieuPhoi</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Shipper" name="Shipper (Nhân viên thu gom)">
        <bpmn:flowNodeRef>Task_NhanNhiemVu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KiemTraHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DatYeuCau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DongGoiLai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CanInTem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CapNhat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VanChuyen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_KhaiThac" name="Nhân viên khai thác bưu cục">
        <bpmn:flowNodeRef>Task_TiepNhanBuuCuc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CanChinhXac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PhanLoai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SapXep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent" name="Bắt đầu"/>
    <bpmn:task id="Task_TaoYeuCau" name="Tạo yêu cầu lấy hàng"/>
    <bpmn:task id="Task_TiepNhan" name="Tiếp nhận &amp; kiểm tra thông tin đơn hàng"/>
    <bpmn:exclusiveGateway id="Gateway_DuThongTin" name="Đủ thông tin?"/>
    <bpmn:task id="Task_BoSung" name="Yêu cầu khách hàng bổ sung thông tin"/>
    <bpmn:task id="Task_DieuPhoi" name="Điều phối shipper phù hợp"/>
    <bpmn:task id="Task_NhanNhiemVu" name="Nhận nhiệm vụ &amp; di chuyển đến điểm gửi"/>
    <bpmn:task id="Task_KiemTraHang" name="Kiểm tra ngoại quan, cân sơ bộ"/>
    <bpmn:exclusiveGateway id="Gateway_DatYeuCau" name="Đạt yêu cầu?"/>
    <bpmn:task id="Task_DongGoiLai" name="Yêu cầu đóng gói lại hoặc từ chối nhận"/>
    <bpmn:task id="Task_CanInTem" name="Cân hàng, in/dán tem vận đơn"/>
    <bpmn:task id="Task_CapNhat" name="Cập nhật trạng thái &quot;Đã lấy hàng&quot;"/>
    <bpmn:task id="Task_VanChuyen" name="Vận chuyển hàng về bưu cục/điểm tập kết"/>
    <bpmn:task id="Task_TiepNhanBuuCuc" name="Tiếp nhận hàng, quét mã vận đơn"/>
    <bpmn:task id="Task_CanChinhXac" name="Cân chính xác &amp; đối chiếu hệ thống"/>
    <bpmn:task id="Task_PhanLoai" name="Phân loại sơ bộ theo tuyến"/>
    <bpmn:task id="Task_SapXep" name="Sắp xếp chờ chuyển trung tâm khai thác"/>
    <bpmn:endEvent id="EndEvent" name="Kết thúc"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent" targetRef="Task_TaoYeuCau"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_TaoYeuCau" targetRef="Task_TiepNhan"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_TiepNhan" targetRef="Gateway_DuThongTin"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_DuThongTin" targetRef="Task_DieuPhoi" name="Có"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_DuThongTin" targetRef="Task_BoSung" name="Không"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_BoSung" targetRef="Task_TiepNhan" name="Bổ sung thông tin"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_DieuPhoi" targetRef="Task_NhanNhiemVu"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_NhanNhiemVu" targetRef="Task_KiemTraHang"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_KiemTraHang" targetRef="Gateway_DatYeuCau"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_DatYeuCau" targetRef="Task_CanInTem" name="Có"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_DatYeuCau" targetRef="Task_DongGoiLai" name="Không"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_DongGoiLai" targetRef="Task_KiemTraHang" name="Đóng gói lại"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_CanInTem" targetRef="Task_CapNhat"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_CapNhat" targetRef="Task_VanChuyen"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_VanChuyen" targetRef="Task_TiepNhanBuuCuc"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_TiepNhanBuuCuc" targetRef="Task_CanChinhXac"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CanChinhXac" targetRef="Task_PhanLoai"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_PhanLoai" targetRef="Task_SapXep"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_SapXep" targetRef="EndEvent"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ThuGomTapKet">
    <bpmndi:BPMNPlane id="BPMNPlane_ThuGomTapKet" bpmnElement="Collaboration_ThuGomTapKet">
