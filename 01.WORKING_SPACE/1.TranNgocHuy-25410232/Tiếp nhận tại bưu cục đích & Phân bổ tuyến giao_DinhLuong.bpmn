<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DestinationPostOffice" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://bpmn.io)" exporterVersion="18.22.0">
  <bpmn:message id="Message_Arrival" name="Bưu gửi và manifest đến bưu cục đích"/>
  <bpmn:message id="Message_DeliveryReady" name="Tuyến giao đã sẵn sàng"/>
  <bpmn:collaboration id="Collaboration_DestinationPostOffice">
    <bpmn:participant id="Participant_Feeder" name="Trung tâm khai thác đích / xe feeder"/>
    <bpmn:participant id="Participant_PostOffice" name="BƯU CỤC PHÁT ĐÍCH" processRef="Process_DestinationPostOffice"/>
    <bpmn:participant id="Participant_LastMile" name="Quy trình kế tiếp: Giao hàng tận nơi &amp; Xác nhận"/>
    <bpmn:messageFlow id="MessageFlow_In" name="Bàn giao bưu gửi + manifest" sourceRef="Participant_Feeder" targetRef="Start_Arrival" messageRef="Message_Arrival"/>
    <bpmn:messageFlow id="MessageFlow_Out" name="Bàn giao tuyến giao" sourceRef="Task_Accept" targetRef="Participant_LastMile" messageRef="Message_DeliveryReady"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_DestinationPostOffice" name="Tiếp nhận tại bưu cục đích &amp; Phân bổ tuyến giao" isExecutable="false">
    <bpmn:laneSet id="LaneSet_DestinationPostOffice">
      <bpmn:lane id="Lane_Inbound" name="TIẾP NHẬN / INBOUND">
        <bpmn:flowNodeRef>Start_Arrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Discrepancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Discrepancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Barcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Relabel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="HỆ THỐNG NGHIỆP VỤ">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExceptionQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Group</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Suggest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Manifest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dispatch" name="TRƯỞNG BƯU CỤC / ĐIỀU PHỐI">
        <bpmn:flowNodeRef>Task_CheckLoad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Feasible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rebalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Courier" name="BƯU TÁ / TUYẾN GIAO">
        <bpmn:flowNodeRef>Task_CourierCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CourierMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Assigned</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Arrival" name="Chuyến feeder đến bưu cục đích">
      <bpmn:messageEventDefinition id="MessageEvent_Start" messageRef="Message_Arrival"/>
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Task_Receive" name="Tiếp nhận; kiểm tra seal, số bao/kiện và manifest">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_Handover" name="Bàn giao khớp?">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_Discrepancy" name="Cách ly phần sai lệch; lập biên bản và thông báo đầu gửi">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_Discrepancy" name="Chờ xử lý sai lệch">
      <bpmn:incoming>F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_OpenScan" name="Mở bao có kiểm soát; quét nhập tồn bưu cục đích">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Barcode" name="Mã/record hợp lệ?">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Relabel" name="Nhận dạng, sửa dữ liệu hoặc in/dán lại nhãn">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Validate" name="Kiểm tra địa chỉ, vùng phát, dịch vụ, COD và thuộc tính đặc biệt">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Đủ điều kiện phân tuyến?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ExceptionQueue" name="Đưa vào hàng chờ xác minh địa chỉ/tái định tuyến/xử lý chất lượng">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Hold" name="Tạm giữ có kiểm soát">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Group" name="Gom nhóm theo địa bàn, ưu tiên dịch vụ và khung giờ cam kết">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Suggest" name="Đề xuất tuyến giao và bưu tá theo vùng phục vụ">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_CheckLoad" name="Điều phối kiểm tra tải tuyến, năng lực bưu tá và giờ xuất phát">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Feasible" name="Phương án khả thi?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Rebalance" name="Tách/gộp tuyến, đổi bưu tá hoặc chuyển ca có kiểm soát">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Confirm" name="Xác nhận phân tuyến và khóa danh sách giao">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Manifest" name="Sinh bảng kê tuyến; cập nhật trạng thái sẵn sàng bàn giao">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_CourierCheck" name="Bưu tá nhận hàng; quét và đối chiếu với bảng kê tuyến">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CourierMatch" name="Bàn giao khớp?">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Reconcile" name="Đối soát thiếu/thừa/sai tuyến và điều chỉnh danh sách">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_Accept" name="Bưu tá xác nhận nhận tuyến; hệ thống ghi nhận xuất giao">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Assigned" name="Sẵn sàng giao hàng tận nơi">
      <bpmn:incoming>F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Arrival" targetRef="Task_Receive"/>
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Receive" targetRef="Gateway_Handover"/>
    <bpmn:sequenceFlow id="F03" sourceRef="Gateway_Handover" targetRef="Task_OpenScan" name="Có (99 %)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F04" sourceRef="Gateway_Handover" targetRef="Task_Discrepancy" name="Không (1 %)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F05" sourceRef="Task_Discrepancy" targetRef="End_Discrepancy"/>
    <bpmn:sequenceFlow id="F06" sourceRef="Task_OpenScan" targetRef="Gateway_Barcode"/>
    <bpmn:sequenceFlow id="F07" sourceRef="Gateway_Barcode" targetRef="Task_Validate" name="Có (97 %)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F08" sourceRef="Gateway_Barcode" targetRef="Task_Relabel" name="Không (3 %)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F09" sourceRef="Task_Relabel" targetRef="Task_OpenScan"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Validate" targetRef="Gateway_Eligible"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Gateway_Eligible" targetRef="Task_Group" name="Có (98 %)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" sourceRef="Gateway_Eligible" targetRef="Task_ExceptionQueue" name="Không (2 %)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_ExceptionQueue" targetRef="End_Hold"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Group" targetRef="Task_Suggest"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Suggest" targetRef="Task_CheckLoad"/>
    <bpmn:sequenceFlow id="F16" sourceRef="Task_CheckLoad" targetRef="Gateway_Feasible"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Gateway_Feasible" targetRef="Task_Confirm" name="Có (96 %)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F18" sourceRef="Gateway_Feasible" targetRef="Task_Rebalance" name="Không (4 %)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F19" sourceRef="Task_Rebalance" targetRef="Task_CheckLoad"/>
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Confirm" targetRef="Task_Manifest"/>
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Manifest" targetRef="Task_CourierCheck"/>
    <bpmn:sequenceFlow id="F22" sourceRef="Task_CourierCheck" targetRef="Gateway_CourierMatch"/>
    <bpmn:sequenceFlow id="F23" sourceRef="Gateway_CourierMatch" targetRef="Task_Accept" name="Có (97 %)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F24" sourceRef="Gateway_CourierMatch" targetRef="Task_Reconcile" name="Không (3 %)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Không</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F25" sourceRef="Task_Reconcile" targetRef="Task_CourierCheck"/>
    <bpmn:sequenceFlow id="F26" sourceRef="Task_Accept" targetRef="End_Assigned"/>
  <bpmn:textAnnotation id="TA_Q0"><bpmn:text>0,3 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q1"><bpmn:text>0,4 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q2"><bpmn:text>0,2 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q3"><bpmn:text>0,2 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q4"><bpmn:text>0,2 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q5"><bpmn:text>0,3 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q6"><bpmn:text>0,2 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q7"><bpmn:text>0,2 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q8"><bpmn:text>0,3 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q9"><bpmn:text>0,2 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q10"><bpmn:text>8,0 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q11"><bpmn:text>4,0 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q12"><bpmn:text>10,0 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q13"><bpmn:text>4,0 phút</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TA_Q14"><bpmn:text>3,0 phút</bpmn:text></bpmn:textAnnotation></bpmn:process>
