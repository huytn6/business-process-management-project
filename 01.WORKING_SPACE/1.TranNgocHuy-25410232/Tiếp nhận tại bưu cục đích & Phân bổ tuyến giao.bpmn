          <dc:Bounds x="3050" y="887" width="175" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Rebalance" bpmnElement="Task_Rebalance">
        <dc:Bounds x="3000" y="1050" width="350" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Confirm" bpmnElement="Task_Confirm">
        <dc:Bounds x="3290" y="930" width="300" height="105"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Manifest" bpmnElement="Task_Manifest">
        <dc:Bounds x="3500" y="615" width="300" height="105"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CourierCheck" bpmnElement="Task_CourierCheck">
        <dc:Bounds x="3500" y="1240" width="305" height="105"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_CourierMatch" bpmnElement="Gateway_CourierMatch">
        <dc:Bounds x="3885" y="1263" width="64" height="64"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3830" y="1197" width="175" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Reconcile" bpmnElement="Task_Reconcile">
        <dc:Bounds x="3780" y="1365" width="310" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Accept" bpmnElement="Task_Accept">
        <dc:Bounds x="4060" y="1240" width="300" height="105"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Assigned" bpmnElement="End_Assigned">
        <dc:Bounds x="4420" y="1275" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="4360" y="1307" width="160" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_F01" bpmnElement="F01">
        <di:waypoint x="366" y="323"/>
        <di:waypoint x="430" y="323"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F02" bpmnElement="F02">
        <di:waypoint x="710" y="323"/>
