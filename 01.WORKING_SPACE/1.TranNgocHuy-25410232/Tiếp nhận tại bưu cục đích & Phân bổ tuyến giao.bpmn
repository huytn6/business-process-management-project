      <bpmndi:BPMNShape id="Shape_Lane_Courier" bpmnElement="Lane_Courier" isHorizontal="true">
        <dc:Bounds x="240" y="1200" width="4320" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Arrival" bpmnElement="Start_Arrival">
