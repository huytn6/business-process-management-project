        <dc:Bounds x="180" y="180" width="4380" height="1320"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_LastMile" bpmnElement="Participant_LastMile" isHorizontal="true">
        <dc:Bounds x="3680" y="1560" width="880" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Inbound" bpmnElement="Lane_Inbound" isHorizontal="true">
        <dc:Bounds x="240" y="180" width="4320" height="330"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_System" bpmnElement="Lane_System" isHorizontal="true">
