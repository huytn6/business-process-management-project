        <dc:Bounds x="1895" y="638" width="64" height="64"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1840" y="572" width="170" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
