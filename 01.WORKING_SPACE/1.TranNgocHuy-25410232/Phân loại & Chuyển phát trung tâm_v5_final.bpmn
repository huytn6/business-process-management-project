      <bpmn:incoming>Flow_DT4OPS_JOIN</bpmn:incoming>
      <bpmn:incoming>Flow_DT4TECH_JOIN</bpmn:incoming>
      <bpmn:outgoing>Flow_JOINDT4_GWRSORT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_GW5_DT4CAUSE" name="Không hợp lệ (3%)" sourceRef="GW5" targetRef="GW_DT4CAUSE">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ketQuaChiaChonHopLe == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DT4CAUSE_OPS" name="Do vận hành (70%*)" sourceRef="GW_DT4CAUSE" targetRef="DT4_OPS" />
    <bpmn:sequenceFlow id="Flow_DT4CAUSE_TECH" name="Do thiết bị (30%*)" sourceRef="GW_DT4CAUSE" targetRef="DT4_TECH">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nguyenNhanThietBi == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DT4OPS_JOIN" sourceRef="DT4_OPS" targetRef="JOIN_DT4" />
    <bpmn:sequenceFlow id="Flow_DT4TECH_JOIN" sourceRef="DT4_TECH" targetRef="JOIN_DT4" />
    <bpmn:exclusiveGateway id="GWR1" name="Đã vượt quá số lần thử đọc mã?" default="Flow_GWR1_GWJ1">
      <bpmn:incoming>Flow_IN4_GWR1</bpmn:incoming>
      <bpmn:outgoing>Flow_GWR1_GWJ1</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWR1_EX4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="EX4" name="Chuyển xử lý ngoại lệ đọc mã lặp lại">
      <bpmn:incoming>Flow_GWR1_EX4</bpmn:incoming>
      <bpmn:outgoing>Flow_EX4_EE4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE4" name="Bưu gửi đã được chuyển xử lý ngoại lệ do lỗi đọc mã lặp lại">
      <bpmn:incoming>Flow_EX4_EE4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_IN4_GWR1" sourceRef="IN4" targetRef="GWR1" />
    <bpmn:sequenceFlow id="Flow_GWR1_GWJ1" name="Chưa đủ 3 lần (90%*)" sourceRef="GWR1" targetRef="GWJ1" />
    <bpmn:sequenceFlow id="Flow_GWR1_EX4" name="Đã đủ 3 lần (10%*)" sourceRef="GWR1" targetRef="EX4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${soLanDocMa &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EX4_EE4" sourceRef="EX4" targetRef="EE4" />
  <bpmn:boundaryEvent id="BE_STAGE_ERR" name="Quá hạn chờ xuất tuyến" attachedToRef="SUB_STAGE"><bpmn:outgoing>Flow_BESTAGE_EE5</bpmn:outgoing><bpmn:errorEventDefinition id="ErrDef_BE_STAGE" errorRef="Error_StageTimeout" /></bpmn:boundaryEvent><bpmn:endEvent id="EE5" name="Lô hàng đã hủy xuất tuyến do quá hạn chờ"><bpmn:incoming>Flow_BESTAGE_EE5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_BESTAGE_EE5" name="Hủy xuất tuyến" sourceRef="BE_STAGE_ERR" targetRef="EE5" /><bpmn:boundaryEvent id="BE_RECON_ERR" name="Sai lệch đối soát không khớp" attachedToRef="SUB_RECON"><bpmn:outgoing>Flow_BERECON_EE6</bpmn:outgoing><bpmn:errorEventDefinition id="ErrDef_BE_RECON" errorRef="Error_ReconMismatch" /></bpmn:boundaryEvent><bpmn:endEvent id="EE6" name="Lô hàng đã tạm dừng đóng manifest do sai lệch đối soát"><bpmn:incoming>Flow_BERECON_EE6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_BERECON_EE6" name="Tạm dừng manifest" sourceRef="BE_RECON_ERR" targetRef="EE6" /><bpmn:exclusiveGateway id="GWR_SORT" name="Đã vượt quá số lần thử chia chọn?" isMarkerVisible="true"><bpmn:incoming>Flow_JOINDT4_GWRSORT</bpmn:incoming><bpmn:outgoing>Flow_GWRSORT_GWJ2</bpmn:outgoing><bpmn:outgoing>Flow_GWRSORT_DT3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="Flow_JOINDT4_GWRSORT" sourceRef="JOIN_DT4" targetRef="GWR_SORT" /><bpmn:sequenceFlow id="Flow_GWRSORT_GWJ2" name="Chưa đủ 3 lần (90%*)" sourceRef="GWR_SORT" targetRef="GWJ2" /><bpmn:sequenceFlow id="Flow_GWRSORT_DT3" name="Đã đủ 3 lần (10%*)" sourceRef="GWR_SORT" targetRef="DT3" /></bpmn:process>
  <bpmn:process id="Process_CAR" isExecutable="false">
    <bpmn:dataStoreReference id="DS3" name="Hệ thống WMS/TMS" dataStoreRef="DataStore_WMS_TMS" />
    <bpmn:startEvent id="C1" name="Thông báo bàn giao đã được tiếp nhận">
      <bpmn:outgoing>Flow_C1_C2A</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_C1" />
    </bpmn:startEvent>
    <bpmn:manualTask id="C2A" name="Xếp lô hàng lên phương tiện">
      <bpmn:incoming>Flow_C1_C2A</bpmn:incoming>
      <bpmn:outgoing>Flow_C2A_C2G</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="C2G" name="Đọc manifest bàn giao từ WMS/TMS">
      <bpmn:incoming>Flow_C2A_C2G</bpmn:incoming>
      <bpmn:outgoing>Flow_C2G_C2B</bpmn:outgoing>
      <bpmn:property id="Property_C2G_ManifestInput" name="Manifest bàn giao" />
      <bpmn:property id="Property_1m4qbu8" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_DS3_C2G">
        <bpmn:documentation>Đọc property "Manifest lô hàng" mà OT5A đã ghi (tham chiếu chung Data Store WMS/TMS, phía HUB gọi là DS2, phía đội vận tải gọi là DS3).</bpmn:documentation>
        <bpmn:sourceRef>DS3</bpmn:sourceRef>
        <bpmn:targetRef>Property_1m4qbu8</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="C2B" name="Đối chiếu lô hàng lần cuối">
      <bpmn:incoming>Flow_C2G_C2B</bpmn:incoming>
      <bpmn:outgoing>Flow_C2B_C2C</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="C2C" name="Ký nhận bàn giao">
      <bpmn:incoming>Flow_C2B_C2C</bpmn:incoming>
      <bpmn:outgoing>Flow_C2C_C2E</bpmn:outgoing>
    </bpmn:userTask>
