      <bpmn:incoming>Flow_OW1_OE1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="EBG1" name="Chờ phản hồi bàn giao">
      <bpmn:incoming>Flow_OT6_EBG1</bpmn:incoming>
      <bpmn:outgoing>Flow_EBG1_OW1</bpmn:outgoing>
      <bpmn:outgoing>Flow_EBG1_TM2</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="TM2" name="Thời gian chờ xác nhận đã kết thúc (~30 phút)">
      <bpmn:incoming>Flow_EBG1_TM2</bpmn:incoming>
      <bpmn:outgoing>Flow_TM2_EX3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_TM2">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="EX3" name="Liên hệ xác minh tình trạng bàn giao">
      <bpmn:incoming>Flow_TM2_EX3</bpmn:incoming>
      <bpmn:outgoing>Flow_EX3_EE3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE3" name="Ngoại lệ xác nhận bàn giao đã được ghi nhận">
      <bpmn:incoming>Flow_EX3_EE3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_OT6_EBG1" sourceRef="OT6" targetRef="EBG1" />
    <bpmn:sequenceFlow id="Flow_EBG1_OW1" name="Chờ xác nhận" sourceRef="EBG1" targetRef="OW1" />
