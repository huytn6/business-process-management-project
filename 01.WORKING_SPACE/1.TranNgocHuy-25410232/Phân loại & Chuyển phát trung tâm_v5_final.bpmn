        <bpmn:incoming>Flow_OT5A_OT6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_RECONS_JOIN" sourceRef="RECON_S" targetRef="RECON_JOIN" />
      <bpmn:sequenceFlow id="Flow_OJ2_OT3" sourceRef="RECON_JOIN" targetRef="OT3" />
      <bpmn:sequenceFlow id="Flow_GW7_OT5" name="Khớp (97%)" sourceRef="GW7" targetRef="OT5" />
      <bpmn:sequenceFlow id="Flow_GW7_OT4" name="Chưa khớp (3%)" sourceRef="GW7" targetRef="OT4">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${doiSoatKhop == false}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_OT5A_OT6" sourceRef="OT5A" targetRef="RECON_E" />
      <bpmn:exclusiveGateway id="GWR3" name="Đã vượt quá số lần đối soát lại?" default="Flow_GWR3_RECONJOIN">
        <bpmn:incoming>Flow_OT4_GWR3</bpmn:incoming>
        <bpmn:outgoing>Flow_GWR3_RECONJOIN</bpmn:outgoing>
        <bpmn:outgoing>Flow_GWR3_RECONEXC</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="RECON_EXC" name="Báo cáo chênh lệch đối soát cho quản lý ca">
        <bpmn:incoming>Flow_GWR3_RECONEXC</bpmn:incoming>
        <bpmn:outgoing>Flow_RECONEXC_RECONE2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="RECON_E2" name="Đối soát chưa khớp sau nhiều lần kiểm tra, đã báo cáo ngoại lệ">
        <bpmn:incoming>Flow_RECONEXC_RECONE2</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorDef_RECON" errorRef="Error_ReconMismatch" /></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_OT4_GWR3" sourceRef="OT4" targetRef="GWR3" />
      <bpmn:sequenceFlow id="Flow_GWR3_RECONJOIN" name="Chưa đủ 3 lần (85%*)" sourceRef="GWR3" targetRef="RECON_JOIN" />
      <bpmn:sequenceFlow id="Flow_GWR3_RECONEXC" name="Đã đủ 3 lần (15%*)" sourceRef="GWR3" targetRef="RECON_EXC">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${soLanDoiSoat &gt;= 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_RECONEXC_RECONE2" sourceRef="RECON_EXC" targetRef="RECON_E2" />
    </bpmn:subProcess>
    <bpmn:sendTask id="OT6" name="Thông báo sẵn sàng bàn giao lô hàng">
      <bpmn:incoming>Flow_SUBRECON_OT6</bpmn:incoming>
      <bpmn:outgoing>Flow_OT6_EBG1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_OJ1_OT1" sourceRef="OJ1" targetRef="SUB_STAGE" />
    <bpmn:sequenceFlow id="Flow_SUBSTAGE_OT2" sourceRef="SUB_STAGE" targetRef="OT2" />
    <bpmn:sequenceFlow id="Flow_OT2_OJ2" sourceRef="OT2" targetRef="SUB_RECON" />
    <bpmn:sequenceFlow id="Flow_SUBRECON_OT6" sourceRef="SUB_RECON" targetRef="OT6" />
    <bpmn:sequenceFlow id="Flow_OW1_OE1" sourceRef="OW1" targetRef="OE1" />
    <bpmn:intermediateCatchEvent id="OW1" name="Xác nhận bàn giao đã được tiếp nhận">
      <bpmn:incoming>Flow_EBG1_OW1</bpmn:incoming>
      <bpmn:outgoing>Flow_OW1_OE1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_OW1" />
    </bpmn:intermediateCatchEvent>
