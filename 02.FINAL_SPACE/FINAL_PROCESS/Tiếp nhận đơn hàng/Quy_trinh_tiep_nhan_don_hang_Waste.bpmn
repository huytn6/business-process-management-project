<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OrderIntake" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN order-intake reconstruction" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_OrderIntake">
    <bpmn:participant id="Participant_Customer" name="Khách hàng / Đối tác" />
    <bpmn:participant id="Participant_ViettelPost" name="Viettel Post" processRef="Process_OrderIntake" />
    <bpmn:messageFlow id="MessageFlow_Request" name="Yêu cầu tạo đơn" sourceRef="Participant_Customer" targetRef="StartEvent_Request" />
    <bpmn:messageFlow id="MessageFlow_RequestSupplement" name="Yêu cầu bổ sung thông tin" sourceRef="Task_RequestSupplement" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MessageFlow_Supplement" name="Thông tin bổ sung" sourceRef="Participant_Customer" targetRef="Task_ReceiveSupplement" />
    <bpmn:messageFlow id="MessageFlow_Confirmation" name="Xác nhận và mã vận đơn" sourceRef="Task_SendConfirmation" targetRef="Participant_Customer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OrderIntake" name="Quy trình tiếp nhận đơn hàng" isExecutable="false">
    <bpmn:laneSet id="LaneSet_OrderIntake">
      <bpmn:lane id="Lane_Channel" name="Kênh tiếp nhận / Nhân viên">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestSupplement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveSupplement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Recorded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OMS" name="Hệ thống OMS / API">
        <bpmn:flowNodeRef>Gateway_RequestEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateAndNormalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InformationValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RecordJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RecordAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateWaybill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WaybillCreated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CSKH" name="CSKH / Xử lý ngoại lệ">
        <bpmn:flowNodeRef>Gateway_ErrorJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandleCreationError</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pickup" name="Bộ phận nhận hàng / Thu gom (ngoài phạm vi)" />
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Request" name="Yêu cầu đã nhận">
      <bpmn:messageEventDefinition id="StartEvent_Request_definition" />
    </bpmn:startEvent>
    <bpmn:receiveTask id="Task_ReceiveRequest" name="Tiếp nhận yêu cầu tạo đơn" />
    <bpmn:sendTask id="Task_RequestSupplement" name="Gửi yêu cầu bổ sung thông tin" />
    <bpmn:receiveTask id="Task_ReceiveSupplement" name="Tiếp nhận thông tin đã bổ sung" />
    <bpmn:sendTask id="Task_SendConfirmation" name="Gửi xác nhận và mã vận đơn" />
    <bpmn:endEvent id="EndEvent_Recorded" name="Đơn đã được ghi nhận" />
    <bpmn:exclusiveGateway id="Gateway_RequestEntry" name="" />
    <bpmn:serviceTask id="Task_ValidateAndNormalize" name="Kiểm tra trường bắt buộc, định dạng và chuẩn hóa địa chỉ">
      <bpmn:ioSpecification>
        <bpmn:dataInput id="DataInput_Order" name="Dữ liệu đơn hàng đầu vào" />
        <bpmn:inputSet id="Task_ValidateAndNormalize_InputSet">
          <bpmn:dataInputRefs>DataInput_Order</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Task_ValidateAndNormalize_OutputSet" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="DataAssociation_Validate_Read">
        <bpmn:sourceRef>DataStore_OMS</bpmn:sourceRef>
        <bpmn:targetRef>DataInput_Order</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_InformationValid" name="Thông tin hợp lệ?" />
    <bpmn:exclusiveGateway id="Gateway_RecordJoin" name="" />
    <bpmn:serviceTask id="Task_RecordOrder" name="Ghi nhận đơn điện tử">
      <bpmn:ioSpecification>
        <bpmn:dataOutput id="DataOutput_Order" name="Dữ liệu đơn hàng đã ghi nhận" />
        <bpmn:inputSet id="Task_RecordOrder_InputSet" />
        <bpmn:outputSet id="Task_RecordOrder_OutputSet">
          <bpmn:dataOutputRefs>DataOutput_Order</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="DataAssociation_Record_Write">
        <bpmn:sourceRef>DataOutput_Order</bpmn:sourceRef>
        <bpmn:targetRef>DataStore_OMS</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RecordAccepted" name="" />
    <bpmn:serviceTask id="Task_CreateWaybill" name="Khởi tạo mã vận đơn" />
    <bpmn:exclusiveGateway id="Gateway_WaybillCreated" name="Tạo đơn thành công?" />
    <bpmn:exclusiveGateway id="Gateway_ErrorJoin" name="" />
    <bpmn:userTask id="Task_HandleCreationError" name="Tiếp nhận và xử lý lỗi tạo đơn" />
    <bpmn:dataStoreReference id="DataStore_OMS" name="OMS / CSDL đơn hàng" />
    <bpmn:sequenceFlow id="Flow_Start_Receive" sourceRef="StartEvent_Request" targetRef="Task_ReceiveRequest" name="Tiếp nhận yêu cầu" />
    <bpmn:sequenceFlow id="Flow_Receive_Entry" sourceRef="Task_ReceiveRequest" targetRef="Gateway_RequestEntry" name="OMS" />
    <bpmn:sequenceFlow id="Flow_Entry_Validate" sourceRef="Gateway_RequestEntry" targetRef="Task_ValidateAndNormalize" name="Kiểm tra" />
    <bpmn:sequenceFlow id="Flow_Validate_Check" sourceRef="Task_ValidateAndNormalize" targetRef="Gateway_InformationValid" name="Kết quả" />
    <bpmn:sequenceFlow id="Flow_Valid_RecordJoin" sourceRef="Gateway_InformationValid" targetRef="Gateway_RecordJoin" name="Có [92%]">
      <bpmn:conditionExpression id="Flow_Valid_RecordJoin_condition" xsi:type="bpmn:tFormalExpression">Có [92%]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid_RequestSupplement" sourceRef="Gateway_InformationValid" targetRef="Task_RequestSupplement" name="Không [8%]">
      <bpmn:conditionExpression id="Flow_Invalid_RequestSupplement_condition" xsi:type="bpmn:tFormalExpression">Không [8%]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Request_ReceiveSupplement" sourceRef="Task_RequestSupplement" targetRef="Task_ReceiveSupplement" name="Bổ sung" />
    <bpmn:sequenceFlow id="Flow_Supplement_Entry" sourceRef="Task_ReceiveSupplement" targetRef="Gateway_RequestEntry" name="Nhận bổ sung" />
    <bpmn:sequenceFlow id="Flow_RecordJoin_Record" sourceRef="Gateway_RecordJoin" targetRef="Task_RecordOrder" name="Ghi nhận" />
    <bpmn:sequenceFlow id="Flow_Record_Check" sourceRef="Task_RecordOrder" targetRef="Gateway_RecordAccepted" name="Kiểm tra" />
    <bpmn:sequenceFlow id="Flow_Record_Create" sourceRef="Gateway_RecordAccepted" targetRef="Task_CreateWaybill" name="Có [95%]">
      <bpmn:conditionExpression id="Flow_Record_Create_condition" xsi:type="bpmn:tFormalExpression">Có [95%]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Record_Error" sourceRef="Gateway_RecordAccepted" targetRef="Gateway_ErrorJoin" name="Không [5%]">
      <bpmn:conditionExpression id="Flow_Record_Error_condition" xsi:type="bpmn:tFormalExpression">Không [5%]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ErrorJoin_Handle" sourceRef="Gateway_ErrorJoin" targetRef="Task_HandleCreationError" name="Xử lý lỗi" />
    <bpmn:sequenceFlow id="Flow_Error_RecordJoin" sourceRef="Task_HandleCreationError" targetRef="Gateway_RecordJoin" name="Tạo lại" />
    <bpmn:sequenceFlow id="Flow_Create_Check" sourceRef="Task_CreateWaybill" targetRef="Gateway_WaybillCreated" name="Kiểm tra mã" />
    <bpmn:sequenceFlow id="Flow_Created_Notify" sourceRef="Gateway_WaybillCreated" targetRef="Task_SendConfirmation" name="Có [99.5%]">
      <bpmn:conditionExpression id="Flow_Created_Notify_condition" xsi:type="bpmn:tFormalExpression">Có [99.5%]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Create_Error" sourceRef="Gateway_WaybillCreated" targetRef="Gateway_ErrorJoin" name="Không [0.5%]">
      <bpmn:conditionExpression id="Flow_Create_Error_condition" xsi:type="bpmn:tFormalExpression">Không [0.5%]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Notify_End" sourceRef="Task_SendConfirmation" targetRef="EndEvent_Recorded" name="Xác nhận" />
    <bpmn:textAnnotation id="Waste_Hold">
      <bpmn:text>[HOLD - Waiting]
Chờ khách hàng bổ sung dữ liệu</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_Move">
      <bpmn:text>[MOVE - Motion]
Chuyển dữ liệu giữa kênh và OMS</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_Defect">
      <bpmn:text>[OVER-DO - Defect]
Vòng lặp sửa lỗi tạo đơn</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
