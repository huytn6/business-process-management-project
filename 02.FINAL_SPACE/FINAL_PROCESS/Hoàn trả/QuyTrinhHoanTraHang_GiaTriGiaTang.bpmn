    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_VA_H4">
      <bpmn:text>[BVA] Cần thiết kiểm soát</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_VA_H7">
      <bpmn:text>[NVA] Chờ đợi / Lặp lại</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_VA_H9">
      <bpmn:text>[BVA] Cập nhật hủy đơn</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_VA_H1">
