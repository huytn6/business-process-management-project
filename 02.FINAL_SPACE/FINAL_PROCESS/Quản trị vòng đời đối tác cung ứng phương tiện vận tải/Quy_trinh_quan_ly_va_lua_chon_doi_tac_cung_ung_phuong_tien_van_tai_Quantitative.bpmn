<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_ViettelPost_TransportOnboarding" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collaboration_TransportOnboarding">
    <bpmn:participant id="Participant_Partner" name="Đơn vị cung ứng phương tiện" />
    <bpmn:participant id="Participant_ViettelPost" name="Tổng Công ty Cổ phần Bưu chính Viettel (Viettel Post)" processRef="Process_TransportOnboarding" />
    <bpmn:messageFlow id="MsgFlow_Invite" name="Thư mời hợp tác cung ứng xe" sourceRef="Task_PublishInvite" targetRef="Participant_Partner" />
    <bpmn:messageFlow id="MsgFlow_SubmitDossier" name="Hồ sơ đăng ký &#38; Giấy tờ xe" sourceRef="Participant_Partner" targetRef="Task_ReceiveDossier" />
    <bpmn:messageFlow id="MsgFlow_RequestSupplement" name="Yêu cầu bổ sung chứng từ xe" sourceRef="Task_RequestSupplement" targetRef="Participant_Partner" />
    <bpmn:messageFlow id="MsgFlow_SubmitSupplement" name="Hồ sơ bổ sung (Đăng kiểm/Bảo hiểm)" sourceRef="Participant_Partner" targetRef="Task_ReceiveSupplement" />
    <bpmn:messageFlow id="MsgFlow_NotifyReject" name="Thông báo kết quả không lựa chọn" sourceRef="Task_NotifyReject" targetRef="Participant_Partner" />
    <bpmn:messageFlow id="MsgFlow_SendContract" name="Hợp đồng nguyên tắc vận tải" sourceRef="Task_PrepareContract" targetRef="Participant_Partner" />
    <bpmn:messageFlow id="MsgFlow_ReturnSignedContract" name="Hợp đồng đã ký đóng dấu" sourceRef="Participant_Partner" targetRef="Task_ReceiveContract" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TransportOnboarding" name="Quy trình Quản lý và Lựa chọn Đối tác Cung ứng Phương tiện Vận tải" isExecutable="true">
    <bpmn:laneSet id="LaneSet_ViettelPost">
      <bpmn:lane id="Lane_ManagementApprover" name="Cấp quản lý phê duyệt">
        <bpmn:flowNodeRef>GW_Join_ProposalEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReworkProposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ProposalApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProposalRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LegalFinance" name="Bộ phận Pháp chế - Tài chính">
        <bpmn:flowNodeRef>GW_Join_ContractEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestContractFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ContractValid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Bộ phận Quản lý đối tác / Mua sắm">
        <bpmn:flowNodeRef>Task_PreliminaryAppraisal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_PreliminaryPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeepAppraisal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DeepAppraisalPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectMechanism</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateCommercial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CommercialAgreed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PartnerRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActivateTMS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PartnerActivated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveSupplement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveDossier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Join_DossierEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DossierComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestSupplement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Join_Rejection</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TransportOperations" name="Bộ phận Khai thác vận tải">
        <bpmn:flowNodeRef>StartEvent_NeedVehicle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssessInternalFleet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_NeedOutsource</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InternalFleetSufficient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefineStandard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishInvite</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataStoreReference id="DataStore_TMS" name="Hệ thống TMS &#38; CSDL Đối tác Vận tải" />
    <bpmn:userTask id="Task_PreliminaryAppraisal" name="Thẩm định sơ bộ và lập biên bản đánh giá">
      <bpmn:incoming>Flow_DossierCompleteYes</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_PreliminaryPass" name="Kết quả thẩm định sơ bộ có đạt không?">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_PreliminaryPassYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_PreliminaryPassNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DeepAppraisal" name="Thẩm định chuyên sâu phương tiện và GPS thực địa">
      <bpmn:incoming>Flow_PreliminaryPassYes</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_DeepAppraisalPass" name="Thẩm định chuyên sâu phương tiện có đạt yêu cầu?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_DeepPassYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DeepPassNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SelectMechanism" name="Lựa chọn cơ chế hợp tác và xây dựng phương án">
      <bpmn:incoming>Flow_DeepPassYes</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_NegotiateCommercial" name="Thương lượng điều khoản thương mại và cước phí">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_CommercialAgreed" name="Có thống nhất điều khoản thương mại?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_CommercialAgreedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_CommercialAgreedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyReject" name="Gửi thông báo hồ sơ không được lựa chọn">
      <bpmn:incoming>Flow_ToRejectNotice</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejectEnd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_PartnerRejected" name="Hồ sơ đối tác không được lựa chọn">
      <bpmn:incoming>Flow_ToRejectEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ActivateTMS" name="Kích hoạt thông tin đối tác trên hệ thống TMS">
      <bpmn:incoming>Flow_ContractValidYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToActiveEnd</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssoc_TMS_Write">
        <bpmn:targetRef>DataStore_TMS</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_PartnerActivated" name="Đối tác đã được kích hoạt trên hệ thống TMS">
      <bpmn:incoming>Flow_ToActiveEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Join_ProposalEntry" name="Hợp nhất luồng trình phê duyệt">
      <bpmn:incoming>Flow_CommercialAgreedYes</bpmn:incoming>
      <bpmn:incoming>Flow_ProposalReworkLoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SubmitProposal" name="Xem xét và phê duyệt phương án hợp tác">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReworkProposal" name="Hoàn thiện phương án theo ý kiến chỉ đạo">
      <bpmn:incoming>Flow_ProposalNeedRework</bpmn:incoming>
      <bpmn:outgoing>Flow_ProposalReworkLoopBack</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_NeedVehicle" name="Nhu cầu bổ sung phương tiện đã phát sinh">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AssessInternalFleet" name="Đánh giá năng lực đội xe nội bộ">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:property id="Property_Assess" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssoc_TMS_Read1">
        <bpmn:sourceRef>DataStore_TMS</bpmn:sourceRef>
        <bpmn:targetRef>Property_Assess</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_NeedOutsource" name="Cần thuê ngoài phương tiện?">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_InternalOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_NeedOutsourceYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_InternalFleetSufficient" name="Năng lực nội bộ đáp ứng (Đóng yêu cầu)">
      <bpmn:incoming>Flow_InternalOk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_DefineStandard" name="Xác định tiêu chuẩn phương tiện và tuyến vận tải">
      <bpmn:incoming>Flow_NeedOutsourceYes</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_PublishInvite" name="Phát hành thông báo mời hợp tác xã hội hóa">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveSupplement" name="Tiếp nhận hồ sơ bổ sung từ đối tác">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_SupplementLoopBack</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_ReceiveDossier" name="Tiếp nhận và kiểm tra tính đầy đủ hồ sơ">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Join_DossierEntry" name="Hợp nhất luồng tiếp nhận hồ sơ">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_SupplementLoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_DossierComplete" name="Hồ sơ có đầy đủ hợp lệ không?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_DossierCompleteYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DossierCompleteNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestSupplement" name="Yêu cầu đối tác bổ sung giấy tờ còn thiếu">
      <bpmn:incoming>Flow_DossierCompleteNo</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_Join_Rejection" name="Hợp nhất luồng hồ sơ bị loại">
      <bpmn:incoming>Flow_PreliminaryPassNo</bpmn:incoming>
      <bpmn:incoming>Flow_DeepPassNo</bpmn:incoming>
      <bpmn:incoming>Flow_CommercialAgreedNo</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejectNotice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_ProposalApproved" name="Phương án hợp tác có được phê duyệt?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_ProposalApprovedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProposalApprovedNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProposalNeedRework</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_ProposalRejected" name="Phương án hợp tác không được phê duyệt">
      <bpmn:incoming>Flow_ProposalApprovedNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_Join_ContractEntry" name="Hợp nhất luồng soạn thảo hợp đồng">
      <bpmn:incoming>Flow_ProposalApprovedYes</bpmn:incoming>
      <bpmn:incoming>Flow_ContractFixLoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_PrepareContract" name="Soạn thảo và chuyển giao hợp đồng nguyên tắc">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveContract" name="Tiếp nhận và rà soát hợp đồng đã ký kết">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_DossierCompleteYes" name="Có [70%]" sourceRef="GW_DossierComplete" targetRef="Task_PreliminaryAppraisal" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_PreliminaryAppraisal" targetRef="GW_PreliminaryPass" />
    <bpmn:sequenceFlow id="Flow_PreliminaryPassNo" name="Không [15%]" sourceRef="GW_PreliminaryPass" targetRef="GW_Join_Rejection" />
    <bpmn:sequenceFlow id="Flow_PreliminaryPassYes" name="Có [85%]" sourceRef="GW_PreliminaryPass" targetRef="Task_DeepAppraisal" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_DeepAppraisal" targetRef="GW_DeepAppraisalPass" />
    <bpmn:sequenceFlow id="Flow_DeepPassNo" name="Không [20%]" sourceRef="GW_DeepAppraisalPass" targetRef="GW_Join_Rejection" />
    <bpmn:sequenceFlow id="Flow_DeepPassYes" name="Có [80%]" sourceRef="GW_DeepAppraisalPass" targetRef="Task_SelectMechanism" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SelectMechanism" targetRef="Task_NegotiateCommercial" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_NegotiateCommercial" targetRef="GW_CommercialAgreed" />
    <bpmn:sequenceFlow id="Flow_CommercialAgreedNo" name="Không [10%]" sourceRef="GW_CommercialAgreed" targetRef="GW_Join_Rejection" />
    <bpmn:sequenceFlow id="Flow_CommercialAgreedYes" name="Có [90%]" sourceRef="GW_CommercialAgreed" targetRef="GW_Join_ProposalEntry" />
    <bpmn:sequenceFlow id="Flow_ToRejectNotice" sourceRef="GW_Join_Rejection" targetRef="Task_NotifyReject" />
    <bpmn:sequenceFlow id="Flow_ToRejectEnd" sourceRef="Task_NotifyReject" targetRef="EndEvent_PartnerRejected" />
    <bpmn:sequenceFlow id="Flow_ContractValidYes" name="Có [90%]" sourceRef="GW_ContractValid" targetRef="Task_ActivateTMS" />
    <bpmn:sequenceFlow id="Flow_ToActiveEnd" sourceRef="Task_ActivateTMS" targetRef="EndEvent_PartnerActivated" />
    <bpmn:sequenceFlow id="Flow_ProposalReworkLoopBack" sourceRef="Task_ReworkProposal" targetRef="GW_Join_ProposalEntry" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="GW_Join_ProposalEntry" targetRef="Task_SubmitProposal" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SubmitProposal" targetRef="GW_ProposalApproved" />
    <bpmn:sequenceFlow id="Flow_ProposalNeedRework" name="Chỉnh sửa [15%]" sourceRef="GW_ProposalApproved" targetRef="Task_ReworkProposal" />
    <bpmn:sequenceFlow id="Flow_ContractValidNo" name="Không [10%]" sourceRef="GW_ContractValid" targetRef="Task_RequestContractFix" />
    <bpmn:sequenceFlow id="Flow_ContractFixLoopBack" sourceRef="Task_RequestContractFix" targetRef="GW_Join_ContractEntry" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_NeedVehicle" targetRef="Task_AssessInternalFleet" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AssessInternalFleet" targetRef="GW_NeedOutsource" />
    <bpmn:sequenceFlow id="Flow_InternalOk" name="Không [30%]" sourceRef="GW_NeedOutsource" targetRef="EndEvent_InternalFleetSufficient" />
    <bpmn:sequenceFlow id="Flow_NeedOutsourceYes" name="Có [70%]" sourceRef="GW_NeedOutsource" targetRef="Task_DefineStandard" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_DefineStandard" targetRef="Task_PublishInvite" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_PublishInvite" targetRef="GW_Join_DossierEntry" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_RequestSupplement" targetRef="Task_ReceiveSupplement" />
    <bpmn:sequenceFlow id="Flow_SupplementLoopBack" sourceRef="Task_ReceiveSupplement" targetRef="GW_Join_DossierEntry" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="GW_Join_DossierEntry" targetRef="Task_ReceiveDossier" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ReceiveDossier" targetRef="GW_DossierComplete" />
    <bpmn:sequenceFlow id="Flow_DossierCompleteNo" name="Không [30%]" sourceRef="GW_DossierComplete" targetRef="Task_RequestSupplement" />
    <bpmn:sequenceFlow id="Flow_ProposalApprovedNo" name="Bác bỏ [5%]" sourceRef="GW_ProposalApproved" targetRef="EndEvent_ProposalRejected" />
    <bpmn:sequenceFlow id="Flow_ProposalApprovedYes" name="Phê duyệt [80%]" sourceRef="GW_ProposalApproved" targetRef="GW_Join_ContractEntry" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="GW_Join_ContractEntry" targetRef="Task_PrepareContract" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_PrepareContract" targetRef="Task_ReceiveContract" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ReceiveContract" targetRef="GW_ContractValid" />
    <bpmn:userTask id="Task_RequestContractFix" name="Yêu cầu đối tác hoàn thiện và điều chỉnh hợp đồng">
      <bpmn:incoming>Flow_ContractValidNo</bpmn:incoming>
      <bpmn:outgoing>Flow_ContractFixLoopBack</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ContractValid" name="Hợp đồng nhận lại có hợp lệ?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_ContractValidYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ContractValidNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  
    <!-- QUANTITATIVE PROCESS ANALYSIS TEXT ANNOTATIONS (SSOT DUMAS FBPM) -->
    <bpmn:textAnnotation id="QNT_PT_A1">
      <bpmn:text>PT = 1.00h
Đánh giá năng lực nội bộ</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A2">
      <bpmn:text>PT = 1.00h
Xác định tiêu chuẩn xe</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A3">
      <bpmn:text>PT = 1.00h
Phát hành thông báo mời</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A4">
      <bpmn:text>PT = 1.00h
Tiếp nhận hồ sơ đăng ký</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A4a">
      <bpmn:text>PT = 0.15h
Yêu cầu bổ sung</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A4b">
      <bpmn:text>PT = 0.15h
Tiếp nhận bổ sung</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A5">
      <bpmn:text>PT = 1.00h
Thẩm định sơ bộ</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A6">
      <bpmn:text>PT = 6.00h
Thẩm định chuyên sâu &amp; GPS</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A7">
      <bpmn:text>PT = 1.50h
Lựa chọn cơ chế hợp tác</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A8">
      <bpmn:text>PT = 2.50h
Thương lượng giá cước &amp; SLA</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A8a">
      <bpmn:text>PT = 0.00h
Thông báo từ chối</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A9">
      <bpmn:text>PT = 2.00h
Trình phê duyệt phương án</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A9a">
      <bpmn:text>PT = 0.30h
Hoàn thiện tờ trình lại</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A10">
      <bpmn:text>PT = 1.50h
Soạn thảo hợp đồng mẫu</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A11">
      <bpmn:text>PT = 2.00h
Tiếp nhận &amp; kiểm tra HĐ ký</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A11a">
      <bpmn:text>PT = 0.10h
Yêu cầu sửa HĐ lỗi</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_PT_A12">
      <bpmn:text>PT = 0.50h
Kích hoạt đối tác trên TMS</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_WT_1">
      <bpmn:text>WT = 4.80h (30% x 16h)
Chờ đối tác nộp bổ sung</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_WT_2">
      <bpmn:text>WT = 8.00h (1 ngày)
Chờ BGD phê duyệt tờ trình</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_WT_3">
      <bpmn:text>WT = 16.00h (2 ngày)
Chờ bưu điện chuyển hợp đồng</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_GTW_G1">
      <bpmn:text>G1: Đầy đủ 70% / Thiếu 30%</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_GTW_G2">
      <bpmn:text>G2: Đạt 80% / Không 20%</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_GTW_G3">
      <bpmn:text>G3: Đạt 68.75% / Không 31.25%</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_GTW_G4">
      <bpmn:text>G4: Đồng ý 92% / Không 8%</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_GTW_G5">
      <bpmn:text>G5: Duyệt 80% / Sửa 15% / Bác 5%</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_GTW_G6">
      <bpmn:text>G6: Hợp lệ 90% / Lỗi 10%</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="QNT_Executive_Summary">
      <bpmn:text>BẢNG TỔNG HỢP ĐỊNH LƯỢNG 3 CHIỀU DUMAS FBPM (CHUẨN HÓA SSOT)
1. THỜI GIAN: PT = 22.70h | WT = 28.80h (55.92%) | CT = 51.50h (6.44 ngày công) | PCE = 44.08% | TCT = 22.00h | CRR = 57.28%
2. CHẤT LƯỢNG: FTR = 70.00% | Pass_Prelim = 80.00% | Pass_Deep = 68.75% | Yield = 55.00% | Legal_Right = 90.91% | RFPY = 35.00%
3. CHI PHÍ: C_intake = 2,169,000 VNĐ/hồ sơ | C_effective = 3,943,636 VNĐ/đối tác | Lãng phí COPQ = 1,834,136 VNĐ/đối tác
* Phương pháp: Giải tích dòng chảy Dumas Chapter 7; Đơn vị tính: Giờ (h), %, VNĐ.</bpmn:text>
    </bpmn:textAnnotation>

