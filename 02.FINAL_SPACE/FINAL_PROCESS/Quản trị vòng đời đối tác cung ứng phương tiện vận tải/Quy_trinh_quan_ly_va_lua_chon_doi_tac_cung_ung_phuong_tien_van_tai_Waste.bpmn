<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.26.0" id="Definitions_ViettelPost_PureLinear" targetNamespace="http://bpmn.io/schema/bpmn"><bpmn:message id="Message_ProposalReject" name="Thông báo từ chối / hết lượt" /><bpmn:message id="Message_Invite" name="Thư mời hợp tác" /><bpmn:message id="Message_DossierSubmit" name="Hồ sơ xe và năng lực" /><bpmn:message id="Message_NotifyReject" name="Thông báo từ chối đối tác" /><bpmn:message id="Message_SupplierScoreReject" name="Thông báo điểm đánh giá không đạt" /><bpmn:message id="Message_SendContract" name="Hợp đồng nguyên tắc" /><bpmn:message id="Message_ReturnSignedContract" name="Hợp đồng đã ký" /><bpmn:collaboration id="Collaboration_TransportOnboarding"><bpmn:participant id="Participant_Partner" name="Đơn vị cung ứng phương tiện vận tải" /><bpmn:participant id="Participant_ViettelPost" name="Tổng Công ty Cổ phần Bưu chính Viettel (Viettel Post)" processRef="Process_TransportOnboarding" /><bpmn:messageFlow id="MsgFlow_Invite" messageRef="Message_Invite" name="Thư mời hợp tác" sourceRef="Event_InviteSent" targetRef="Participant_Partner" /><bpmn:messageFlow id="MsgFlow_SubmitDossier" messageRef="Message_DossierSubmit" name="Hồ sơ xe &amp; năng lực" sourceRef="Participant_Partner" targetRef="Event_DossierReceived" /><bpmn:messageFlow id="MsgFlow_NotifyReject" messageRef="Message_NotifyReject" name="Thông báo từ chối đối tác" sourceRef="Event_NotifyRejectSent" targetRef="Participant_Partner" /><bpmn:messageFlow id="MsgFlow_SendContract" messageRef="Message_SendContract" name="Hợp đồng nguyên tắc" sourceRef="Event_ContractSent" targetRef="Participant_Partner" /><bpmn:messageFlow id="MsgFlow_ReturnSignedContract" messageRef="Message_ReturnSignedContract" name="Hợp đồng đã ký" sourceRef="Participant_Partner" targetRef="Event_SignedContractReceived" /><bpmn:messageFlow id="MsgFlow_SupplierScoreReject" messageRef="Message_SupplierScoreReject" name="Thông báo điểm đánh giá không đạt" sourceRef="Event_SupplierScoreRejectSent" targetRef="Participant_Partner" /><bpmn:messageFlow id="MsgFlow_ProposalReject" messageRef="Message_ProposalReject" name="Thông báo từ chối / hết lượt" sourceRef="Event_ProposalRejectSent" targetRef="Participant_Partner" /></bpmn:collaboration><bpmn:process id="Process_TransportOnboarding" isExecutable="true" name="Quản trị vòng đời đối tác cung ứng phương tiện vận tải V2"><bpmn:documentation>Mô hình To-Be đã tinh giản còn đúng 8 gateway. supplierScoreThreshold là tham số chính sách nội bộ đã được phê duyệt, không phải ngưỡng pháp luật. proposalRevisionAttempts là bộ đếm chỉnh sửa lại phương án, khởi tạo bằng 0 và giới hạn tối đa 3 lần chỉnh sửa.</bpmn:documentation><bpmn:laneSet id="LaneSet_ViettelPost"><bpmn:lane id="Lane_TransportOperations" name="Bộ phận Khai thác vận tải"><bpmn:flowNodeRef>StartEvent_NeedVehicle</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AssessInternalFleet</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_NeedOutsource</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_InternalFleetSufficient</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DefineStandard</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_PublishInvite</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_InviteSent</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Procurement" name="Bộ phận Quản lý đối tác / Mua sắm"><bpmn:flowNodeRef>Task_ReceiveDossier</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_DossierReceived</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ComprehensiveAppraisal</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_DossierValid</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_AppraisalPass</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EvaluateSupplierScore</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_SupplierScore</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NegotiateCommercial</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotifyScoreReject</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_SupplierScoreRejectSent</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotifyReject</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_NotifyRejectSent</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Join_Rejection</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_PartnerRejected</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_SupplierScoreRejected</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_CommercialAgreed</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ActivateTMS</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_PartnerActivated</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ManagementApprover" name="Cấp quản lý phê duyệt"><bpmn:flowNodeRef>Task_ReworkProposal</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RecordProposalRevision</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_ProposalApproved</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_Join_ProposalEntry</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SubmitProposal</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_NotifyProposalReject</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_ProposalRejectSent</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_ProposalRejected</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_LegalFinance" name="Bộ phận Pháp chế - Tài chính"><bpmn:flowNodeRef>Task_DraftContract</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SendContract</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_ContractSent</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_SignedContractReceived</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReceiveSignedContract</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReviewContract</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="StartEvent_NeedVehicle" name="Nhu cầu xe phát sinh"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_AssessInternalFleet" name="Đánh giá&#10;năng lực đội xe&#10;nội bộ"><bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing><bpmn:ioSpecification id="IOSpec_AssessFleet"><bpmn:dataInput id="DataInput_FleetAssessment" name="Hồ sơ &amp; năng lực đối tác (từ TMS)" /><bpmn:inputSet id="InputSet_AssessFleet"><bpmn:dataInputRefs>DataInput_FleetAssessment</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="OutputSet_AssessFleet" /></bpmn:ioSpecification><bpmn:dataInputAssociation id="DataInputAssoc_TMS_Read"><bpmn:sourceRef>DataStore_TMS</bpmn:sourceRef><bpmn:targetRef>DataInput_FleetAssessment</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask><bpmn:exclusiveGateway id="GW_NeedOutsource" name="Cần thuê ngoài?"><bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_NeedOutsourceYes</bpmn:outgoing><bpmn:outgoing>Flow_InternalFleetOk</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="EndEvent_InternalFleetSufficient" name="Nội bộ đáp ứng (Đóng)"><bpmn:incoming>Flow_InternalFleetOk</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_DefineStandard" name="Xác định&#10;tiêu chuẩn xe&#10;và tuyến chạy"><bpmn:incoming>Flow_NeedOutsourceYes</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_PublishInvite" name="Phát hành&#10;thông báo mời&#10;hợp tác xe"><bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_PublishInviteSent</bpmn:outgoing></bpmn:userTask><bpmn:intermediateThrowEvent id="Event_InviteSent" name="Thư mời hợp tác đã phát hành"><bpmn:incoming>Flow_PublishInviteSent</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_Invite" /></bpmn:intermediateThrowEvent><bpmn:intermediateCatchEvent id="Event_DossierReceived" name="Hồ sơ xe và năng lực đã nhận"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_DossierReceived</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_DossierSubmit" /></bpmn:intermediateCatchEvent><bpmn:userTask id="Task_ReceiveDossier" name="Kiểm tra&#10;hồ sơ đối tác"><bpmn:incoming>Flow_DossierReceived</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ComprehensiveAppraisal" name="Thẩm định&#10;thực địa xe &amp;&#10;thiết bị GPS"><bpmn:incoming>Flow_DossierValidYes</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="GW_DossierValid" name="Hồ sơ hợp lệ?"><bpmn:incoming>Flow_05</bpmn:incoming><bpmn:outgoing>Flow_DossierValidYes</bpmn:outgoing><bpmn:outgoing>Flow_DossierValidNo</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="GW_AppraisalPass" name="Thẩm định đạt?"><bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_AppraisalPassYes</bpmn:outgoing><bpmn:outgoing>Flow_AppraisalPassNo</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_EvaluateSupplierScore" name="Đánh giá&#10;điểm nhà cung ứng"><bpmn:incoming>Flow_AppraisalPassYes</bpmn:incoming><bpmn:outgoing>Flow_SupplierEvaluation</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="GW_SupplierScore" name="Đạt ngưỡng đánh giá?"><bpmn:incoming>Flow_SupplierEvaluation</bpmn:incoming><bpmn:outgoing>Flow_SupplierScorePass</bpmn:outgoing><bpmn:outgoing>Flow_SupplierScoreFail</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_NegotiateCommercial" name="Đàm phán&#10;thương mại &amp;&#10;đơn giá cước"><bpmn:incoming>Flow_SupplierScorePass</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ReworkProposal" name="Hoàn thiện phương án&#10;theo ý kiến chỉ đạo"><bpmn:incoming>Flow_ProposalNeedRework</bpmn:incoming><bpmn:outgoing>Flow_RecordProposalRevision</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_RecordProposalRevision" name="Cập nhật số lượt&#10;chỉnh sửa phương án"><bpmn:documentation>Khởi tạo proposalRevisionAttempts = 0 trước lần trình phương án đầu tiên. Sau mỗi lần hoàn thiện lại phương án, tăng proposalRevisionAttempts lên 1. Chỉ cho phép chỉnh sửa khi proposalRevisionAttempts &lt; 3; nếu không yêu cầu chỉnh sửa hoặc proposalRevisionAttempts &gt;= 3 thì đi tới nhánh từ chối/hết lượt.</bpmn:documentation><bpmn:incoming>Flow_RecordProposalRevision</bpmn:incoming><bpmn:outgoing>Flow_ProposalReworkLoopBack</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway default="Flow_ProposalApprovedNo" id="GW_ProposalApproved" name="Phê duyệt phương án?"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:outgoing>Flow_ProposalApprovedNo</bpmn:outgoing><bpmn:outgoing>Flow_ProposalNeedRework</bpmn:outgoing><bpmn:outgoing>Flow_ProposalApprovedYes</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_NotifyScoreReject" name="Gửi thông báo&#10;điểm đánh giá không đạt"><bpmn:incoming>Flow_SupplierScoreFail</bpmn:incoming><bpmn:outgoing>Flow_SupplierScoreRejectSent</bpmn:outgoing></bpmn:userTask><bpmn:intermediateThrowEvent id="Event_SupplierScoreRejectSent" name="Thông báo điểm đánh giá không đạt đã gửi"><bpmn:incoming>Flow_SupplierScoreRejectSent</bpmn:incoming><bpmn:outgoing>Flow_SupplierScoreRejectNotice</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_SupplierScoreReject" /></bpmn:intermediateThrowEvent><bpmn:userTask id="Task_NotifyReject" name="Gửi thông báo&#10;từ chối đối tác"><bpmn:incoming>Flow_ToRejectNotice</bpmn:incoming><bpmn:outgoing>Flow_NotifyRejectSent</bpmn:outgoing></bpmn:userTask><bpmn:intermediateThrowEvent id="Event_NotifyRejectSent" name="Thông báo từ chối đối tác đã gửi"><bpmn:incoming>Flow_NotifyRejectSent</bpmn:incoming><bpmn:outgoing>Flow_ToRejectEnd</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_NotifyReject" /></bpmn:intermediateThrowEvent><bpmn:exclusiveGateway id="GW_Join_Rejection" name="Hợp nhất luồng loại"><bpmn:incoming>Flow_DossierValidNo</bpmn:incoming><bpmn:incoming>Flow_AppraisalPassNo</bpmn:incoming><bpmn:incoming>Flow_CommercialAgreedNo</bpmn:incoming><bpmn:outgoing>Flow_ToRejectNotice</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="EndEvent_PartnerRejected" name="Đối tác bị loại"><bpmn:incoming>Flow_ToRejectEnd</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="EndEvent_SupplierScoreRejected" name="Đối tác không đạt&#10;ngưỡng đánh giá"><bpmn:incoming>Flow_SupplierScoreRejectNotice</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="GW_Join_ProposalEntry" name="Hợp nhất trình duyệt"><bpmn:incoming>Flow_CommercialAgreedYes</bpmn:incoming><bpmn:incoming>Flow_ProposalReworkLoopBack</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="GW_CommercialAgreed" name="Thống nhất cước?"><bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_CommercialAgreedYes</bpmn:outgoing><bpmn:outgoing>Flow_CommercialAgreedNo</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_SubmitProposal" name="Xem xét&#10;phương án"><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_NotifyProposalReject" name="Gửi thông báo&#10;từ chối / hết lượt"><bpmn:incoming>Flow_ProposalApprovedNo</bpmn:incoming><bpmn:outgoing>Flow_ProposalRejectSent</bpmn:outgoing></bpmn:userTask><bpmn:intermediateThrowEvent id="Event_ProposalRejectSent" name="Thông báo từ chối hoặc hết lượt đã gửi"><bpmn:incoming>Flow_ProposalRejectSent</bpmn:incoming><bpmn:outgoing>Flow_ProposalRejectNotice</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_ProposalReject" /></bpmn:intermediateThrowEvent><bpmn:endEvent id="EndEvent_ProposalRejected" name="Tờ trình bị từ chối&#10;/ hết lượt chỉnh sửa"><bpmn:incoming>Flow_ProposalRejectNotice</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_DraftContract" name="Soạn thảo&#10;hợp đồng&#10;nguyên tắc"><bpmn:incoming>Flow_ProposalApprovedYes</bpmn:incoming><bpmn:outgoing>Flow_11a</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_SendContract" name="Chuyển giao&#10;hợp đồng&#10;nguyên tắc"><bpmn:incoming>Flow_11a</bpmn:incoming><bpmn:outgoing>Flow_ContractSent</bpmn:outgoing></bpmn:userTask><bpmn:intermediateThrowEvent id="Event_ContractSent" name="Hợp đồng nguyên tắc đã gửi"><bpmn:incoming>Flow_ContractSent</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_SendContract" /></bpmn:intermediateThrowEvent><bpmn:intermediateCatchEvent id="Event_SignedContractReceived" name="Hợp đồng đã ký được tiếp nhận"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_SignedContractReceived</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Message_ReturnSignedContract" /></bpmn:intermediateCatchEvent><bpmn:userTask id="Task_ReceiveSignedContract" name="Lưu trữ&#10;hợp đồng đã ký"><bpmn:incoming>Flow_SignedContractReceived</bpmn:incoming><bpmn:outgoing>Flow_11b</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ReviewContract" name="Rà soát hợp đồng&#10;đã ký"><bpmn:incoming>Flow_11b</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_ActivateTMS" name="Kích hoạt đối tác&#10;trên hệ thống TMS"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_ToActiveEnd</bpmn:outgoing><bpmn:ioSpecification id="IOSpec_ActivateTMS"><bpmn:dataOutput id="DataOutput_PartnerRecord" name="Bản ghi đối tác đã kích hoạt" /><bpmn:inputSet id="InputSet_ActivateTMS" /><bpmn:outputSet id="OutputSet_ActivateTMS"><bpmn:dataOutputRefs>DataOutput_PartnerRecord</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:dataOutputAssociation id="DataOutputAssoc_TMS_Write"><bpmn:sourceRef>DataOutput_PartnerRecord</bpmn:sourceRef><bpmn:targetRef>DataStore_TMS</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:endEvent id="EndEvent_PartnerActivated" name="Đối tác kích hoạt&#10;thành công"><bpmn:incoming>Flow_ToActiveEnd</bpmn:incoming></bpmn:endEvent><bpmn:dataStoreReference id="DataStore_TMS" name="Hệ thống TMS &amp; CSDL Đối tác" /><bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_NeedVehicle" targetRef="Task_AssessInternalFleet" /><bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AssessInternalFleet" targetRef="GW_NeedOutsource" /><bpmn:sequenceFlow id="Flow_NeedOutsourceYes" name="Có [70%]" sourceRef="GW_NeedOutsource" targetRef="Task_DefineStandard"><bpmn:conditionExpression>needOutsource == true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_InternalFleetOk" name="Không [30%]" sourceRef="GW_NeedOutsource" targetRef="EndEvent_InternalFleetSufficient"><bpmn:conditionExpression>needOutsource == false</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_03" sourceRef="Task_DefineStandard" targetRef="Task_PublishInvite" /><bpmn:sequenceFlow id="Flow_PublishInviteSent" sourceRef="Task_PublishInvite" targetRef="Event_InviteSent" /><bpmn:sequenceFlow id="Flow_04" sourceRef="Event_InviteSent" targetRef="Event_DossierReceived" /><bpmn:sequenceFlow id="Flow_DossierReceived" sourceRef="Event_DossierReceived" targetRef="Task_ReceiveDossier" /><bpmn:sequenceFlow id="Flow_05" sourceRef="Task_ReceiveDossier" targetRef="GW_DossierValid" /><bpmn:sequenceFlow id="Flow_DossierValidYes" name="Hợp lệ [75%]" sourceRef="GW_DossierValid" targetRef="Task_ComprehensiveAppraisal"><bpmn:conditionExpression>dossierValid == true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ComprehensiveAppraisal" targetRef="GW_AppraisalPass" /><bpmn:sequenceFlow id="Flow_DossierValidNo" name="Không đạt [25%]" sourceRef="GW_DossierValid" targetRef="GW_Join_Rejection"><bpmn:conditionExpression>dossierValid == false</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_AppraisalPassYes" name="Đạt [85%]" sourceRef="GW_AppraisalPass" targetRef="Task_EvaluateSupplierScore"><bpmn:conditionExpression>appraisalPass == true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_AppraisalPassNo" name="Không đạt [15%]" sourceRef="GW_AppraisalPass" targetRef="GW_Join_Rejection"><bpmn:conditionExpression>appraisalPass == false</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_SupplierEvaluation" name="" sourceRef="Task_EvaluateSupplierScore" targetRef="GW_SupplierScore" /><bpmn:sequenceFlow id="Flow_SupplierScorePass" name="Đạt [80%]" sourceRef="GW_SupplierScore" targetRef="Task_NegotiateCommercial"><bpmn:conditionExpression>supplierScore &gt;= supplierScoreThreshold</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_SupplierScoreFail" name="Chưa đạt [20%]" sourceRef="GW_SupplierScore" targetRef="Task_NotifyScoreReject"><bpmn:conditionExpression>supplierScore &lt; supplierScoreThreshold</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_07" sourceRef="Task_NegotiateCommercial" targetRef="GW_CommercialAgreed" /><bpmn:sequenceFlow id="Flow_ProposalNeedRework" name="Chỉnh sửa còn lượt [15%]" sourceRef="GW_ProposalApproved" targetRef="Task_ReworkProposal"><bpmn:conditionExpression>proposalApproved == false &amp;&amp; proposalNeedsRevision == true &amp;&amp; proposalRevisionAttempts &lt; 3</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_RecordProposalRevision" name="Ghi nhận lượt chỉnh sửa" sourceRef="Task_ReworkProposal" targetRef="Task_RecordProposalRevision" /><bpmn:sequenceFlow id="Flow_ProposalReworkLoopBack" sourceRef="Task_RecordProposalRevision" targetRef="GW_Join_ProposalEntry" /><bpmn:sequenceFlow id="Flow_09" sourceRef="Task_SubmitProposal" targetRef="GW_ProposalApproved" /><bpmn:sequenceFlow id="Flow_ProposalApprovedNo" name="Từ chối / hết lượt [5%]" sourceRef="GW_ProposalApproved" targetRef="Task_NotifyProposalReject" /><bpmn:sequenceFlow id="Flow_ProposalApprovedYes" name="Phê duyệt [80%]" sourceRef="GW_ProposalApproved" targetRef="Task_DraftContract"><bpmn:conditionExpression>proposalApproved == true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_SupplierScoreRejectSent" sourceRef="Task_NotifyScoreReject" targetRef="Event_SupplierScoreRejectSent" /><bpmn:sequenceFlow id="Flow_SupplierScoreRejectNotice" name="" sourceRef="Event_SupplierScoreRejectSent" targetRef="EndEvent_SupplierScoreRejected" /><bpmn:sequenceFlow id="Flow_ProposalRejectSent" sourceRef="Task_NotifyProposalReject" targetRef="Event_ProposalRejectSent" /><bpmn:sequenceFlow id="Flow_ProposalRejectNotice" sourceRef="Event_ProposalRejectSent" targetRef="EndEvent_ProposalRejected" /><bpmn:sequenceFlow id="Flow_ToRejectNotice" sourceRef="GW_Join_Rejection" targetRef="Task_NotifyReject" /><bpmn:sequenceFlow id="Flow_NotifyRejectSent" sourceRef="Task_NotifyReject" targetRef="Event_NotifyRejectSent" /><bpmn:sequenceFlow id="Flow_ToRejectEnd" sourceRef="Event_NotifyRejectSent" targetRef="EndEvent_PartnerRejected" /><bpmn:sequenceFlow id="Flow_CommercialAgreedNo" name="Không đạt [10%]" sourceRef="GW_CommercialAgreed" targetRef="GW_Join_Rejection"><bpmn:conditionExpression>commercialAgreed == false</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_CommercialAgreedYes" name="Thống nhất [90%]" sourceRef="GW_CommercialAgreed" targetRef="GW_Join_ProposalEntry"><bpmn:conditionExpression>commercialAgreed == true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_08" sourceRef="GW_Join_ProposalEntry" targetRef="Task_SubmitProposal" /><bpmn:sequenceFlow id="Flow_ContractSent" sourceRef="Task_SendContract" targetRef="Event_ContractSent" /><bpmn:sequenceFlow id="Flow_11" sourceRef="Event_ContractSent" targetRef="Event_SignedContractReceived" /><bpmn:sequenceFlow id="Flow_11a" sourceRef="Task_DraftContract" targetRef="Task_SendContract" /><bpmn:sequenceFlow id="Flow_SignedContractReceived" sourceRef="Event_SignedContractReceived" targetRef="Task_ReceiveSignedContract" /><bpmn:sequenceFlow id="Flow_11b" sourceRef="Task_ReceiveSignedContract" targetRef="Task_ReviewContract" /><bpmn:sequenceFlow id="Flow_12" name="Kích hoạt sau khi ký hợp đồng" sourceRef="Task_ReviewContract" targetRef="Task_ActivateTMS" /><bpmn:sequenceFlow id="Flow_ToActiveEnd" sourceRef="Task_ActivateTMS" targetRef="EndEvent_PartnerActivated" /><bpmn:textAnnotation id="TextAnnotation_ProposalRevisionLimit"><bpmn:text>Giới hạn chỉnh sửa phương án:
Tối đa 3 lần chỉnh sửa lại.
Trước lần trình đầu tiên: số lượt chỉnh sửa = 0.
Sau mỗi lần chỉnh sửa: tăng số lượt lên 1.
Nếu số lượt &lt; 3: cho phép chỉnh sửa lại.
Khi số lượt = 3: chuyển đến “Từ chối / hết lượt”.</bpmn:text></bpmn:textAnnotation><bpmn:association associationDirection="None" id="Association_ProposalRevisionLimit" sourceRef="Task_RecordProposalRevision" targetRef="TextAnnotation_ProposalRevisionLimit" /><bpmn:textAnnotation id="WASTE_1"><bpmn:text>MOVE | Transportation/Motion: chuyển thông tin mời qua Message Flow</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_WASTE_1" sourceRef="Task_PublishInvite" targetRef="WASTE_1" /><bpmn:textAnnotation id="WASTE_2"><bpmn:text>HOLD | Waiting/Inventory: chờ hồ sơ đối tác; baseline As-Is</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_WASTE_2" sourceRef="Event_DossierReceived" targetRef="WASTE_2" /><bpmn:textAnnotation id="WASTE_3"><bpmn:text>HOLD | Waiting: chờ phê duyệt tờ trình; baseline As-Is</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_WASTE_3" sourceRef="Task_SubmitProposal" targetRef="WASTE_3" /><bpmn:textAnnotation id="WASTE_4"><bpmn:text>OVER-DO | Defects/Rework: chỉnh sửa phương án, tối đa 3 lần</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_WASTE_4" sourceRef="Task_ReworkProposal" targetRef="WASTE_4" /><bpmn:textAnnotation id="WASTE_5"><bpmn:text>MOVE | Transportation: chuyển giao hợp đồng bằng Message Flow</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_WASTE_5" sourceRef="Task_SendContract" targetRef="WASTE_5" /><bpmn:textAnnotation id="WASTE_6"><bpmn:text>HOLD | Waiting: chờ đối tác ký và gửi lại; baseline As-Is</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_WASTE_6" sourceRef="Task_ReceiveSignedContract" targetRef="WASTE_6" /><bpmn:textAnnotation id="WASTE_SevenTypes"><bpmn:text>7 wastes: Transport + Motion = Move; Inventory + Waiting = Hold; Overproduction + Overprocessing + Defects = Over-Do. Không có loop hồ sơ/hợp đồng trong V2.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_WASTE_SevenTypes" sourceRef="Task_ReworkProposal" targetRef="WASTE_SevenTypes" /></bpmn:process><bpmndi:BPMNDiagram id="BPMNDiagram_TransportOnboarding_PureLinear"><bpmndi:BPMNPlane bpmnElement="Collaboration_TransportOnboarding" id="BPMNPlane_TransportOnboarding_PureLinear"><bpmndi:BPMNShape bpmnElement="Participant_ViettelPost" id="Participant_ViettelPost_di" isHorizontal="true"><dc:Bounds height="1045" width="2770" x="160" y="215" /></bpmndi:BPMNShape><bpmndi:BPMNShape bpmnElement="Lane_TransportOperations" id="Lane_TransportOperations_di" isHorizontal="true"><dc:Bounds height="240" width="2740" x="190" y="215" /></bpmndi:BPMNShape><bpmndi:BPMNShape bpmnElement="Lane_Procurement" id="Lane_Procurement_di" isHorizontal="true"><dc:Bounds height="435" width="2740" x="190" y="455" /></bpmndi:BPMNShape><bpmndi:BPMNShape bpmnElement="Lane_ManagementApprover" id="Lane_ManagementApprover_di" isHorizontal="true"><dc:Bounds height="250" width="2740" x="190" y="890" /></bpmndi:BPMNShape><bpmndi:BPMNShape bpmnElement="Lane_LegalFinance" id="Lane_LegalFinance_di" isHorizontal="true"><dc:Bounds height="120" width="2740" x="190" y="1140" /></bpmndi:BPMNShape><bpmndi:BPMNShape bpmnElement="StartEvent_NeedVehicle" id="StartEvent_NeedVehicle_di"><dc:Bounds height="36" width="36" x="238" y="296" /><bpmndi:BPMNLabel><dc:Bounds x="216" y="332" width="81" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape bpmnElement="Task_AssessInternalFleet" id="Task_AssessInternalFleet_di"><dc:Bounds height="68" width="140" x="305" y="280" /><bpmndi:BPMNLabel labelStyle="LabelStyle_14"><dc:Bounds x="312" y="287" width="126" height="54" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape bpmnElement="GW_NeedOutsource" id="GW_NeedOutsource_di" isMarkerVisible="true"><dc:Bounds height="44" width="44" x="480" y="292" /><bpmndi:BPMNLabel labelStyle="LabelStyle_14"><dc:Bounds x="459" y="268" width="81" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape bpmnElement="EndEvent_InternalFleetSufficient" id="En