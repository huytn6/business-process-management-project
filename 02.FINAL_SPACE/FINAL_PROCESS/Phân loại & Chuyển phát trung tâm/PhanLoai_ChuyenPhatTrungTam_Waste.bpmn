<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PhanLoaiChuyenPhatTrungTam" targetNamespace="http://viettelpost.example/bpmn/phanloai-chuyenphat-trungtam" exporter="OpenAI Codex" exporterVersion="professional-layout-2.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_FEE" name="Bưu cục / Điểm tập kết &amp; xe feeder" processRef="Process_FEE"/>
    <bpmn:participant id="Participant_HUB" name="Trung tâm khai thác Viettel Post" processRef="Process_HUB"/>
    <bpmn:participant id="Participant_CAR" name="Đội vận tải liên tỉnh" processRef="Process_CAR"/>
    <bpmn:messageFlow id="MsgFlow_F2B_IN1" name="Manifest bàn giao" sourceRef="F2B" targetRef="IN1"/>
    <bpmn:messageFlow id="MsgFlow_OT6_C1" name="Thông báo bàn giao" sourceRef="OT6" targetRef="C1"/>
    <bpmn:messageFlow id="MsgFlow_C2D_OW1" name="Xác nhận ký nhận" sourceRef="C2D" targetRef="OW1"/>
    </bpmn:collaboration>
  <bpmn:dataStore id="DataStore_WMS_TMS" name="Hệ thống WMS/TMS"/>
  <bpmn:process id="Process_FEE" isExecutable="false">
    <bpmn:startEvent id="F1" name="Xe feeder đã đến hub">
      <bpmn:outgoing>Flow_F1_F2A</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="F2A" name="Bàn giao bưu gửi">
      <bpmn:incoming>Flow_F1_F2A</bpmn:incoming>
      <bpmn:outgoing>Flow_F2A_F2B</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="F2B" name="Gửi manifest bàn giao">
      <bpmn:incoming>Flow_F2A_F2B</bpmn:incoming>
      <bpmn:outgoing>Flow_F2B_F3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="F3" name="Bưu gửi đã được bàn giao">
      <bpmn:incoming>Flow_F2B_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_F1_F2A" name="Đã đến hub" sourceRef="F1" targetRef="F2A"/>
    <bpmn:sequenceFlow id="Flow_F2A_F2B" name="Đã bàn giao vật lý" sourceRef="F2A" targetRef="F2B"/>
    <bpmn:sequenceFlow id="Flow_F2B_F3" name="Đã gửi manifest" sourceRef="F2B" targetRef="F3"/>
  </bpmn:process>
  <bpmn:process id="Process_HUB" isExecutable="false">
    <bpmn:laneSet id="LaneSet_HUB">
      <bpmn:lane id="Lane_IN" name="Inbound &amp; Kiểm soát bàn giao">
        <bpmn:flowNodeRef>IN1</bpmn:flowNodeRef><bpmn:flowNodeRef>IN2</bpmn:flowNodeRef><bpmn:flowNodeRef>GW1</bpmn:flowNodeRef><bpmn:flowNodeRef>GWJ1</bpmn:flowNodeRef><bpmn:flowNodeRef>IN3</bpmn:flowNodeRef><bpmn:flowNodeRef>GW2</bpmn:flowNodeRef><bpmn:flowNodeRef>IN4</bpmn:flowNodeRef><bpmn:flowNodeRef>IN5</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_DWS" name="DWS &amp; Hệ thống chia chọn">
        <bpmn:flowNodeRef>DT0</bpmn:flowNodeRef><bpmn:flowNodeRef>DT1</bpmn:flowNodeRef><bpmn:flowNodeRef>GW3</bpmn:flowNodeRef><bpmn:flowNodeRef>GW4</bpmn:flowNodeRef><bpmn:flowNodeRef>GWJ2</bpmn:flowNodeRef><bpmn:flowNodeRef>DT2</bpmn:flowNodeRef><bpmn:flowNodeRef>GW5</bpmn:flowNodeRef><bpmn:flowNodeRef>DT3</bpmn:flowNodeRef><bpmn:flowNodeRef>DT4</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_EXC" name="Khai thác ngoại lệ / An ninh">
        <bpmn:flowNodeRef>EX1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EX2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OUT" name="Outbound &amp; Điều vận">
        <bpmn:flowNodeRef>OJ1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB_STAGE</bpmn:flowNodeRef><bpmn:flowNodeRef>OT2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB_RECON</bpmn:flowNodeRef><bpmn:flowNodeRef>OT6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OW1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OE1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataStoreReference id="DS1" name="Hệ thống WMS/TMS" dataStoreRef="DataStore_WMS_TMS"/>
    <bpmn:dataStoreReference id="DS2" name="Hệ thống WMS/TMS" dataStoreRef="DataStore_WMS_TMS"/>
    <bpmn:startEvent id="IN1" name="Manifest đã được bàn giao">
      <bpmn:outgoing>Flow_IN1_IN2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_IN1"/>
    </bpmn:startEvent>
    <bpmn:userTask id="IN2" name="Kiểm tra bàn giao &amp; niêm phong">
      <bpmn:incoming>Flow_IN1_IN2</bpmn:incoming>
      <bpmn:outgoing>Flow_IN2_GW1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW1" name="Bàn giao khớp?" default="Flow_GW1_GWJ1">
      <bpmn:incoming>Flow_IN2_GW1</bpmn:incoming>
      <bpmn:outgoing>Flow_GW1_GWJ1</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW1_EX1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IN5" name="Ghi trạng thái đến hub vào WMS">
      <bpmn:incoming>Flow_GW2_IN5</bpmn:incoming><bpmn:outgoing>Flow_IN5_DT0</bpmn:outgoing>
      <bpmn:property id="Property_IN5_StatusArrived" name="Trạng thái đến hub"/>
      <bpmn:dataOutputAssociation id="DataOut_IN5_DS1">
        <bpmn:documentation>Ghi "Trạng thái đến hub" vào WMS/TMS.</bpmn:documentation>
        <bpmn:sourceRef>Property_IN5_StatusArrived</bpmn:sourceRef>
        <bpmn:targetRef>DS1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="DT0" name="Đọc dữ liệu khai báo từ WMS">
      <bpmn:incoming>Flow_IN5_DT0</bpmn:incoming>
      <bpmn:outgoing>Flow_DT0_DT1</bpmn:outgoing>
      <bpmn:property id="Property_DT0_DeclarationData" name="Dữ liệu khai báo"/>
      <bpmn:dataInputAssociation id="DataIn_DS1_DT0">
        <bpmn:documentation>Đọc "Dữ liệu khai báo" (đã tồn tại từ trước, ngoài phạm vi quy trình này) từ WMS/TMS.</bpmn:documentation>
        <bpmn:sourceRef>DS1</bpmn:sourceRef>
        <bpmn:targetRef>Property_DT0_DeclarationData</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:subProcess id="DT1" name="Kiểm tra bưu gửi bằng DWS">
      <bpmn:incoming>Flow_DT0_DT1</bpmn:incoming>
      <bpmn:outgoing>Flow_DT1_GW3</bpmn:outgoing>
      <bpmn:startEvent id="DT1_S" name="Bưu gửi đã đến DWS">
        <bpmn:outgoing>Flow_DT1S_DT1a</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="DT1a" name="Quét mã tại DWS">
        <bpmn:incoming>Flow_DT1S_DT1a</bpmn:incoming>
        <bpmn:outgoing>Flow_DT1a_DT1b</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="DT1b" name="Cân đo kích thước">
        <bpmn:incoming>Flow_DT1a_DT1b</bpmn:incoming>
        <bpmn:outgoing>Flow_DT1b_DT1c</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="DT1c" name="Đối chiếu khai báo">
        <bpmn:incoming>Flow_DT1b_DT1c</bpmn:incoming>
        <bpmn:outgoing>Flow_DT1c_DT1d</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="DT1d" name="Soi chiếu &amp; kiểm tra bao bì">
        <bpmn:incoming>Flow_DT1c_DT1d</bpmn:incoming>
        <bpmn:outgoing>Flow_DT1d_DT1E</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="DT1_E" name="Bưu gửi đã được kiểm tra DWS">
        <bpmn:incoming>Flow_DT1d_DT1E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_DT1S_DT1a" name="Bắt đầu" sourceRef="DT1_S" targetRef="DT1a"/>
      <bpmn:sequenceFlow id="Flow_DT1a_DT1b" name="Đã quét" sourceRef="DT1a" targetRef="DT1b"/>
      <bpmn:sequenceFlow id="Flow_DT1b_DT1c" name="Đã cân đo" sourceRef="DT1b" targetRef="DT1c"/>
      <bpmn:sequenceFlow id="Flow_DT1c_DT1d" name="Đã đối chiếu" sourceRef="DT1c" targetRef="DT1d"/>
      <bpmn:sequenceFlow id="Flow_DT1d_DT1E" name="Đã soi chiếu" sourceRef="DT1d" targetRef="DT1_E"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="GW3" name="Hàng cấm / nguy hiểm?" default="Flow_GW3_GW4">
      <bpmn:incoming>Flow_DT1_GW3</bpmn:incoming>
      <bpmn:outgoing>Flow_GW3_GW4</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW3_EX2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW4" name="Hàng đặc biệt được phép?" default="Flow_GW4_GWJ2">
      <bpmn:incoming>Flow_GW3_GW4</bpmn:incoming>
      <bpmn:outgoing>Flow_GW4_GWJ2</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW4_DT3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DT3" name="Phân loại và xác nhận đúng tuyến thủ công (hàng đặc biệt)">
      <bpmn:incoming>Flow_GW4_DT3</bpmn:incoming>
      <bpmn:outgoing>Flow_DT3_OJ1</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="EX1" name="Cách ly &amp; lập biên bản sai lệch">
      <bpmn:incoming>Flow_GW1_EX1</bpmn:incoming>
      <bpmn:outgoing>Flow_EX1_EE1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE1" name="Lô hàng đã bị cách ly do sai lệch">
      <bpmn:incoming>Flow_EX1_EE1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="EX2" name="Cách ly &amp; lập biên bản hàng cấm/nguy hiểm">
      <bpmn:incoming>Flow_GW3_EX2</bpmn:incoming>
      <bpmn:outgoing>Flow_EX2_EE2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE2" name="Hàng cấm/nguy hiểm đã được cách ly">
      <bpmn:incoming>Flow_EX2_EE2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="OJ1" name="Hợp nhất luồng phân loại">
      <bpmn:incoming>Flow_DT3_OJ1</bpmn:incoming>
      <bpmn:incoming>Flow_GW5_OJ1</bpmn:incoming><bpmn:outgoing>Flow_OJ1_OT1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SUB_STAGE" name="Tập kết theo tuyến"><bpmn:incoming>Flow_OJ1_OT1</bpmn:incoming><bpmn:outgoing>Flow_SUBSTAGE_OT2</bpmn:outgoing><bpmn:startEvent id="STAGE_S" name="Lô hàng đã sẵn sàng tập kết"><bpmn:outgoing>Flow_STAGES_OT1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="OT1" name="Tập kết &amp; đối chiếu kế hoạch xuất tuyến">
      <bpmn:incoming>Flow_STAGES_OT1</bpmn:incoming><bpmn:outgoing>Flow_OT1_GWJ3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_OT1_GWJ3" name="Tập kết" sourceRef="OT1" targetRef="STAGE_JOIN"/>
    <bpmn:exclusiveGateway id="STAGE_JOIN" name="Hợp nhất luồng xuất tuyến"><bpmn:incoming>Flow_OT1_GWJ3</bpmn:incoming><bpmn:incoming>Flow_TM1_GWJ3</bpmn:incoming><bpmn:outgoing>Flow_GWJ3_OTPLAN</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="OT_READPLAN" name="Đọc kế hoạch chuyến kế tiếp từ TMS">
      <bpmn:incoming>Flow_GWJ3_OTPLAN</bpmn:incoming>
      <bpmn:outgoing>Flow_OTPLAN_GW6</bpmn:outgoing>
      <bpmn:property id="Property_OTPLAN_TripPlanInput" name="Kế hoạch chuyến kế tiếp"/>
      <bpmn:dataInputAssociation id="DataIn_DS2_OTPLAN">
        <bpmn:documentation>Đọc property "Kế hoạch chuyến kế tiếp" (kế hoạch line-haul do bộ phận điều vận/TMS lập từ trước, ngoài phạm vi quy trình này – tương tự cách DT0 đọc "Dữ liệu khai báo") từ WMS/TMS – KHÔNG đọc property "Manifest lô hàng" (do OT5A ghi) cũng đang lưu trên cùng Data Store.</bpmn:documentation>
        <bpmn:sourceRef>DS2</bpmn:sourceRef>
        <bpmn:targetRef>Property_OTPLAN_TripPlanInput</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_OTPLAN_GW6" name="Đã đọc kế hoạch" sourceRef="OT_READPLAN" targetRef="GW6"/>
    <bpmn:exclusiveGateway id="GW6" name="Đủ điều kiện xuất tuyến?" default="Flow_GW6_OT2">
      <bpmn:incoming>Flow_OTPLAN_GW6</bpmn:incoming>
      <bpmn:outgoing>Flow_GW6_OT2</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW6_TM1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="TM1" name="Thời gian chờ đã kết thúc (~20 phút)">
      <bpmn:incoming>Flow_GW6_TM1</bpmn:incoming>
      <bpmn:outgoing>Flow_TM1_GWJ3</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDef_TM1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="STAGE_E" name="Lô hàng đủ điều kiện xuất tuyến"><bpmn:incoming>Flow_GW6_OT2</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_STAGES_OT1" sourceRef="STAGE_S" targetRef="OT1" name="Bắt đầu"/><bpmn:sequenceFlow id="Flow_GWJ3_OTPLAN" name="Sẵn sàng" sourceRef="STAGE_JOIN" targetRef="OT_READPLAN"/>
    <bpmn:sequenceFlow id="Flow_GW6_OT2" name="Đủ (80%*)" sourceRef="GW6" targetRef="STAGE_E"/>
    <bpmn:sequenceFlow id="Flow_GW6_TM1" name="Chưa đủ (20%*)" sourceRef="GW6" targetRef="TM1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${duDieuKienXuatTuyen == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TM1_GWJ3" sourceRef="TM1" targetRef="STAGE_JOIN" name="Đến giờ kiểm tra lại"/></bpmn:subProcess><bpmn:subProcess id="OT2" name="Đóng bao/container">
      <bpmn:incoming>Flow_SUBSTAGE_OT2</bpmn:incoming><bpmn:outgoing>Flow_OT2_OJ2</bpmn:outgoing>
      <bpmn:startEvent id="OT2_S" name="Lô hàng đã đủ điều kiện đóng bao">
        <bpmn:outgoing>Flow_OT2S_OT2a</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="OT2a" name="Tạo mã bao/container">
        <bpmn:incoming>Flow_OT2S_OT2a</bpmn:incoming>
        <bpmn:outgoing>Flow_OT2a_OT2b</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="OT2b" name="Quét liên kết kiện vào bao/container">
        <bpmn:incoming>Flow_OT2a_OT2b</bpmn:incoming>
        <bpmn:outgoing>Flow_OT2b_OT2c</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="OT2c" name="Kiểm tra số lượng &amp; khối lượng">
        <bpmn:incoming>Flow_OT2b_OT2c</bpmn:incoming>
        <bpmn:outgoing>Flow_OT2c_OT2d</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="OT2d" name="Ghi số seal">
        <bpmn:incoming>Flow_OT2c_OT2d</bpmn:incoming>
        <bpmn:outgoing>Flow_OT2d_OT2e</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:manualTask id="OT2e" name="Niêm phong bao/container">
        <bpmn:incoming>Flow_OT2d_OT2e</bpmn:incoming>
        <bpmn:outgoing>Flow_OT2e_OT2E</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:endEvent id="OT2_E" name="Bao/container đã được niêm phong">
        <bpmn:incoming>Flow_OT2e_OT2E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_OT2S_OT2a" name="Bắt đầu" sourceRef="OT2_S" targetRef="OT2a"/>
      <bpmn:sequenceFlow id="Flow_OT2a_OT2b" name="Đã tạo mã" sourceRef="OT2a" targetRef="OT2b"/>
      <bpmn:sequenceFlow id="Flow_OT2b_OT2c" name="Đã liên kết" sourceRef="OT2b" targetRef="OT2c"/>
      <bpmn:sequenceFlow id="Flow_OT2c_OT2d" name="Đã kiểm tra" sourceRef="OT2c" targetRef="OT2d"/>
      <bpmn:sequenceFlow id="Flow_OT2d_OT2e" name="Đã ghi seal" sourceRef="OT2d" targetRef="OT2e"/>
      <bpmn:sequenceFlow id="Flow_OT2e_OT2E" name="Đã niêm phong" sourceRef="OT2e" targetRef="OT2_E"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SUB_RECON" name="Đối soát &amp; đóng manifest"><bpmn:incoming>Flow_OT2_OJ2</bpmn:incoming><bpmn:outgoing>Flow_SUBRECON_OT6</bpmn:outgoing><bpmn:startEvent id="RECON_S" name="Bao/container đã đóng xong"><bpmn:outgoing>Flow_RECONS_JOIN</bpmn:outgoing></bpmn:startEvent><bpmn:exclusiveGateway id="RECON_JOIN" name="Hợp nhất luồng đối soát"><bpmn:incoming>Flow_RECONS_JOIN</bpmn:incoming><bpmn:incoming>Flow_OT4_OJ2</bpmn:incoming><bpmn:outgoing>Flow_OJ2_OT3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="OT3" name="Đối soát số liệu bao/container">
      <bpmn:incoming>Flow_OJ2_OT3</bpmn:incoming>
      <bpmn:outgoing>Flow_OT3_GW7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW7" name="Đối soát khớp?" default="Flow_GW7_OT5">
      <bpmn:incoming>Flow_OT3_GW7</bpmn:incoming>
      <bpmn:outgoing>Flow_GW7_OT5</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW7_OT4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="OT4" name="Mở kiểm tra &amp; đối soát lại">
      <bpmn:incoming>Flow_GW7_OT4</bpmn:incoming>
      <bpmn:outgoing>Flow_OT4_OJ2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="OT5" name="Đóng manifest lô hàng">
      <bpmn:incoming>Flow_GW7_OT5</bpmn:incoming>
      <bpmn:outgoing>Flow_OT5_OT5A</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="OT5A" name="Ghi manifest vào WMS/TMS">
      <bpmn:incoming>Flow_OT5_OT5A</bpmn:incoming>
      <bpmn:outgoing>Flow_OT5A_OT6</bpmn:outgoing>
      <bpmn:property id="Property_OT5A_ManifestOutput" name="Manifest lô hàng"/>
      <bpmn:dataOutputAssociation id="DataOut_OT5A_DS2">
        <bpmn:documentation>Ghi property "Manifest lô hàng" vào WMS/TMS; đội vận tải đọc lại qua DS3 tại bước C2G.</bpmn:documentation>
        <bpmn:sourceRef>Property_OT5A_ManifestOutput</bpmn:sourceRef>
        <bpmn:targetRef>DS2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_OT3_GW7" name="Hoàn tất" sourceRef="OT3" targetRef="GW7"/>
    <bpmn:sequenceFlow id="Flow_OT5_OT5A" name="Đã đóng manifest" sourceRef="OT5" targetRef="OT5A"/>
    <bpmn:endEvent id="RECON_E" name="Manifest đã được đóng"><bpmn:incoming>Flow_OT5A_OT6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_RECONS_JOIN" sourceRef="RECON_S" targetRef="RECON_JOIN" name="Bắt đầu"/><bpmn:sequenceFlow id="Flow_OJ2_OT3" name="Sẵn sàng" sourceRef="RECON_JOIN" targetRef="OT3"/>
    <bpmn:sequenceFlow id="Flow_GW7_OT5" name="Khớp (97%)" sourceRef="GW7" targetRef="OT5"/>
    <bpmn:sequenceFlow id="Flow_GW7_OT4" name="Chưa khớp (3%)" sourceRef="GW7" targetRef="OT4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${doiSoatKhop == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OT5A_OT6" name="Đã ghi manifest" sourceRef="OT5A" targetRef="RECON_E"/>
    <bpmn:sequenceFlow id="Flow_OT4_OJ2" name="Đối soát lại" sourceRef="OT4" targetRef="RECON_JOIN"/>
    </bpmn:subProcess><bpmn:sendTask id="OT6" name="Thông báo sẵn sàng bàn giao lô hàng">
      <bpmn:incoming>Flow_SUBRECON_OT6</bpmn:incoming><bpmn:outgoing>Flow_OT6_OW1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="OW1" name="Xác nhận bàn giao đã được tiếp nhận">
      <bpmn:incoming>Flow_OT6_OW1</bpmn:incoming>
      <bpmn:outgoing>Flow_OW1_OE1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_OW1"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="OE1" name="Bưu gửi đã được bàn giao thành công">
      <bpmn:incoming>Flow_OW1_OE1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_IN1_IN2" name="Bắt đầu" sourceRef="IN1" targetRef="IN2"/>
    <bpmn:sequenceFlow id="Flow_IN2_GW1" name="Hoàn tất" sourceRef="IN2" targetRef="GW1"/>
    <bpmn:sequenceFlow id="Flow_GW1_GWJ1" name="Khớp (99%)" sourceRef="GW1" targetRef="GWJ1"/>
    <bpmn:sequenceFlow id="Flow_GW1_EX1" name="Không khớp (1%)" sourceRef="GW1" targetRef="EX1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${banGiaoKhop == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EX1_EE1" name="Cách ly" sourceRef="EX1" targetRef="EE1"/>
    <bpmn:sequenceFlow id="Flow_IN5_DT0" name="Đã ghi trạng thái" sourceRef="IN5" targetRef="DT0"/>
    <bpmn:sequenceFlow id="Flow_DT0_DT1" name="Đã đọc dữ liệu" sourceRef="DT0" targetRef="DT1"/>
    <bpmn:sequenceFlow id="Flow_DT1_GW3" name="Đã kiểm tra" sourceRef="DT1" targetRef="GW3"/>
    <bpmn:sequenceFlow id="Flow_GW3_GW4" name="Không (99%)" sourceRef="GW3" targetRef="GW4"/>
    <bpmn:sequenceFlow id="Flow_GW3_EX2" name="Có (1%)" sourceRef="GW3" targetRef="EX2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hangCamNguyHiem == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EX2_EE2" name="Cách ly" sourceRef="EX2" targetRef="EE2"/>
    <bpmn:sequenceFlow id="Flow_GW4_GWJ2" name="Không (95,96%)" sourceRef="GW4" targetRef="GWJ2"/>
    <bpmn:sequenceFlow id="Flow_GW4_DT3" name="Có (4,04%)" sourceRef="GW4" targetRef="DT3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hangDacBietDuocPhep == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DT3_OJ1" name="Đã xác nhận đúng tuyến" sourceRef="DT3" targetRef="OJ1"/>
    <bpmn:sequenceFlow id="Flow_OJ1_OT1" name="Hợp lệ" sourceRef="OJ1" targetRef="SUB_STAGE"/>
    <bpmn:sequenceFlow id="Flow_OT2_OJ2" name="Đã đóng bao" sourceRef="OT2" targetRef="SUB_RECON"/>
    <bpmn:sequenceFlow id="Flow_OT6_OW1" name="Đã gửi" sourceRef="OT6" targetRef="OW1"/>
    <bpmn:sequenceFlow id="Flow_OW1_OE1" name="Đã xác nhận" sourceRef="OW1" targetRef="OE1"/>
    <bpmn:sequenceFlow id="Flow_SUBSTAGE_OT2" sourceRef="SUB_STAGE" targetRef="OT2" name="Đủ điều kiện"/><bpmn:sequenceFlow id="Flow_SUBRECON_OT6" sourceRef="SUB_RECON" targetRef="OT6" name="Manifest sẵn sàng"/><bpmn:userTask id="IN3" name="Quét mã vận đơn">
      <bpmn:incoming>Flow_GWJ1_IN3</bpmn:incoming>
      <bpmn:outgoing>Flow_IN3_GW2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW2" name="Mã đọc được?" default="Flow_GW2_IN5">
      <bpmn:incoming>Flow_IN3_GW2</bpmn:incoming>
      <bpmn:outgoing>Flow_GW2_IN5</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW2_IN4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="IN4" name="Nhận dạng &amp; dán lại nhãn">
      <bpmn:incoming>Flow_GW2_IN4</bpmn:incoming>
      <bpmn:outgoing>Flow_IN4_GWJ1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GWJ1" name="Hợp nhất luồng đọc mã"><bpmn:incoming>Flow_IN4_GWJ1</bpmn:incoming><bpmn:incoming>Flow_GW1_GWJ1</bpmn:incoming><bpmn:outgoing>Flow_GWJ1_IN3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="Flow_GWJ1_IN3" name="Sẵn sàng" sourceRef="GWJ1" targetRef="IN3"/>
    <bpmn:sequenceFlow id="Flow_IN3_GW2" name="Đã quét" sourceRef="IN3" targetRef="GW2"/>
    <bpmn:sequenceFlow id="Flow_GW2_IN5" name="Đọc được (98%)" sourceRef="GW2" targetRef="IN5"/>
    <bpmn:sequenceFlow id="Flow_GW2_IN4" name="Lỗi đọc (2%)" sourceRef="GW2" targetRef="IN4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${maDocDuoc == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IN4_GWJ1" name="Đã dán nhãn" sourceRef="IN4" targetRef="GWJ1"/>
    <bpmn:serviceTask id="DT2" name="Chia chọn tự động theo tuyến (AGV/Sorter)">
      <bpmn:incoming>Flow_GWJ2_DT2</bpmn:incoming>
      <bpmn:outgoing>Flow_DT2_GW5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW5" name="Kết quả chia chọn hợp lệ?" default="Flow_GW5_OJ1">
      <bpmn:incoming>Flow_DT2_GW5</bpmn:incoming>
      <bpmn:outgoing>Flow_GW5_OJ1</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW5_DT4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DT4" name="Xử lý ngoại lệ chia chọn (nhận dạng lại, điều hướng lại hoặc khắc phục lỗi thiết bị)">
      <bpmn:incoming>Flow_GW5_DT4</bpmn:incoming>
      <bpmn:outgoing>Flow_DT4_GWJ2</bpmn:outgoing>
      </bpmn:userTask>
    <bpmn:exclusiveGateway id="GWJ2" name="Hợp nhất luồng chia chọn"><bpmn:incoming>Flow_DT4_GWJ2</bpmn:incoming><bpmn:incoming>Flow_GW4_GWJ2</bpmn:incoming><bpmn:outgoing>Flow_GWJ2_DT2</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="Flow_GWJ2_DT2" name="Sẵn sàng" sourceRef="GWJ2" targetRef="DT2"/>
    <bpmn:sequenceFlow id="Flow_DT2_GW5" name="Đã chia chọn" sourceRef="DT2" targetRef="GW5"/>
    <bpmn:sequenceFlow id="Flow_GW5_OJ1" name="Hợp lệ (97%)" sourceRef="GW5" targetRef="OJ1"/>
    <bpmn:sequenceFlow id="Flow_GW5_DT4" name="Không hợp lệ (3%)" sourceRef="GW5" targetRef="DT4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ketQuaChiaChonHopLe == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DT4_GWJ2" name="Đã xử lý" sourceRef="DT4" targetRef="GWJ2"/>
        <bpmn:textAnnotation id="Waste_Move_Transport">
      <bpmn:text>MOVE - Transportation
Trung chuyển nội bộ do bố trí mặt bằng chưa tối ưu (~10-15%)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_Move_Movement">
      <bpmn:text>MOVE - Movement
Di chuyển kiện nhiều lần: Inbound→DWS→Ngoại lệ→Đóng bao</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_Hold_Waiting">
      <bpmn:text>HOLD - Waiting
WT≈20p trên CT≈25,0p (~79,9%); PCE chỉ ≈6,11%</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_Hold_Inventory">
      <bpmn:text>HOLD - Inventory
Tồn tại vùng staging chưa đủ điều kiện xuất tuyến</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_OverDo_Defect_NoRead">
      <bpmn:text>OVER-DO - Defects
Mã không đọc được, phải dán lại nhãn (~2,0%/ngày)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_OverDo_Defect_Recon">
      <bpmn:text>OVER-DO - Defects
Đối soát lại do thiếu kiện/sai seal (~3,0%/ngày)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_OverDo_Overprocess">
      <bpmn:text>OVER-DO - Overprocessing
Đối chiếu khai báo lặp lại (WMS &amp; DWS)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_OverDo_Talent">
      <bpmn:text>OVER-DO - Underused talent
Xử lý lỗi thủ công lặp lại, có thể tự động hoá</bpmn:text>
    </bpmn:textAnnotation>
</bpmn:process>
  <bpmn:process id="Process_CAR" isExecutable="false">
    <bpmn:dataStoreReference id="DS3" name="Hệ thống WMS/TMS" dataStoreRef="DataStore_WMS_TMS"/>
    <bpmn:startEvent id="C1" name="Thông báo bàn giao đã được tiếp nhận">
      <bpmn:outgoing>Flow_C1_C2A</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_C1"/>
    </bpmn:startEvent>
    <bpmn:manualTask id="C2A" name="Xếp lô hàng lên phương tiện">
      <bpmn:incoming>Flow_C1_C2A</bpmn:incoming>
      <bpmn:outgoing>Flow_C2A_C2G</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="C2G" name="Đọc manifest bàn giao từ WMS/TMS">
      <bpmn:incoming>Flow_C2A_C2G</bpmn:incoming>
      <bpmn:outgoing>Flow_C2G_C2B</bpmn:outgoing>
      <bpmn:property id="Property_C2G_ManifestInput" name="Manifest bàn giao"/>
      <bpmn:dataInputAssociation id="DataIn_DS3_C2G">
        <bpmn:documentation>Đọc property "Manifest lô hàng" mà OT5A đã ghi (tham chiếu chung Data Store WMS/TMS, phía HUB gọi là DS2, phía đội vận tải gọi là DS3).</bpmn:documentation>
        <bpmn:sourceRef>DS3</bpmn:sourceRef>
        <bpmn:targetRef>Property_C2G_ManifestInput</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="C2B" name="Đối chiếu lô hàng lần cuối">
      <bpmn:incoming>Flow_C2G_C2B</bpmn:incoming>
      <bpmn:outgoing>Flow_C2B_C2C</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="C2C" name="Ký nhận bàn giao">
      <bpmn:incoming>Flow_C2B_C2C</bpmn:incoming>
      <bpmn:outgoing>Flow_C2C_C2E</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="C2E" name="Cập nhật trạng thái rời hub">
      <bpmn:incoming>Flow_C2C_C2E</bpmn:incoming>
      <bpmn:outgoing>Flow_C2E_C2EW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="C2EW" name="Ghi trạng thái rời hub vào WMS/TMS">
      <bpmn:incoming>Flow_C2E_C2EW</bpmn:incoming>
      <bpmn:outgoing>Flow_C2E_C2D</bpmn:outgoing>
      <bpmn:property id="Property_C2E_DepartureStatusOutput" name="Trạng thái rời hub"/>
      <bpmn:dataOutputAssociation id="DataOut_C2E_DS3">
        <bpmn:documentation>Ghi property "Trạng thái rời hub" vào WMS/TMS sau khi ký nhận bàn giao.</bpmn:documentation>
        <bpmn:sourceRef>Property_C2E_DepartureStatusOutput</bpmn:sourceRef>
        <bpmn:targetRef>DS3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="C2D" name="Gửi xác nhận ký nhận">
      <bpmn:incoming>Flow_C2E_C2D</bpmn:incoming>
      <bpmn:outgoing>Flow_C2D_C3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="C3" name="Lô hàng đã rời hub thành công">
      <bpmn:incoming>Flow_C2D_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1_C2A" name="Đã nhận" sourceRef="C1" targetRef="C2A"/>
    <bpmn:sequenceFlow id="Flow_C2A_C2G" name="Đã xếp hàng" sourceRef="C2A" targetRef="C2G"/>
    <bpmn:sequenceFlow id="Flow_C2G_C2B" name="Đã đọc manifest" sourceRef="C2G" targetRef="C2B"/>
    <bpmn:sequenceFlow id="Flow_C2B_C2C" name="Đã đối chiếu" sourceRef="C2B" targetRef="C2C"/>
    <bpmn:sequenceFlow id="Flow_C2C_C2E" name="Đã ký nhận" sourceRef="C2C" targetRef="C2E"/>
    <bpmn:sequenceFlow id="Flow_C2E_C2EW" name="Đã cập nhật trạng thái" sourceRef="C2E" targetRef="C2EW"/>
    <bpmn:sequenceFlow id="Flow_C2E_C2D" name="Đã ghi trạng thái" sourceRef="C2EW" targetRef="C2D"/>
    <bpmn:sequenceFlow id="Flow_C2D_C3" name="Đã gửi xác nhận" sourceRef="C2D" targetRef="C3"/>
    </bpmn:process>
