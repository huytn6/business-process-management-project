<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PhanLoaiChuyenPhatTrungTam" targetNamespace="http://viettelpost.example/bpmn/phanloai-chuyenphat-trungtam" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_FEE" name="Bưu cục / Điểm tập kết &#38; xe feeder" processRef="Process_FEE" />
    <bpmn:participant id="Participant_HUB" name="Trung tâm khai thác Viettel Post" processRef="Process_HUB" />
    <bpmn:participant id="Participant_CAR" name="Đội vận tải liên tỉnh" processRef="Process_CAR" />
    <bpmn:messageFlow id="MsgFlow_F2B_IN1" name="Manifest bàn giao" sourceRef="F2B" targetRef="IN1" />
    <bpmn:messageFlow id="MsgFlow_OT6_C1" name="Thông báo bàn giao" sourceRef="OT6" targetRef="C1" />
    <bpmn:messageFlow id="MsgFlow_C2D_OW1" name="Xác nhận ký nhận" sourceRef="C2D" targetRef="OW1" />
  </bpmn:collaboration>
  <bpmn:error id="Error_StageTimeout" name="Quá hạn chờ xuất tuyến" errorCode="ERR_STAGE_TIMEOUT" />
  <bpmn:error id="Error_ReconMismatch" name="Sai lệch đối soát không khớp" errorCode="ERR_RECON_MISMATCH" />
  <bpmn:dataStore id="DataStore_WMS_TMS" name="Hệ thống WMS/TMS" />
  <bpmn:process id="Process_FEE" isExecutable="false">
    <bpmn:startEvent id="F1" name="Xe feeder đã đến hub">
      <bpmn:outgoing>Flow_F1_F2A</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="F2A" name="Bàn giao bưu gửi">
      <bpmn:incoming>Flow_F1_F2A</bpmn:incoming>
      <bpmn:outgoing>Flow_F2A_F2B</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="F2B" name="Gửi manifest bàn giao">
      <bpmn:incoming>Flow_F2A_F2B</bpmn:incoming>
      <bpmn:outgoing>Flow_F2B_F3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="F3" name="Bưu gửi đã được bàn giao">
      <bpmn:incoming>Flow_F2B_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_F1_F2A" sourceRef="F1" targetRef="F2A" />
    <bpmn:sequenceFlow id="Flow_F2A_F2B" sourceRef="F2A" targetRef="F2B" />
    <bpmn:sequenceFlow id="Flow_F2B_F3" sourceRef="F2B" targetRef="F3" />
  </bpmn:process>
  <bpmn:process id="Process_HUB" isExecutable="false">
    <bpmn:laneSet id="LaneSet_HUB">
      <bpmn:lane id="Lane_EXC" name="Khai thác ngoại lệ / An ninh">
        <bpmn:flowNodeRef>EX1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EX2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EX4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OUT" name="Outbound &#38; Điều vận">
        <bpmn:flowNodeRef>OJ1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OT6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OW1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EBG1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TM2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EX3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB_STAGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OT2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB_RECON</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_RECON_ERR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_STAGE_ERR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DWS" name="DWS &#38; Hệ thống chia chọn">
        <bpmn:flowNodeRef>DT0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GWR_SORT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DT4_OPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DT3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DT2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GWJ2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DT4CAUSE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DT4_TECH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JOIN_DT4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DT1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IN" name="Inbound &#38; Kiểm soát bàn giao">
        <bpmn:flowNodeRef>IN1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GWR1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GWJ1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataStoreReference id="DS1" name="Hệ thống WMS/TMS" dataStoreRef="DataStore_WMS_TMS" />
    <bpmn:startEvent id="IN1" name="Manifest đã được bàn giao">
      <bpmn:outgoing>Flow_IN1_IN2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_IN1" />
    </bpmn:startEvent>
    <bpmn:userTask id="IN2" name="Kiểm tra bàn giao &#38; niêm phong">
      <bpmn:incoming>Flow_IN1_IN2</bpmn:incoming>
      <bpmn:outgoing>Flow_IN2_GW1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW1" name="Bàn giao khớp?" default="Flow_GW1_GWJ1">
      <bpmn:incoming>Flow_IN2_GW1</bpmn:incoming>
      <bpmn:outgoing>Flow_GW1_GWJ1</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW1_EX1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IN5" name="Ghi trạng thái đến hub vào WMS">
      <bpmn:incoming>Flow_GW2_IN5</bpmn:incoming>
      <bpmn:outgoing>Flow_IN5_DT0</bpmn:outgoing>
      <bpmn:property id="Property_IN5_StatusArrived" name="Trạng thái đến hub" />
      <bpmn:dataOutputAssociation id="DataOut_IN5_DS1">
        <bpmn:documentation>Ghi "Trạng thái đến hub" vào WMS/TMS.</bpmn:documentation>
        <bpmn:sourceRef>Property_IN5_StatusArrived</bpmn:sourceRef>
        <bpmn:targetRef>DS1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="DT0" name="Đọc dữ liệu khai báo từ WMS">
      <bpmn:incoming>Flow_IN5_DT0</bpmn:incoming>
      <bpmn:outgoing>Flow_DT0_DT1</bpmn:outgoing>
      <bpmn:property id="Property_DT0_DeclarationData" name="Dữ liệu khai báo" />
      <bpmn:property id="Property_08245uu" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_DS1_DT0">
        <bpmn:documentation>Đọc "Dữ liệu khai báo" (đã tồn tại từ trước, ngoài phạm vi quy trình này) từ WMS/TMS.</bpmn:documentation>
        <bpmn:sourceRef>DS1</bpmn:sourceRef>
        <bpmn:targetRef>Property_08245uu</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="EX1" name="Cách ly &#38; lập biên bản sai lệch">
      <bpmn:incoming>Flow_GW1_EX1</bpmn:incoming>
      <bpmn:outgoing>Flow_EX1_EE1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GWR1" name="Đã vượt quá số lần thử đọc mã?" default="Flow_GWR1_GWJ1">
      <bpmn:incoming>Flow_IN4_GWR1</bpmn:incoming>
      <bpmn:outgoing>Flow_GWR1_GWJ1</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWR1_EX4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="EX2" name="Cách ly &#38; lập biên bản hàng cấm/nguy hiểm">
      <bpmn:incoming>Flow_GW3_EX2</bpmn:incoming>
      <bpmn:outgoing>Flow_EX2_EE2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:dataStoreReference id="DS2" name="Hệ thống WMS/TMS" dataStoreRef="DataStore_WMS_TMS" />
    <bpmn:exclusiveGateway id="GWR_SORT" name="Đã vượt quá số lần thử chia chọn?">
      <bpmn:incoming>Flow_JOINDT4_GWRSORT</bpmn:incoming>
      <bpmn:outgoing>Flow_GWRSORT_GWJ2</bpmn:outgoing>
      <bpmn:outgoing>Flow_GWRSORT_DT3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DT4_OPS" name="Nhận dạng lại mã vạch &#38; điều hướng lại tuyến chia chọn">
      <bpmn:incoming>Flow_DT4CAUSE_OPS</bpmn:incoming>
      <bpmn:outgoing>Flow_DT4OPS_JOIN</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="IN4" name="Nhận dạng &#38; dán lại nhãn">
      <bpmn:incoming>Flow_GW2_IN4</bpmn:incoming>
      <bpmn:outgoing>Flow_IN4_GWR1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE1" name="Lô hàng đã bị cách ly do sai lệch">
      <bpmn:incoming>Flow_EX1_EE1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="EX4" name="Chuyển xử lý ngoại lệ đọc mã lặp lại">
      <bpmn:incoming>Flow_GWR1_EX4</bpmn:incoming>
      <bpmn:outgoing>Flow_EX4_EE4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE4" name="Bưu gửi đã được chuyển xử lý ngoại lệ do lỗi đọc mã lặp lại">
      <bpmn:incoming>Flow_EX4_EE4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE2" name="Hàng cấm/nguy hiểm đã được cách ly">
      <bpmn:incoming>Flow_EX2_EE2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="DT1" name="Kiểm tra bưu gửi bằng DWS">
      <bpmn:incoming>Flow_DT0_DT1</bpmn:incoming>
      <bpmn:outgoing>Flow_DT1_GW3</bpmn:outgoing>
      <bpmn:startEvent id="DT1_S" name="Bưu gửi đã đến DWS">
        <bpmn:outgoing>Flow_DT1S_DT1a</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="DT1a" name="Quét mã tại DWS">
        <bpmn:incoming>Flow_DT1S_DT1a</bpmn:incoming>
        <bpmn:outgoing>Flow_DT1a_DT1b</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="DT1b" name="Cân đo kích thước">
        <bpmn:incoming>Flow_DT1a_DT1b</bpmn:incoming>
        <bpmn:outgoing>Flow_DT1b_DT1c</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="DT1c" name="Đối chiếu khai báo">
        <bpmn:incoming>Flow_DT1b_DT1c</bpmn:incoming>
        <bpmn:outgoing>Flow_DT1c_DT1d</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="DT1d" name="Soi chiếu &#38; kiểm tra bao bì">
        <bpmn:incoming>Flow_DT1c_DT1d</bpmn:incoming>
        <bpmn:outgoing>Flow_DT1d_DT1E</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="DT1_E" name="Bưu gửi đã được kiểm tra DWS">
        <bpmn:incoming>Flow_DT1d_DT1E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_DT1S_DT1a" sourceRef="DT1_S" targetRef="DT1a" />
      <bpmn:sequenceFlow id="Flow_DT1a_DT1b" sourceRef="DT1a" targetRef="DT1b" />
      <bpmn:sequenceFlow id="Flow_DT1b_DT1c" sourceRef="DT1b" targetRef="DT1c" />
      <bpmn:sequenceFlow id="Flow_DT1c_DT1d" sourceRef="DT1c" targetRef="DT1d" />
      <bpmn:sequenceFlow id="Flow_DT1d_DT1E" sourceRef="DT1d" targetRef="DT1_E" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="GW3" name="Hàng cấm / nguy hiểm?" default="Flow_GW3_GW4">
      <bpmn:incoming>Flow_DT1_GW3</bpmn:incoming>
      <bpmn:outgoing>Flow_GW3_GW4</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW3_EX2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW4" name="Hàng đặc biệt được phép?" default="Flow_GW4_GWJ2">
      <bpmn:incoming>Flow_GW3_GW4</bpmn:incoming>
      <bpmn:outgoing>Flow_GW4_GWJ2</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW4_DT3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DT3" name="Phân loại và xác nhận đúng tuyến thủ công (hàng đặc biệt)">
      <bpmn:incoming>Flow_GW4_DT3</bpmn:incoming>
      <bpmn:incoming>Flow_GWRSORT_DT3</bpmn:incoming>
      <bpmn:outgoing>Flow_DT3_OJ1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="IN3" name="Quét mã vận đơn">
      <bpmn:incoming>Flow_GWJ1_IN3</bpmn:incoming>
      <bpmn:outgoing>Flow_IN3_GW2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW2" name="Mã đọc được?" default="Flow_GW2_IN5">
      <bpmn:incoming>Flow_IN3_GW2</bpmn:incoming>
      <bpmn:outgoing>Flow_GW2_IN5</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW2_IN4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GWJ1" name="Hợp nhất luồng đọc mã">
      <bpmn:incoming>Flow_GW1_GWJ1</bpmn:incoming>
      <bpmn:incoming>Flow_GWR1_GWJ1</bpmn:incoming>
      <bpmn:outgoing>Flow_GWJ1_IN3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="DT2" name="Chia chọn tự động theo tuyến (AGV/Sorter)">
      <bpmn:incoming>Flow_GWJ2_DT2</bpmn:incoming>
      <bpmn:outgoing>Flow_DT2_GW5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW5" name="Kết quả chia chọn hợp lệ?" default="Flow_GW5_OJ1">
      <bpmn:incoming>Flow_DT2_GW5</bpmn:incoming>
      <bpmn:outgoing>Flow_GW5_OJ1</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW5_DT4CAUSE</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GWJ2" name="Hợp nhất luồng chia chọn">
      <bpmn:incoming>Flow_GW4_GWJ2</bpmn:incoming>
      <bpmn:incoming>Flow_GWRSORT_GWJ2</bpmn:incoming>
      <bpmn:outgoing>Flow_GWJ2_DT2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="OJ1" name="Hợp nhất luồng phân loại">
      <bpmn:incoming>Flow_DT3_OJ1</bpmn:incoming>
      <bpmn:incoming>Flow_GW5_OJ1</bpmn:incoming>
      <bpmn:outgoing>Flow_OJ1_OT1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SUB_STAGE" name="Tập kết theo tuyến">
      <bpmn:incoming>Flow_OJ1_OT1</bpmn:incoming>
      <bpmn:outgoing>Flow_SUBSTAGE_OT2</bpmn:outgoing>
      <bpmn:property id="Property_0oizubh" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_DS2_SUBSTAGE">
        <bpmn:documentation>Đọc "Kế hoạch chuyến kế tiếp" từ WMS/TMS (chi tiết ở bước Đọc kế hoạch chuyến kế tiếp từ TMS bên trong sub-process).</bpmn:documentation>
        <bpmn:sourceRef>DS2</bpmn:sourceRef>
        <bpmn:targetRef>Property_0oizubh</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:startEvent id="STAGE_S" name="Lô hàng đã sẵn sàng tập kết">
        <bpmn:outgoing>Flow_STAGES_OT1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="OT1" name="Tập kết &#38; đối chiếu kế hoạch xuất tuyến">
        <bpmn:incoming>Flow_STAGES_OT1</bpmn:incoming>
        <bpmn:outgoing>Flow_OT1_GWJ3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_OT1_GWJ3" sourceRef="OT1" targetRef="STAGE_JOIN" />
      <bpmn:exclusiveGateway id="STAGE_JOIN" name="Hợp nhất luồng xuất tuyến">
        <bpmn:incoming>Flow_OT1_GWJ3</bpmn:incoming>
        <bpmn:incoming>Flow_GWR2_STAGEJOIN</bpmn:incoming>
        <bpmn:outgoing>Flow_GWJ3_OTPLAN</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="OT_READPLAN" name="Đọc kế hoạch chuyến kế tiếp từ TMS">
        <bpmn:incoming>Flow_GWJ3_OTPLAN</bpmn:incoming>
        <bpmn:outgoing>Flow_OTPLAN_GW6</bpmn:outgoing>
        <bpmn:property id="Property_OTPLAN_TripPlanInput" name="Kế hoạch chuyến kế tiếp" />
        <bpmn:dataInputAssociation id="DataIn_DS2_OTPLAN">
          <bpmn:documentation>Đọc property "Kế hoạch chuyến kế tiếp" (kế hoạch line-haul do bộ phận điều vận/TMS lập từ trước, ngoài phạm vi quy trình này – tương tự cách DT0 đọc "Dữ liệu khai báo") từ WMS/TMS – KHÔNG đọc property "Manifest lô hàng" (do OT5A ghi) cũng đang lưu trên cùng Data Store.</bpmn:documentation>
          <bpmn:sourceRef>DS2</bpmn:sourceRef>
          <bpmn:targetRef>Property_OTPLAN_TripPlanInput</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_OTPLAN_GW6" sourceRef="OT_READPLAN" targetRef="GW6" />
      <bpmn:exclusiveGateway id="GW6" name="Đủ điều kiện xuất tuyến?" default="Flow_GW6_OT2">
        <bpmn:incoming>Flow_OTPLAN_GW6</bpmn:incoming>
        <bpmn:outgoing>Flow_GW6_OT2</bpmn:outgoing>
        <bpmn:outgoing>Flow_GW6_TM1</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="TM1" name="Thời gian chờ đã kết thúc (~20 phút)">
        <bpmn:incoming>Flow_GW6_TM1</bpmn:incoming>
        <bpmn:outgoing>Flow_TM1_GWR2</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerDef_TM1">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="STAGE_E" name="Lô hàng đủ điều kiện xuất tuyến">
        <bpmn:incoming>Flow_GW6_OT2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_STAGES_OT1" sourceRef="STAGE_S" targetRef="OT1" />
      <bpmn:sequenceFlow id="Flow_GWJ3_OTPLAN" sourceRef="STAGE_JOIN" targetRef="OT_READPLAN" />
      <bpmn:sequenceFlow id="Flow_GW6_OT2" name="Đủ (80%*)" sourceRef="GW6" targetRef="STAGE_E" />
      <bpmn:sequenceFlow id="Flow_GW6_TM1" name="Chưa đủ (20%*)" sourceRef="GW6" targetRef="TM1">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${duDieuKienXuatTuyen == false}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:exclusiveGateway id="GWR2" name="Đã vượt quá số lần chờ xuất tuyến?" default="Flow_GWR2_STAGEJOIN">
        <bpmn:incoming>Flow_TM1_GWR2</bpmn:incoming>
        <bpmn:outgoing>Flow_GWR2_STAGEJOIN</bpmn:outgoing>
        <bpmn:outgoing>Flow_GWR2_STAGEEXC</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="STAGE_EXC" name="Báo cáo chậm xuất tuyến cho điều vận">
        <bpmn:incoming>Flow_GWR2_STAGEEXC</bpmn:incoming>
        <bpmn:outgoing>Flow_STAGEEXC_STAGEE2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="STAGE_E2" name="Lô hàng chưa xuất tuyến được, đã báo cáo ngoại lệ">
        <bpmn:incoming>Flow_STAGEEXC_STAGEE2</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorDef_STAGE" errorRef="Error_StageTimeout" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_TM1_GWR2" sourceRef="TM1" targetRef="GWR2" />
      <bpmn:sequenceFlow id="Flow_GWR2_STAGEJOIN" name="Chưa đủ 3 lần (85%*)" sourceRef="GWR2" targetRef="STAGE_JOIN" />
      <bpmn:sequenceFlow id="Flow_GWR2_STAGEEXC" name="Đã đủ 3 lần (15%*)" sourceRef="GWR2" targetRef="STAGE_EXC">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${soLanChoXuatTuyen &gt;= 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_STAGEEXC_STAGEE2" sourceRef="STAGE_EXC" targetRef="STAGE_E2" />
    </bpmn:subProcess>
    <bpmn:subProcess id="OT2" name="Đóng bao/container">
      <bpmn:incoming>Flow_SUBSTAGE_OT2</bpmn:incoming>
      <bpmn:outgoing>Flow_OT2_OJ2</bpmn:outgoing>
      <bpmn:startEvent id="OT2_S" name="Lô hàng đã đủ điều kiện đóng bao">
        <bpmn:outgoing>Flow_OT2S_OT2a</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="OT2a" name="Tạo mã bao/container">
        <bpmn:incoming>Flow_OT2S_OT2a</bpmn:incoming>
        <bpmn:outgoing>Flow_OT2a_OT2b</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="OT2b" name="Quét liên kết kiện vào bao/container">
        <bpmn:incoming>Flow_OT2a_OT2b</bpmn:incoming>
        <bpmn:outgoing>Flow_OT2b_OT2c</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="OT2c" name="Kiểm tra số lượng &#38; khối lượng">
        <bpmn:incoming>Flow_OT2b_OT2c</bpmn:incoming>
        <bpmn:outgoing>Flow_OT2c_OT2d</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="OT2d" name="Ghi số seal">
        <bpmn:incoming>Flow_OT2c_OT2d</bpmn:incoming>
        <bpmn:outgoing>Flow_OT2d_OT2e</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:manualTask id="OT2e" name="Niêm phong bao/container">
        <bpmn:incoming>Flow_OT2d_OT2e</bpmn:incoming>
        <bpmn:outgoing>Flow_OT2e_OT2E</bpmn:outgoing>
      </bpmn:manualTask>
      <bpmn:endEvent id="OT2_E" name="Bao/container đã được niêm phong">
        <bpmn:incoming>Flow_OT2e_OT2E</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_OT2S_OT2a" sourceRef="OT2_S" targetRef="OT2a" />
      <bpmn:sequenceFlow id="Flow_OT2a_OT2b" sourceRef="OT2a" targetRef="OT2b" />
      <bpmn:sequenceFlow id="Flow_OT2b_OT2c" sourceRef="OT2b" targetRef="OT2c" />
      <bpmn:sequenceFlow id="Flow_OT2c_OT2d" sourceRef="OT2c" targetRef="OT2d" />
      <bpmn:sequenceFlow id="Flow_OT2d_OT2e" sourceRef="OT2d" targetRef="OT2e" />
      <bpmn:sequenceFlow id="Flow_OT2e_OT2E" sourceRef="OT2e" targetRef="OT2_E" />
    </bpmn:subProcess>
    <bpmn:subProcess id="SUB_RECON" name="Đối soát &#38; đóng manifest">
      <bpmn:incoming>Flow_OT2_OJ2</bpmn:incoming>
      <bpmn:outgoing>Flow_SUBRECON_OT6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_SUBRECON_DS2">
        <bpmn:documentation>Ghi "Manifest lô hàng" vào WMS/TMS (chi tiết ở bước Ghi manifest vào WMS/TMS bên trong sub-process).</bpmn:documentation>
        <bpmn:targetRef>DS2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="RECON_S" name="Bao/container đã đóng xong">
        <bpmn:outgoing>Flow_RECONS_JOIN</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="RECON_JOIN" name="Hợp nhất luồng đối soát">
        <bpmn:incoming>Flow_RECONS_JOIN</bpmn:incoming>
        <bpmn:incoming>Flow_GWR3_RECONJOIN</bpmn:incoming>
        <bpmn:outgoing>Flow_OJ2_OT3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="OT3" name="Đối soát số liệu bao/container">
        <bpmn:incoming>Flow_OJ2_OT3</bpmn:incoming>
        <bpmn:outgoing>Flow_OT3_GW7</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="GW7" name="Đối soát khớp?" default="Flow_GW7_OT5">
        <bpmn:incoming>Flow_OT3_GW7</bpmn:incoming>
        <bpmn:outgoing>Flow_GW7_OT5</bpmn:outgoing>
        <bpmn:outgoing>Flow_GW7_OT4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="OT4" name="Mở kiểm tra &#38; đối soát lại">
        <bpmn:incoming>Flow_GW7_OT4</bpmn:incoming>
        <bpmn:outgoing>Flow_OT4_GWR3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="OT5" name="Đóng manifest lô hàng">
        <bpmn:incoming>Flow_GW7_OT5</bpmn:incoming>
        <bpmn:outgoing>Flow_OT5_OT5A</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="OT5A" name="Ghi manifest vào WMS/TMS">
        <bpmn:incoming>Flow_OT5_OT5A</bpmn:incoming>
        <bpmn:outgoing>Flow_OT5A_OT6</bpmn:outgoing>
        <bpmn:property id="Property_OT5A_ManifestOutput" name="Manifest lô hàng" />
        <bpmn:dataOutputAssociation id="DataOut_OT5A_DS2">
          <bpmn:documentation>Ghi property "Manifest lô hàng" vào WMS/TMS; đội vận tải đọc lại qua DS3 tại bước C2G.</bpmn:documentation>
          <bpmn:sourceRef>Property_OT5A_ManifestOutput</bpmn:sourceRef>
          <bpmn:targetRef>DS2</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_OT3_GW7" sourceRef="OT3" targetRef="GW7" />
      <bpmn:sequenceFlow id="Flow_OT5_OT5A" sourceRef="OT5" targetRef="OT5A" />
      <bpmn:endEvent id="RECON_E" name="Manifest đã được đóng">
        <bpmn:incoming>Flow_OT5A_OT6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_RECONS_JOIN" sourceRef="RECON_S" targetRef="RECON_JOIN" />
      <bpmn:sequenceFlow id="Flow_OJ2_OT3" sourceRef="RECON_JOIN" targetRef="OT3" />
      <bpmn:sequenceFlow id="Flow_GW7_OT5" name="Khớp (97%)" sourceRef="GW7" targetRef="OT5" />
      <bpmn:sequenceFlow id="Flow_GW7_OT4" name="Chưa khớp (3%)" sourceRef="GW7" targetRef="OT4">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${doiSoatKhop == false}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_OT5A_OT6" sourceRef="OT5A" targetRef="RECON_E" />
      <bpmn:exclusiveGateway id="GWR3" name="Đã vượt quá số lần đối soát lại?" default="Flow_GWR3_RECONJOIN">
        <bpmn:incoming>Flow_OT4_GWR3</bpmn:incoming>
        <bpmn:outgoing>Flow_GWR3_RECONJOIN</bpmn:outgoing>
        <bpmn:outgoing>Flow_GWR3_RECONEXC</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="RECON_EXC" name="Báo cáo chênh lệch đối soát cho quản lý ca">
        <bpmn:incoming>Flow_GWR3_RECONEXC</bpmn:incoming>
        <bpmn:outgoing>Flow_RECONEXC_RECONE2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="RECON_E2" name="Đối soát chưa khớp sau nhiều lần kiểm tra, đã báo cáo ngoại lệ">
        <bpmn:incoming>Flow_RECONEXC_RECONE2</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorDef_RECON" errorRef="Error_ReconMismatch" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_OT4_GWR3" sourceRef="OT4" targetRef="GWR3" />
      <bpmn:sequenceFlow id="Flow_GWR3_RECONJOIN" name="Chưa đủ 3 lần (85%*)" sourceRef="GWR3" targetRef="RECON_JOIN" />
      <bpmn:sequenceFlow id="Flow_GWR3_RECONEXC" name="Đã đủ 3 lần (15%*)" sourceRef="GWR3" targetRef="RECON_EXC">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${soLanDoiSoat &gt;= 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_RECONEXC_RECONE2" sourceRef="RECON_EXC" targetRef="RECON_E2" />
    </bpmn:subProcess>
    <bpmn:sendTask id="OT6" name="Thông báo sẵn sàng bàn giao lô hàng">
      <bpmn:incoming>Flow_SUBRECON_OT6</bpmn:incoming>
      <bpmn:outgoing>Flow_OT6_EBG1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="OW1" name="Xác nhận bàn giao đã được tiếp nhận">
      <bpmn:incoming>Flow_EBG1_OW1</bpmn:incoming>
      <bpmn:outgoing>Flow_OW1_OE1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_OW1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="OE1" name="Bưu gửi đã được bàn giao thành công">
      <bpmn:incoming>Flow_OW1_OE1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="EBG1" name="Chờ phản hồi bàn giao">
      <bpmn:incoming>Flow_OT6_EBG1</bpmn:incoming>
      <bpmn:outgoing>Flow_EBG1_OW1</bpmn:outgoing>
      <bpmn:outgoing>Flow_EBG1_TM2</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="TM2" name="Thời gian chờ xác nhận đã kết thúc (~30 phút)">
      <bpmn:incoming>Flow_EBG1_TM2</bpmn:incoming>
      <bpmn:outgoing>Flow_TM2_EX3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_TM2">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="EX3" name="Liên hệ xác minh tình trạng bàn giao">
      <bpmn:incoming>Flow_TM2_EX3</bpmn:incoming>
      <bpmn:outgoing>Flow_EX3_EE3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE3" name="Ngoại lệ xác nhận bàn giao đã được ghi nhận">
      <bpmn:incoming>Flow_EX3_EE3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_DT4CAUSE" name="Nguyên nhân do vận hành hay thiết bị?" default="Flow_DT4CAUSE_OPS">
      <bpmn:incoming>Flow_GW5_DT4CAUSE</bpmn:incoming>
      <bpmn:outgoing>Flow_DT4CAUSE_OPS</bpmn:outgoing>
      <bpmn:outgoing>Flow_DT4CAUSE_TECH</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DT4_TECH" name="Khắc phục lỗi thiết bị chia chọn">
      <bpmn:incoming>Flow_DT4CAUSE_TECH</bpmn:incoming>
      <bpmn:outgoing>Flow_DT4TECH_JOIN</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="JOIN_DT4" name="Hợp nhất xử lý ngoại lệ chia chọn">
      <bpmn:incoming>Flow_DT4OPS_JOIN</bpmn:incoming>
      <bpmn:incoming>Flow_DT4TECH_JOIN</bpmn:incoming>
      <bpmn:outgoing>Flow_JOINDT4_GWRSORT</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EE5" name="Lô hàng đã hủy xuất tuyến do quá hạn chờ">
      <bpmn:incoming>Flow_BESTAGE_EE5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EE6" name="Lô hàng đã tạm dừng đóng manifest do sai lệch đối soát">
      <bpmn:incoming>Flow_BERECON_EE6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BE_RECON_ERR" name="Sai lệch đối soát không khớp" attachedToRef="SUB_RECON">
      <bpmn:outgoing>Flow_BERECON_EE6</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_BE_RECON" errorRef="Error_ReconMismatch" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BE_STAGE_ERR" name="Quá hạn chờ xuất tuyến" attachedToRef="SUB_STAGE">
      <bpmn:outgoing>Flow_BESTAGE_EE5</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_BE_STAGE" errorRef="Error_StageTimeout" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_IN1_IN2" sourceRef="IN1" targetRef="IN2" />
    <bpmn:sequenceFlow id="Flow_IN2_GW1" sourceRef="IN2" targetRef="GW1" />
    <bpmn:sequenceFlow id="Flow_GW1_GWJ1" name="Khớp (99%)" sourceRef="GW1" targetRef="GWJ1" />
    <bpmn:sequenceFlow id="Flow_GW1_EX1" name="Sai lệch (1%)" sourceRef="GW1" targetRef="EX1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${banGiaoKhop == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GW2_IN5" name="Đọc được (98%)" sourceRef="GW2" targetRef="IN5" />
    <bpmn:sequenceFlow id="Flow_IN5_DT0" sourceRef="IN5" targetRef="DT0" />
    <bpmn:sequenceFlow id="Flow_DT0_DT1" sourceRef="DT0" targetRef="DT1" />
    <bpmn:sequenceFlow id="Flow_EX1_EE1" sourceRef="EX1" targetRef="EE1" />
    <bpmn:sequenceFlow id="Flow_IN4_GWR1" sourceRef="IN4" targetRef="GWR1" />
    <bpmn:sequenceFlow id="Flow_GWR1_GWJ1" name="Chưa đủ 3 lần (90%*)" sourceRef="GWR1" targetRef="GWJ1" />
    <bpmn:sequenceFlow id="Flow_GWR1_EX4" name="Đã đủ 3 lần (10%*)" sourceRef="GWR1" targetRef="EX4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${soLanDocMa &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_GW3_EX2" name="Có (1%)" sourceRef="GW3" targetRef="EX2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hangCamNguyHiem == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EX2_EE2" sourceRef="EX2" targetRef="EE2" />
    <bpmn:sequenceFlow id="Flow_JOINDT4_GWRSORT" sourceRef="JOIN_DT4" targetRef="GWR_SORT" />
    <bpmn:sequenceFlow id="Flow_GWRSORT_GWJ2" name="Chưa đủ 3 lần (90%*)" sourceRef="GWR_SORT" targetRef="GWJ2" />
    <bpmn:sequenceFlow id="Flow_GWRSORT_DT3" name="Đã đủ 3 lần (10%*)" sourceRef="GWR_SORT" targetRef="DT3" />
    <bpmn:sequenceFlow id="Flow_DT4CAUSE_OPS" name="Do vận hành (70%*)" sourceRef="GW_DT4CAUSE" targetRef="DT4_OPS" />
    <bpmn:sequenceFlow id="Flow_DT4OPS_JOIN" sourceRef="DT4_OPS" targetRef="JOIN_DT4" />
    <bpmn:sequenceFlow id="Flow_GW2_IN4" name="Lỗi đọc (2%)" sourceRef="GW2" targetRef="IN4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${maDocDuoc == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EX4_EE4" sourceRef="EX4" targetRef="EE4" />
    <bpmn:sequenceFlow id="Flow_DT1_GW3" sourceRef="DT1" targetRef="GW3" />
    <bpmn:sequenceFlow id="Flow_GW3_GW4" name="Không (99%)" sourceRef="GW3" targetRef="GW4" />
    <bpmn:sequenceFlow id="Flow_GW4_GWJ2" name="Không (95,96%)" sourceRef="GW4" targetRef="GWJ2" />
    <bpmn:sequenceFlow id="Flow_GW4_DT3" name="Có (4,04%)" sourceRef="GW4" targetRef="DT3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hangDacBietDuocPhep == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DT3_OJ1" sourceRef="DT3" targetRef="OJ1" />
    <bpmn:sequenceFlow id="Flow_GWJ1_IN3" sourceRef="GWJ1" targetRef="IN3" />
    <bpmn:sequenceFlow id="Flow_IN3_GW2" sourceRef="IN3" targetRef="GW2" />
    <bpmn:sequenceFlow id="Flow_GWJ2_DT2" sourceRef="GWJ2" targetRef="DT2" />
    <bpmn:sequenceFlow id="Flow_DT2_GW5" sourceRef="DT2" targetRef="GW5" />
    <bpmn:sequenceFlow id="Flow_GW5_OJ1" name="Hợp lệ (97%)" sourceRef="GW5" targetRef="OJ1" />
    <bpmn:sequenceFlow id="Flow_GW5_DT4CAUSE" name="Không hợp lệ (3%)" sourceRef="GW5" targetRef="GW_DT4CAUSE">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ketQuaChiaChonHopLe == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OJ1_OT1" sourceRef="OJ1" targetRef="SUB_STAGE" />
    <bpmn:sequenceFlow id="Flow_SUBSTAGE_OT2" sourceRef="SUB_STAGE" targetRef="OT2" />
    <bpmn:sequenceFlow id="Flow_OT2_OJ2" sourceRef="OT2" targetRef="SUB_RECON" />
    <bpmn:sequenceFlow id="Flow_SUBRECON_OT6" sourceRef="SUB_RECON" targetRef="OT6" />
    <bpmn:sequenceFlow id="Flow_OT6_EBG1" sourceRef="OT6" targetRef="EBG1" />
    <bpmn:sequenceFlow id="Flow_EBG1_OW1" name="Chờ xác nhận" sourceRef="EBG1" targetRef="OW1" />
    <bpmn:sequenceFlow id="Flow_OW1_OE1" sourceRef="OW1" targetRef="OE1" />
    <bpmn:sequenceFlow id="Flow_EBG1_TM2" name="Chờ hết giờ" sourceRef="EBG1" targetRef="TM2" />
    <bpmn:sequenceFlow id="Flow_TM2_EX3" name="Quá hạn xác nhận" sourceRef="TM2" targetRef="EX3" />
    <bpmn:sequenceFlow id="Flow_EX3_EE3" sourceRef="EX3" targetRef="EE3" />
    <bpmn:sequenceFlow id="Flow_DT4CAUSE_TECH" name="Do thiết bị (30%*)" sourceRef="GW_DT4CAUSE" targetRef="DT4_TECH">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nguyenNhanThietBi == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DT4TECH_JOIN" sourceRef="DT4_TECH" targetRef="JOIN_DT4" />
    <bpmn:sequenceFlow id="Flow_BESTAGE_EE5" name="Hủy xuất tuyến" sourceRef="BE_STAGE_ERR" targetRef="EE5" />
    <bpmn:sequenceFlow id="Flow_BERECON_EE6" name="Tạm dừng manifest" sourceRef="BE_RECON_ERR" targetRef="EE6" />
  </bpmn:process>
  <bpmn:process id="Process_CAR" isExecutable="false">
    <bpmn:startEvent id="C1" name="Thông báo bàn giao đã được tiếp nhận">
      <bpmn:outgoing>Flow_C1_C2A</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_C1" />
    </bpmn:startEvent>
    <bpmn:manualTask id="C2A" name="Xếp lô hàng lên phương tiện">
      <bpmn:incoming>Flow_C1_C2A</bpmn:incoming>
      <bpmn:outgoing>Flow_C2A_C2G</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="C2G" name="Đọc manifest bàn giao từ WMS/TMS">
      <bpmn:incoming>Flow_C2A_C2G</bpmn:incoming>
      <bpmn:outgoing>Flow_C2G_C2B</bpmn:outgoing>
