<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Delivery06" targetNamespace="http://example.com/bpmn/delivery-confirmation" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:message id="Message_DeliveryNotice" name="Thông báo sắp giao hàng" />
  <bpmn:message id="Message_CustomerAvailability" name="Phản hồi thời gian nhận hàng" />
  <bpmn:message id="Message_PackageHandover" name="Bàn giao kiện hàng" />
  <bpmn:message id="Message_DeliveryDecision" name="Quyết định nhận hoặc từ chối" />
  <bpmn:message id="Message_COD" name="Thông tin thanh toán COD" />
  <bpmn:message id="Message_POD" name="Xác nhận giao hàng thành công" />
  <bpmn:collaboration id="Collaboration_Delivery">
    <bpmn:participant id="Participant_Company" name="ĐƠN VỊ BÁN HÀNG / GIAO NHẬN" processRef="Process_Delivery" />
    <bpmn:participant id="Participant_Customer" name="KHÁCH HÀNG" processRef="Process_Customer" />
    <bpmn:messageFlow id="MF_Notice" name="Thông báo lịch giao" sourceRef="Task_NotifyCustomer" targetRef="Start_CustomerNotice" />
    <bpmn:messageFlow id="MF_Availability" name="Xác nhận có thể nhận hàng" sourceRef="Task_ConfirmAvailability" targetRef="Catch_CustomerReply" />
    <bpmn:messageFlow id="MF_Handover" name="Bàn giao kiện hàng" sourceRef="Task_DeliverPackage" targetRef="Catch_CustomerPackage" />
    <bpmn:messageFlow id="MF_Accept" name="Chấp nhận nhận hàng" sourceRef="Task_SendAcceptance" targetRef="Catch_DeliveryDecision" />
    <bpmn:messageFlow id="MF_Refuse" name="Từ chối nhận hàng" sourceRef="Task_SendRefusal" targetRef="Catch_DeliveryDecision" />
    <bpmn:messageFlow id="MF_COD" name="Thanh toán COD" sourceRef="Task_PayCOD" targetRef="Task_CollectCOD" />
    <bpmn:messageFlow id="MF_POD" name="OTP / chữ ký / ảnh POD" sourceRef="Task_ConfirmReceiptCustomer" targetRef="Task_ConfirmReceipt" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Delivery" name="Quy trình 6 - Giao hàng tận nơi và xác nhận" isExecutable="false">
    <bpmn:documentation>Mô hình AS-IS giả định cho quy trình giao hàng chặng cuối, từ khi đơn sẵn sàng giao đến khi xác nhận giao thành công hoặc ghi nhận giao thất bại.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Company">
      <bpmn:lane id="Lane_Courier" name="NHÂN VIÊN GIAO HÀNG">
        <bpmn:flowNodeRef>Task_CheckPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_CustomerReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Reachable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordFailedAttempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_DeliveryDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_COD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectCOD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AttemptsLeft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordPaymentFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordRefusal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Retry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dispatch" name="ĐIỀU PHỐI GIAO HÀNG">
        <bpmn:flowNodeRef>Task_CreateShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignCourier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandoverPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DeliveryFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OMS" name="HỆ THỐNG OMS / CSKH">
        <bpmn:flowNodeRef>Start_OrderReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InfoMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InfoComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateDelivered</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_OrderReady" name="Đơn hàng sẵn sàng giao" />
    <bpmn:exclusiveGateway id="Gateway_InfoMerge" name="Hợp nhất luồng kiểm tra" />
    <bpmn:serviceTask id="Task_ValidateOrder" name="[PT2m | WT1m | CT3m] Kiểm tra địa chỉ, liên hệ và phương thức thanh toán" />
    <bpmn:exclusiveGateway id="Gateway_InfoComplete" name="Thông tin đầy đủ?" default="Flow_Info_No" />
    <bpmn:serviceTask id="Task_CreateShipment" name="[PT1m | WT1m | CT2m] Tạo vận đơn và yêu cầu giao hàng" />
    <bpmn:userTask id="Task_AssignCourier" name="[PT3m | WT12m | CT15m] Phân công nhân viên và tuyến giao" />
    <bpmn:userTask id="Task_HandoverPackage" name="[PT5m | WT20m | CT25m] Bàn giao kiện hàng" />
    <bpmn:userTask id="Task_CheckPickup" name="[PT3m | WT2m | CT5m] Kiểm tra kiện và xác nhận đã nhận" />
    <bpmn:sendTask id="Task_NotifyCustomer" name="[PT1m | WT0m | CT1m] Thông báo thời gian giao dự kiến" />
    <bpmn:intermediateCatchEvent id="Catch_CustomerReply" name="[WT cửa sổ 10m] Nhận phản hồi khách hàng">
      <bpmn:messageEventDefinition id="MED_CustomerReply" messageRef="Message_CustomerAvailability" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Reachable" name="Liên hệ được khách hàng?" default="Flow_Reachable_No" />
    <bpmn:userTask id="Task_RecordFailedAttempt" name="[PT3m | WT2m | CT5m] Ghi nhận lần giao không thành công" />
    <bpmn:userTask id="Task_DeliverPackage" name="[PT12m | WT35m | CT47m] Bàn giao hàng để khách kiểm tra" />
    <bpmn:intermediateCatchEvent id="Catch_DeliveryDecision" name="[WT TB 7,1m] Nhận quyết định nhận hàng">
      <bpmn:messageEventDefinition id="MED_DeliveryDecision" messageRef="Message_DeliveryDecision" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Accept" name="Khách chấp nhận nhận hàng?" default="Flow_Accept_No" />
    <bpmn:exclusiveGateway id="Gateway_COD" name="Đơn hàng COD?" default="Flow_COD_No" />
    <bpmn:userTask id="Task_CollectCOD" name="[PT4m | WT1m | CT5m] Thu tiền COD" />
    <bpmn:exclusiveGateway id="Gateway_PaymentSuccess" name="Thanh toán thành công?" default="Flow_Payment_No" />
    <bpmn:userTask id="Task_ConfirmReceipt" name="[PT3m | WT0m | CT3m] Nhận OTP, chữ ký hoặc ảnh POD" />
    <bpmn:serviceTask id="Task_UpdateFailed" name="[PT1m | WT1m | CT2m] Cập nhật giao thất bại và thông báo" />
    <bpmn:endEvent id="End_DeliveryFailed" name="Kết thúc - giao thất bại" />
    <bpmn:endEvent id="End_Delivered" name="Kết thúc - giao thành công">
      <bpmn:terminateEventDefinition id="Terminate_Delivered" />
    </bpmn:endEvent>
    <bpmn:userTask id="Task_RequestCorrection" name="[PT4m | WT30m | CT34m] Liên hệ khách hàng và cập nhật thông tin" />
    <bpmn:exclusiveGateway id="Gateway_AttemptsLeft" name="Còn lượt giao lại?" default="Flow_Attempts_No" />
    <bpmn:userTask id="Task_ReturnPackage" name="[PT30m | WT90m | CT120m] Hoàn hàng về điểm tập kết" />
    <bpmn:userTask id="Task_RecordPaymentFailure" name="[PT3m | WT2m | CT5m] Ghi nhận lỗi thanh toán" />
    <bpmn:userTask id="Task_RecordRefusal" name="[PT4m | WT1m | CT5m] Ghi nhận lý do từ chối và bằng chứng" />
    <bpmn:intermediateCatchEvent id="Timer_Retry" name="[WT 720m] Chờ đến lịch giao lại">
      <bpmn:timerEventDefinition id="TED_Retry">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_UpdateDelivered" name="[PT1m | WT1m | CT2m] Cập nhật đã giao và gửi xác nhận" />
    <bpmn:sequenceFlow id="Flow_Start_Validate" sourceRef="Start_OrderReady" targetRef="Gateway_InfoMerge" />
    <bpmn:sequenceFlow id="Flow_Correction_Loop" name="Kiểm tra lại" sourceRef="Task_RequestCorrection" targetRef="Gateway_InfoMerge" />
    <bpmn:sequenceFlow id="Flow_Merge_Validate" sourceRef="Gateway_InfoMerge" targetRef="Task_ValidateOrder" />
    <bpmn:sequenceFlow id="Flow_Validate_Info" sourceRef="Task_ValidateOrder" targetRef="Gateway_InfoComplete" />
    <bpmn:sequenceFlow id="Flow_Info_Yes" name="Có (92%)" sourceRef="Gateway_InfoComplete" targetRef="Task_CreateShipment" />
    <bpmn:sequenceFlow id="Flow_Info_No" name="Không (8%)" sourceRef="Gateway_InfoComplete" targetRef="Task_RequestCorrection" />
    <bpmn:sequenceFlow id="Flow_Create_Assign" sourceRef="Task_CreateShipment" targetRef="Task_AssignCourier" />
    <bpmn:sequenceFlow id="Flow_Assign_Handover" sourceRef="Task_AssignCourier" targetRef="Task_HandoverPackage" />
    <bpmn:sequenceFlow id="Flow_Handover_Check" sourceRef="Task_HandoverPackage" targetRef="Task_CheckPickup" />
    <bpmn:sequenceFlow id="Flow_Check_Notify" sourceRef="Task_CheckPickup" targetRef="Task_NotifyCustomer" />
    <bpmn:sequenceFlow id="Flow_Retry_Loop" sourceRef="Timer_Retry" targetRef="Task_NotifyCustomer" />
    <bpmn:sequenceFlow id="Flow_Notify_Reply" sourceRef="Task_NotifyCustomer" targetRef="Catch_CustomerReply" />
    <bpmn:sequenceFlow id="Flow_Reply_Reachable" sourceRef="Catch_CustomerReply" targetRef="Gateway_Reachable" />
    <bpmn:sequenceFlow id="Flow_Reachable_Yes" name="Có (85%/lần)" sourceRef="Gateway_Reachable" targetRef="Task_DeliverPackage" />
    <bpmn:sequenceFlow id="Flow_Reachable_No" name="Không (15%/lần)" sourceRef="Gateway_Reachable" targetRef="Task_RecordFailedAttempt" />
    <bpmn:sequenceFlow id="Flow_Failed_Attempts" sourceRef="Task_RecordFailedAttempt" targetRef="Gateway_AttemptsLeft" />
    <bpmn:sequenceFlow id="Flow_Deliver_Decision" sourceRef="Task_DeliverPackage" targetRef="Catch_DeliveryDecision" />
    <bpmn:sequenceFlow id="Flow_Decision_Accept" sourceRef="Catch_DeliveryDecision" targetRef="Gateway_Accept" />
    <bpmn:sequenceFlow id="Flow_Accept_No" name="Không (5%)" sourceRef="Gateway_Accept" targetRef="Task_RecordRefusal" />
    <bpmn:sequenceFlow id="Flow_Accept_Yes" name="Có (95%)" sourceRef="Gateway_Accept" targetRef="Gateway_COD" />
    <bpmn:sequenceFlow id="Flow_COD_No" name="Không (40%)" sourceRef="Gateway_COD" targetRef="Task_ConfirmReceipt" />
    <bpmn:sequenceFlow id="Flow_COD_Yes" name="Có (60%)" sourceRef="Gateway_COD" targetRef="Task_CollectCOD" />
    <bpmn:sequenceFlow id="Flow_Collect_Payment" sourceRef="Task_CollectCOD" targetRef="Gateway_PaymentSuccess" />
    <bpmn:sequenceFlow id="Flow_Payment_Yes" name="Có (98%)" sourceRef="Gateway_PaymentSuccess" targetRef="Task_ConfirmReceipt" />
    <bpmn:sequenceFlow id="Flow_Payment_No" name="Không (2%)" sourceRef="Gateway_PaymentSuccess" targetRef="Task_RecordPaymentFailure" />
    <bpmn:sequenceFlow id="Flow_Confirm_Update" sourceRef="Task_ConfirmReceipt" targetRef="Task_UpdateDelivered" />
    <bpmn:sequenceFlow id="Flow_Return_UpdateFailed" sourceRef="Task_ReturnPackage" targetRef="Task_UpdateFailed" />
    <bpmn:sequenceFlow id="Flow_UpdateFailed_End" sourceRef="Task_UpdateFailed" targetRef="End_DeliveryFailed" />
    <bpmn:sequenceFlow id="Flow_Update_End" sourceRef="Task_UpdateDelivered" targetRef="End_Delivered" />
    <bpmn:sequenceFlow id="Flow_Attempts_Yes" name="Có (98,1% số lần qua cổng)" sourceRef="Gateway_AttemptsLeft" targetRef="Timer_Retry" />
    <bpmn:sequenceFlow id="Flow_Attempts_No" name="Không (1,9% số lần qua cổng)" sourceRef="Gateway_AttemptsLeft" targetRef="Task_ReturnPackage" />
    <bpmn:sequenceFlow id="Flow_Refusal_Return" sourceRef="Task_RecordRefusal" targetRef="Task_ReturnPackage" />
    <bpmn:sequenceFlow id="Flow_PaymentFailure_Return" sourceRef="Task_RecordPaymentFailure" targetRef="Task_ReturnPackage" />
  </bpmn:process>
  <bpmn:process id="Process_Customer" name="Tiếp nhận và xác nhận giao hàng" isExecutable="false">
    <bpmn:startEvent id="Start_CustomerNotice" name="Nhận thông báo giao hàng">
      <bpmn:messageEventDefinition id="MED_CustomerNotice" messageRef="Message_DeliveryNotice" />
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_ConfirmAvailability" name="[PT2m | WT8m | CT10m] Xác nhận thời gian và địa điểm nhận" />
    <bpmn:intermediateCatchEvent id="Catch_CustomerPackage" name="Nhận kiện hàng để kiểm tra">
      <bpmn:messageEventDefinition id="MED_CustomerPackage" messageRef="Message_PackageHandover" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_InspectPackage" name="[PT5m | WT1m | CT6m] Kiểm tra bao bì, sản phẩm và thông tin" />
    <bpmn:exclusiveGateway id="Gateway_CustomerAccept" name="Chấp nhận nhận hàng?" default="CFlow_Accept_No" />
    <bpmn:sendTask id="Task_SendRefusal" name="[PT2m | WT0m | CT2m] Thông báo từ chối và lý do" />
    <bpmn:endEvent id="End_CustomerRefusal" name="Kết thúc - từ chối nhận" />
    <bpmn:sendTask id="Task_SendAcceptance" name="[PT1m | WT0m | CT1m] Thông báo chấp nhận nhận hàng" />
    <bpmn:exclusiveGateway id="Gateway_CustomerCOD" name="Cần thanh toán COD?" default="CFlow_COD_No" />
    <bpmn:userTask id="Task_PayCOD" name="[PT3m | WT2m | CT5m] Thanh toán COD" />
    <bpmn:sendTask id="Task_ConfirmReceiptCustomer" name="[PT2m | WT0m | CT2m] Cung cấp OTP, chữ ký hoặc xác nhận điện tử" />
    <bpmn:endEvent id="End_CustomerComplete" name="Hoàn tất nhận hàng" />
    <bpmn:sequenceFlow id="CFlow_Start_Confirm" sourceRef="Start_CustomerNotice" targetRef="Task_ConfirmAvailability" />
    <bpmn:sequenceFlow id="CFlow_Confirm_Package" sourceRef="Task_ConfirmAvailability" targetRef="Catch_CustomerPackage" />
    <bpmn:sequenceFlow id="CFlow_Package_Inspect" sourceRef="Catch_CustomerPackage" targetRef="Task_InspectPackage" />
    <bpmn:sequenceFlow id="CFlow_Inspect_Accept" sourceRef="Task_InspectPackage" targetRef="Gateway_CustomerAccept" />
    <bpmn:sequenceFlow id="CFlow_Accept_No" name="Không (5%)" sourceRef="Gateway_CustomerAccept" targetRef="Task_SendRefusal" />
    <bpmn:sequenceFlow id="CFlow_Accept_Yes" name="Có (95%)" sourceRef="Gateway_CustomerAccept" targetRef="Task_SendAcceptance" />
    <bpmn:sequenceFlow id="CFlow_Refusal_End" sourceRef="Task_SendRefusal" targetRef="End_CustomerRefusal" />
    <bpmn:sequenceFlow id="CFlow_Accept_COD" sourceRef="Task_SendAcceptance" targetRef="Gateway_CustomerCOD" />
    <bpmn:sequenceFlow id="CFlow_COD_Yes" name="Có (60%)" sourceRef="Gateway_CustomerCOD" targetRef="Task_PayCOD" />
    <bpmn:sequenceFlow id="CFlow_COD_No" name="Không (40%)" sourceRef="Gateway_CustomerCOD" targetRef="Task_ConfirmReceiptCustomer" />
    <bpmn:sequenceFlow id="CFlow_Pay_Confirm" sourceRef="Task_PayCOD" targetRef="Task_ConfirmReceiptCustomer" />
    <bpmn:sequenceFlow id="CFlow_Confirm_End" sourceRef="Task_ConfirmReceiptCustomer" targetRef="End_CustomerComplete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Delivery">
    <bpmndi:BPMNPlane id="BPMNPlane_Delivery" bpmnElement="Collaboration_Delivery">
      <bpmndi:BPMNShape id="Participant_Company_di" bpmnElement="Participant_Company" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2860" height="650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Courier_di" bpmnElement="Lane_Courier" isHorizontal="true">
        <dc:Bounds x="190" y="430" width="2830" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Dispatch_di" bpmnElement="Lane_Dispatch" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2830" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OMS_di" bpmnElement="Lane_OMS" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2830" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_OrderReady_di" bpmnElement="Start_OrderReady">
        <dc:Bounds x="220" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="203" y="180" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_InfoMerge_di" bpmnElement="Gateway_InfoMerge" isMarkerVisible="true">
        <dc:Bounds x="275" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="265" y="92" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Task_ValidateOrder_di" bpmnElement="Task_ValidateOrder" bioc:stroke="#000000" bioc:fill="#FFFFFF">
        <dc:Bounds x="355" y="120" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_InfoComplete_di" bpmnElement="Gateway_InfoComplete" isMarkerVisible="true">
        <dc:Bounds x="550" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="530" y="111" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Task_CreateShipment_di" bpmnElement="Task_CreateShipment" bioc:stroke="#000000" bioc:fill="#FFFFFF">
        <dc:Bounds x="640" y="300" width="165" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Task_AssignCourier_di" bpmnElement="Task_AssignCourier" bioc:stroke="#000000" bioc:fill="#FFFFFF">
        <dc:Bounds x="840" y="300" width="165" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Task_HandoverPackage_di" bpmnElement="Task_HandoverPackage" bioc:stroke="#000000" bioc:fill="#FFFFFF">
        <dc:Bounds x="1040" y="300" width="165" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Task_CheckPickup_di" bpmnElement="Task_CheckPickup" bioc:stroke="#000000" bioc:fill="#FFFFFF">
        <dc:Bounds x="1040" y="480" width="165" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Task_NotifyCustomer_di" bpmnElement="Task_NotifyCustomer" bioc:stroke="#000000" bioc:fill="#FFFFFF">
        <dc:Bounds x="1240" y="480" width="165" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Catch_CustomerReply_di" bpmnElement="Catch_CustomerReply" bioc:stroke="#000000" bioc:fill="#FFFFFF">
        <dc:Bounds x="1440" y="502" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1408" y="542" width="104" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Reachable_di" bpmnElement="Gateway_Reachable" isMarkerVisible="true">
        <dc:Bounds x="1530" y="495" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1489" y="550" width="132" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Task_RecordFailedAttempt_di" bpmnElement="Task_RecordFailedAttempt" bioc:stroke="#000000" bioc:fill="#FFFFFF">
        <dc:Bounds x="1540" y="625" width="180" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Task_DeliverPackage_di" bpmnElement="Task_DeliverPackage" bioc:stroke="#000000" bioc:fill="#FFFFFF">
