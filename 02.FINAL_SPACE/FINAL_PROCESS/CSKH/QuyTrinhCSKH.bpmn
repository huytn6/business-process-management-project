    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_CSKH" targetRef="Task_GuiKhieuNai" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_GuiKhieuNai" targetRef="GW_Merge_MaDon" />
